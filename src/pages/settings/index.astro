---
import Layout from "../../layouts/Layout.astro";
import AddressItem from "@components/settings/address/AddressItem";

const { userId } = Astro.locals.auth();

if (!userId) {
  Astro.redirect("/sign-in");
}
---

<Layout
  sizeLogo="md"
  title="Configuración - Hermez"
  class="flex flex-col gap-4"
>
  <section>
    <AddressItem name="Mi Hogar" address="Carrera 8 # 10 - 32" />
  </section>
</Layout>
