---
import Layout from "../../layouts/Layout.astro";
import ProfileForm from "@components/settings/ProfileForm.astro";
import AddressSection from "@components/settings/AddressSection.astro";
import VehicleSection from "@components/settings/VehicleSection.astro";
import SettingsMenu from "@components/settings/SettingsMenu.astro";
import PlusSettings from "@components/settings/PlusSettings.astro";

const { userId } = Astro.locals.auth();

if (!userId) {
  Astro.redirect("/sign-in");
}

const userRole = Astro.locals.userRole as "User" | "Domiciliary" | null;

const tapsUser: readonly string[] = ["profile", "locations", "more"];
const tapsDomiciliary: readonly string[] = ["profile", "vehicles", "more"];
const taps = userRole === "Domiciliary" ? tapsDomiciliary : tapsUser;

const url = Astro.url;
const searchParams = url.searchParams;
let sectionActivite = searchParams.get("section");

if (!sectionActivite || !taps.includes(sectionActivite)) {
  sectionActivite = "profile";
}
---

<Layout sizeLogo="md" title="Configuración - Hermez" class="flex flex-col gap-4 overflow-x-hidden p-4 md:p-6">
  <SettingsMenu sectionActivite={sectionActivite} userRole={userRole} />

  <main id="containerSectionsSetting" class="w-full min-h-fit relative">
    <ProfileForm isActive={sectionActivite === "profile"} />
    {userRole === "Domiciliary" && <VehicleSection isActive={sectionActivite === "vehicles"} />}
    {userRole === "User" && <AddressSection isActive={sectionActivite === "locations"} />}
    <PlusSettings isActive={sectionActivite === "more"} />
  </main>
</Layout>

<style>
  #containerSectionsSetting {
    section {
      display: none;
      width: 100%;
      
      &.active {
        display: flex;
      }
    }
  }
</style>

<script>
  const main = () => {
    const checkboxes = document.querySelectorAll(
      'input[name="settings"]'
    ) as NodeListOf<HTMLInputElement>;

    checkboxes?.forEach((checkbox) => {
      checkbox.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        const checkId = target.id;

        const newSection: HTMLElement | null = document.querySelector(
          `section[id="section-${checkId}"]`
        );
        const oldSection: HTMLElement | null = document.querySelector("section.active");

        oldSection?.classList.remove("active");
        newSection?.classList.add("active");

        const url = new URL(window.location.href);
        url.searchParams.set("section", checkId);
        window.history.pushState({}, "", url);
      });
    });
  };
  document.addEventListener("astro:page-load", main);
  document.addEventListener("DOMContentLoaded", main);
</script>
