---
import Layout from "../../layouts/Layout.astro";
import ProfileForm from "@components/settings/ProfileForm.astro";
import AddressSection from "@components/settings/AddressSection.astro";
import PaymentMethodsSection from "@components/settings/PaymentMethodsSection.astro";
import SettingsMenu from "@components/settings/SettingsMenu.astro";

const { userId } = Astro.locals.auth();

if (!userId) {
  Astro.redirect("/sign-in");
}
---

<Layout sizeLogo="md" title="Configuración - Hermez" class="flex flex-col gap-4">
  <SettingsMenu />
  <main class="flex flex-row overflow-x-scroll scrollbar-hide">
    <ProfileForm />
    <AddressSection />
    <PaymentMethodsSection />
  </main>
</Layout>
