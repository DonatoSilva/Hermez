---
import Layout from "@layouts/Layout.astro";

const title = "Selecciona tu Rol | Domicilio Donatello";
---

<Layout title={title} sizeLogo="sm" class="relative">
    <h1 class="text-2xl font-semibold text-center mt-8">
        ¿Cómo deseas usar tu cuenta?
    </h1>
    <div
        class="flex flex-col md:flex-row justify-center items-center gap-8 mt-10"
    >
        <a
            href="/?org=Domiciliary"
            class="bg-white rounded-lg shadow-md p-6 flex flex-col items-center w-72 min-h-80 transition hover:shadow-lg"
        >
            <img
                src="images/domiciliarioConCajas-min.webp"
                alt="Domiciliario"
                class="w-24 h-24 mb-4"
            />
            <h2 class="text-xl font-bold mb-2">Domiciliario</h2>
            <p class="text-center text-gray-600">
                Genera ingresos y disfruta de flexibilidad trabajando con
                nosotros.
            </p>
        </a>
        <a
            href="/?org=Client"
            class="bg-white rounded-lg shadow-md p-6 flex flex-col items-center w-72 min-h-80 transition hover:shadow-lg"
        >
            <img
                src="images/clienteFelizEnPuerta-min.webp"
                alt="Cliente"
                class="w-24 h-24 mb-4"
            />
            <h2 class="text-xl font-bold mb-2">Cliente</h2>
            <p class="text-center text-gray-600">
                Solicita domicilios rápidos y confiables desde tu dispositivo.
            </p>
        </a>
    </div>
</Layout>
