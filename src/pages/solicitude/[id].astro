---
import FromToPoint from "@components/forms/delivery requests/ui/FromToPoint.astro";
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import { BannerOffer } from "@components/solicitude/BannerOffer";
import Layout from "@layouts/Layout.astro";
import { actions } from "astro:actions";

const { userId } = Astro.locals.auth();
const isClient = Astro.locals.userRole === "User"; /// para darle una personalizacion en caso de que exista el id y este en el rol de domiciliario mostrarle un mensaje de advertencia

if (!userId) {
  Astro.redirect("/sign-in");
}

const token =
  (await Astro.locals.auth().getToken({ template: "jwt-back-hermez" })) ?? "";
const { id } = Astro.params;

if (!id) {
  throw new Error("ID de solicitud no proporcionado");
}

const {data: existsSolicitude, error} = await Astro.callAction(actions.Delivery.getQuoteById, {
  quoteId: id,
});

const { expires_at, client_price, pickup_address, delivery_address } = existsSolicitude || {};
console.log(existsSolicitude);

const protocol = Astro.request.headers.get("protocol") || "http";
const host = Astro.request.headers.get("host") || "localhost:4321";
---

<Layout
  sizeLogo="md"
  title={`Solicitud del domicilio: ${id}`}
  class="flex flex-col gap-12 dark:text-H-blue-100"
>
  {
    existsSolicitude? (
      <span
    class="flex flex-row gap-2 items-center justify-between rounded-md bg-H-blue-900 text-white p-4 max-w-3xl w-full mx-auto"
  >
    <div class="max-w-prose">
      <b>4</b> conductores estan esperando tu solicitud
    </div>

    <div class="flex flex-row items-center">
      {
        [...Array(4)].map(() => (
          <div class="h-8 w-8 rounded-full bg-H-blue-100 flex items-center justify-center -ml-4 border-2 border-H-blue-900" />
        ))
      }
    </div>
  </span>
  <main class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end justify-center dark:text-H-blue-100" id="solicitude-details" data-expirate={expires_at} data-quote-id={id}>
    <div class="flex flex-col items-center justify-center gap-2 min-h-full">
      <h2 class="text-7xl md:text-8xl font-bold text-center text-H-black dark:text-H-blue-100">
        00:00
      </h2>
      <p class="text-center text-H-black dark:text-H-blue-100">Tiempo estimado de espera</p>
    </div>
    <div>
      <div
        class="flex flex-row items-center justify-between gap-2 w-full max-w-3xl mx-auto"
      >
        <span class="rounded-md text-sm bg-H-blue-700 text-white p-2">
          Total ofertas
        </span>
        <b
          class="rounded-md text-sm border border-H-blue-700 text-H-blue-700 dark:text-H-blue-100 px-4 py-2"
        >
          0
        </b>
      </div>
      <BannerOffer quoteId={id} token={token} client:visible protocol={protocol} host={host} />
    </div>
    <div class="min-h-full flex flex-col justify-between">
      <div>
        <p class="text-center text-H-black dark:text-H-blue-100">
          Por su tarifa, su solicitud tiene prioridad
        </p>
        <div class="flex flex-row items-center justify-center gap-4">
          <button
            id="btn-less-money"
            type="button"
            class="rounded-md text-sm bg-H-blue-700 text-white opacity-70 hover:opacity-100 cursor-pointer px-2 py-1"
          >
            -500
          </button>
          <b class="rounded-md text-4xl text-H-black dark:text-H-blue-100 px-4 py-2 font-mono">
            ${client_price.toString().split('.')[0].toLocaleString('es-CO')}
          </b>
          <button
            id="btn-more-money"
            type="button"
            class="rounded-md text-sm bg-H-blue-700 text-white opacity-70 hover:opacity-100 cursor-pointer px-2 py-1"
          >
            +500
          </button>
        </div>
      </div>
      <Button type="button" className="w-full max-w-3xl mx-auto">
        Nueva tarifa
      </Button>
    </div>
    <div
      class="flex flex-col items-start justify-start gap-4 w-full max-w-3xl mx-auto dark:text-H-blue-100"
    >
      <InputField
        id="accept-lowest"
        type="checkbox"
        classLabel="flex flex-row-reverse items-center justify-end "
        textLabel="Aceptar automaticamente la tarifa más baja"
      />

      <FromToPoint pickupAddress={pickup_address} deliveryAddress={delivery_address} />
      <Button
        id="btn-cancel-solicitude"
        type="button"
        variant="bordered"
        className="w-full max-w-3xl mx-auto border-red-300 text-red-300 hover:bg-red-600 hover:text-white duration-300"
      >
        Cancelar solicitud
      </Button>
    </div>
  </main>
    ) : (
      <p class="text-center text-red-600 font-bold text-xl">
        La solicitud con ID {id} no existe.
      </p>
    )
  }
</Layout>

<script>
import { toastStore } from "@stores/StoreToast";
import { actions } from "astro:actions";
import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    const solicitudeDetailsEl = document.querySelector(
      "#solicitude-details"
    ) as HTMLDivElement;
    /// logica para el boton de cancelar solicitud
    const btnCancelSolicitude = document.querySelector(
      "#btn-cancel-solicitude"
    ) as HTMLButtonElement;

    btnCancelSolicitude?.addEventListener("click", async () => {
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");

      if (!quoteId) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "No se pudo cancelar la solicitud. ID no encontrado.",
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      const {data: quoteCancelled, error} = await actions.Delivery.cancelQuote({
        quoteId: quoteId,
      });

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al cancelar la solicitud: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      toastStore.set({
        type: "info",
        visible: true,
        message: "La solicitud ha sido cancelada.",
        autoClose: true,
        autoCloseDelay: 5000,
      });

      navigate("/", { history: 'replace' });
    });
    /// logica para el checkbox de aceptar automaticamente la tarifa mas baja
    const acceptLowestCheckbox = document.querySelector(
      "#accept-lowest"
    ) as HTMLInputElement;

    acceptLowestCheckbox?.addEventListener("change", async (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");

      if (!quoteId) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "No se pudo actualizar la preferencia. ID no encontrado.",
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      if (!isChecked) return; /// por ahora no se permite activar esta funcion

      const error = {
        message: "Esta funcion todavia no esta implementada, pero muy pronto 😎⭐",
      }

      /* const {data: updatedPreference, error} = await actions.Delivery.updateAcceptLowestPreference({
        quoteId: quoteId,
        acceptLowest: isChecked,
      }); */

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al actualizar la preferencia: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        (e.target as HTMLInputElement).checked = !isChecked;
        return;
      }

      toastStore.set({
        type: "success",
        visible: true,
        message: "Preferencia actualizada correctamente.",
        autoClose: true,
        autoCloseDelay: 5000,
      });
    });

    /// Lógica del temporizador de expiración
    const expirateAt = solicitudeDetailsEl?.dataset?.expirate;

    if (expirateAt) {
      const expirateDate = new Date(expirateAt);
      const now = new Date();

      let diff = expirateDate.getTime() - now.getTime();

      const interval = setInterval(() => {
        diff -= 1000;
        
        if (diff <= 0) {
          clearInterval(interval);
          toastStore.set({
            type: "info",
            visible: true,
            message: "El tiempo de espera ha expirado.",
            autoClose: true,
            autoCloseDelay: 5000,
          });
          navigate("/", { history: 'replace' });
          if (solicitudeDetailsEl?.querySelector("h2")) solicitudeDetailsEl!.querySelector("h2")!.textContent = "00:00";
          return;
        }


        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (solicitudeDetailsEl?.querySelector("h2")) {
          solicitudeDetailsEl!.querySelector("h2")!.textContent = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
        }
      }, 1000);
    }
  });
</script>
