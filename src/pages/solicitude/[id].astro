---
import FromToPoint from "@components/forms/delivery requests/ui/FromToPoint.astro";
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import Modal from "@components/modals/Modal";
import { BannerOffer } from "@components/solicitude/BannerOffer";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { actions } from "astro:actions";

const { userId } = Astro.locals.auth();
const isClient = Astro.locals.userRole === "User"; /// para darle una personalizacion en caso de que exista el id y este en el rol de domiciliario mostrarle un mensaje de advertencia

if (!userId) {
  Astro.redirect("/sign-in");
}

const token =
  (await Astro.locals.auth().getToken({ template: "jwt-back-hermez" })) ?? "";
const { id } = Astro.params;

if (!id) {
  throw new Error("ID de solicitud no proporcionado");
}

const {data: existsSolicitude, error} = await Astro.callAction(actions.Delivery.getQuoteById, {
  quoteId: id,
});

const { expires_at, client_price, pickup_address, delivery_address } = existsSolicitude || {};

const protocol = Astro.request.headers.get("protocol") || "http";
const host = Astro.request.headers.get("host") || "localhost:4321";
---

<Layout
  sizeLogo="md"
  title={`Solicitud del domicilio: ${id}`}
  class="flex flex-col gap-12 dark:text-H-blue-100"
>
  {
    existsSolicitude? (
      <span
    class="flex flex-row gap-2 items-center justify-between rounded-md bg-H-blue-900 text-white p-4 max-w-3xl w-full mx-auto"
  >
    <div class="max-w-prose">
      <b>4</b> conductores estan esperando tu solicitud
    </div>

    <div class="flex flex-row items-center">
      {
        [...Array(4)].map(() => (
          <div class="h-8 w-8 rounded-full bg-H-blue-100 flex items-center justify-center -ml-4 border-2 border-H-blue-900" />
        ))
      }
    </div>
  </span>
  <main class="grid grid-cols-1 md:grid-cols-2 gap-8 items-end justify-center dark:text-H-blue-100" id="solicitude-details" data-expirate={expires_at} data-quote-id={id}>
    <div class="flex flex-col items-center justify-center gap-2 min-h-full">
      <h2 class="text-7xl md:text-8xl font-bold text-center text-H-black dark:text-H-blue-100">
        00:00
      </h2>
      <p class="text-center text-H-black dark:text-H-blue-100">Tiempo estimado de espera</p>
      <Button
        id="btn-extend-quote"
        type="button"
        variant="text"
        className="mt-2 text-sm text-H-blue-700 dark:text-H-blue-300 underline hover:text-H-blue-900 dark:hover:text-white transition-colors flex items-center gap-2 justify-center"
      >
        Extender tiempo
      </Button>
    </div>
    <div>
      <div
        class="flex flex-row items-center justify-between gap-2 w-full max-w-3xl mx-auto"
      >
        <span class="rounded-md text-sm bg-H-blue-700 text-white p-2">
          Total ofertas
        </span>
        <b
          id="total-offers"
          class="rounded-md text-sm border border-H-blue-700 text-H-blue-700 dark:text-H-blue-100 px-4 py-2"
        >
          0
        </b>
      </div>
      <BannerOffer quoteId={id} token={token} client:visible protocol={protocol} host={host} />
    </div>
    <div class="min-h-full flex flex-col justify-between">
      <div>
        <p class="text-center text-H-black dark:text-H-blue-100">
          Por su tarifa, su solicitud tiene prioridad
        </p>
        <div class="flex flex-row items-center justify-center gap-4">
          <Button
            id="btn-less-money"
            type="button"
            className="rounded-md text-sm bg-H-blue-700 text-white opacity-70 hover:opacity-100 cursor-pointer px-2 py-1"
          >
            -500
          </Button>
          <b
            id="current-price"
            data-price={client_price}
            class="rounded-md text-4xl text-H-black dark:text-H-blue-100 px-4 py-2 font-mono"
          >
            ${client_price.toString().split('.')[0].toLocaleString('es-CO')}
          </b>
          <Button
            id="btn-more-money"
            type="button"
            className="rounded-md text-sm bg-H-blue-700 text-white opacity-70 hover:opacity-100 cursor-pointer px-2 py-1"
          >
            +500
          </Button>
        </div>
      </div>
      <Button id="btn-new-price" type="button" className="w-full max-w-3xl mx-auto">
        Nueva tarifa
      </Button>
    </div>
    <div
      class="flex flex-col items-start justify-start gap-4 w-full max-w-3xl mx-auto dark:text-H-blue-100"
    >
      <InputField
        id="accept-lowest"
        type="checkbox"
        classLabel="flex flex-row-reverse items-center justify-end "
        textLabel="Aceptar automaticamente la tarifa más baja"
      />

      
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-start gap-2">
        <Icon name="solar:map-point-bold-duotone" size={35} />
        <div>
          <p class="text-sm text-gray-600">De</p>
          <p class="text-base font-bold">
            {pickup_address}
          </p>
        </div>
      </div>
      <div class="flex items-center justify-start gap-2">
        <Icon name="solar:map-point-bold" size={35} />
        <div>
          <p class="text-sm text-gray-600">A</p>
          <p class="text-base font-bold">
            {delivery_address}
          </p>
        </div>
      </div>
    </div>

      <Button
        id="btn-cancel-solicitude"
        type="button"
        variant="bordered"
        className="w-full max-w-3xl mx-auto border-red-300 text-red-300 hover:bg-red-600 hover:text-white duration-300"
      >
        Cancelar solicitud
      </Button>
    </div>
  </main>
    ) : (
      <p class="text-center text-red-600 font-bold text-xl">
        La solicitud con ID {id} no existe.
      </p>
    )
  }

  <Modal keyModal="new-price" title="Nueva tarifa" client:load>
    <div class="flex flex-col gap-4 max-w-3xl mx-auto">
      <InputField
        id="price"
        type="number"
        placeholder="Precio"
        classLabel="flex flex-row-reverse items-center justify-end"
        textLabel="Precio"
      />
      <div class="flex items-center justify-between gap-2">
        <Button id="btn-close-modal-price">Cerrar</Button>
        <Button id="btn-save-modal-price">Guardar</Button>
      </div>
    </div>
  </Modal>
</Layout>

<script>
import { totalOffers } from "@stores/deliveryStepper";
import { statusModal } from "@stores/ModalStore";
import { toastStore } from "@stores/StoreToast";
import { actions } from "astro:actions";
import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    totalOffers.listen((value) => {
      const bTotalOffers: HTMLElement | null = document.querySelector(
        "#total-offers"
      );

      if (bTotalOffers) {
        bTotalOffers.textContent = value.toString();
      }
    });
    
    const solicitudeDetailsEl = document.querySelector(
      "#solicitude-details"
    ) as HTMLDivElement;
    /// logica para el boton de cancelar solicitud
    const btnCancelSolicitude = document.querySelector(
      "#btn-cancel-solicitude"
    ) as HTMLButtonElement;

    btnCancelSolicitude?.addEventListener("click", async () => {
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");

      if (!quoteId) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "No se pudo cancelar la solicitud. ID no encontrado.",
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      const {data: quoteCancelled, error} = await actions.Delivery.cancelQuote({
        quoteId: quoteId,
      });

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al cancelar la solicitud: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      toastStore.set({
        type: "info",
        visible: true,
        message: "La solicitud ha sido cancelada.",
        autoClose: true,
        autoCloseDelay: 5000,
      });

      navigate("/", { history: 'replace' });
    });
    /// logica para el checkbox de aceptar automaticamente la tarifa mas baja
    const acceptLowestCheckbox = document.querySelector(
      "#accept-lowest"
    ) as HTMLInputElement;

    acceptLowestCheckbox?.addEventListener("change", async (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");

      if (!quoteId) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "No se pudo actualizar la preferencia. ID no encontrado.",
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      if (!isChecked) return; /// por ahora no se permite activar esta funcion

      const error = {
        message: "Esta funcion todavia no esta implementada, pero muy pronto 😎⭐",
      }

      /* const {data: updatedPreference, error} = await actions.Delivery.updateAcceptLowestPreference({
        quoteId: quoteId,
        acceptLowest: isChecked,
      }); */

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al actualizar la preferencia: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        (e.target as HTMLInputElement).checked = !isChecked;
        return;
      }

      toastStore.set({
        type: "success",
        visible: true,
        message: "Preferencia actualizada correctamente.",
        autoClose: true,
        autoCloseDelay: 5000,
      });
    });

    /// Lógica del temporizador de expiración
    const expirateAt = solicitudeDetailsEl?.dataset?.expirate;

    let interval: NodeJS.Timeout;
    const btnNewPrice = document.querySelector("#btn-new-price") as HTMLButtonElement;

    btnNewPrice.addEventListener("click", () => {
      statusModal.setKey("new-price", {
        isOpen: true,
      });
    });

    const startTimer = (expirationDate: Date) => {
      clearInterval(interval);
      
      const updateTimer = () => {
        const now = new Date();
        let diff = expirationDate.getTime() - now.getTime();

        if (diff <= 0) {
          clearInterval(interval);
          toastStore.set({
            type: "info",
            visible: true,
            message: "El tiempo de espera ha expirado.",
            autoClose: true,
            autoCloseDelay: 5000,
          });
          navigate("/", { history: 'replace' });
          if (solicitudeDetailsEl?.querySelector("h2")) solicitudeDetailsEl!.querySelector("h2")!.textContent = "00:00";
          return;
        }

        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (solicitudeDetailsEl?.querySelector("h2")) {
          solicitudeDetailsEl!.querySelector("h2")!.textContent = `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
        }
      };

      updateTimer(); // Ejecutar inmediatamente
      interval = setInterval(updateTimer, 1000);
    };

    if (expirateAt) {
      startTimer(new Date(expirateAt));
    }

    /// Lógica para extender el tiempo
    const btnExtendQuote = document.querySelector("#btn-extend-quote") as HTMLButtonElement;
    
    btnExtendQuote?.addEventListener("click", async () => {
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");
      
      if (!quoteId) return;

      // Estado de carga
      btnExtendQuote.disabled = true;
      btnExtendQuote.classList.add("cursor-not-allowed", "opacity-70");
      const originalText = btnExtendQuote.innerHTML;
      btnExtendQuote.innerHTML = `
        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      `;

      const { data, error } = await actions.Delivery.extendQuote({
        quoteId,
        minutes: 5
      });

      // Restaurar estado
      btnExtendQuote.disabled = false;
      btnExtendQuote.classList.remove("cursor-not-allowed", "opacity-70");
      btnExtendQuote.innerHTML = originalText;

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      if (data) {
        toastStore.set({
          type: "success",
          visible: true,
          message: "Tiempo extendido correctamente (+5 min)",
          autoClose: true,
          autoCloseDelay: 3000,
        });
        
        // Actualizar el temporizador con la nueva fecha de expiración
        if (data.expires_at) {
          startTimer(new Date(data.expires_at));
        }
      }
    });
    /// Lógica para ajustar el precio
    const btnLessMoney = document.querySelector("#btn-less-money") as HTMLButtonElement;
    const btnMoreMoney = document.querySelector("#btn-more-money") as HTMLButtonElement;
    const currentPriceEl = document.querySelector("#current-price") as HTMLElement;
    
    let currentPrice = Number(currentPriceEl?.dataset?.price || 0);
    
    const debounce = (func: Function, wait: number) => {
      let timeout: any;
      return (...args: any[]) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, args), wait);
      };
    };

    const updatePriceOnServer = debounce(async (newPrice: number) => {
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");
      if (!quoteId) return;

      const { data, error } = await actions.Delivery.updatePriceQuote({
        quoteId,
        client_price: newPrice,
      });

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al actualizar el precio: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
      } else {
         toastStore.set({
          type: "success",
          visible: true,
          message: "Precio actualizado correctamente",
          autoClose: true,
          autoCloseDelay: 2000,
        });
      }
    }, 250);

    const updatePriceDisplay = () => {
       if (currentPriceEl) {
         currentPriceEl.textContent = `$${currentPrice.toLocaleString('es-CO')}`;
         currentPriceEl.dataset.price = currentPrice.toString();
       }
       updatePriceOnServer(currentPrice);
    };

    btnLessMoney?.addEventListener("click", () => {
      if (currentPrice - 500 >= 4000) {
        currentPrice -= 500;
        updatePriceDisplay();
      }
    });

    btnMoreMoney?.addEventListener("click", () => {
      currentPrice += 500;
      updatePriceDisplay();
    });

    /// Lógica para el modal de nueva tarifa
    const btnCloseModalPrice = document.querySelector("#btn-close-modal-price");
    const btnSaveModalPrice = document.querySelector("#btn-save-modal-price");
    const inputNewPrice = document.querySelector("#price") as HTMLInputElement;

    btnCloseModalPrice?.addEventListener("click", () => {
      statusModal.setKey("new-price", { isOpen: false });
    });

    btnSaveModalPrice?.addEventListener("click", async () => {
      const newPrice = Number(inputNewPrice?.value);
      const quoteId = solicitudeDetailsEl?.getAttribute("data-quote-id");

      if (!quoteId) return;

      if (!newPrice || newPrice < 4000) {
         toastStore.set({
          type: "error",
          visible: true,
          message: "El precio debe ser mayor o igual a $4.000",
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      const { data, error } = await actions.Delivery.updatePriceQuote({
        quoteId,
        client_price: newPrice,
      });

      if (error) {
        toastStore.set({
          type: "error",
          visible: true,
          message: "Error al actualizar el precio: " + error.message,
          autoClose: true,
          autoCloseDelay: 5000,
        });
        return;
      }

      // Success
      currentPrice = newPrice;
      if (currentPriceEl) {
         currentPriceEl.textContent = `$${currentPrice.toLocaleString('es-CO')}`;
         currentPriceEl.dataset.price = currentPrice.toString();
      }
      
      statusModal.setKey("new-price", { isOpen: false });
      toastStore.set({
          type: "success",
          visible: true,
          message: "Precio actualizado correctamente",
          autoClose: true,
          autoCloseDelay: 3000,
      });
      if(inputNewPrice) inputNewPrice.value = "";
    });
  });
</script>
