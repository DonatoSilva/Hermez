---
import "@styles/global.css";
import Head from "@components/header/Head.astro";
import SignInOption from "@components/sign-in/SignInOption.astro";
import NavigationHint from "@components/sign-in/NavigationHint.astro";

export const prerender = false;
---

<html lang="es">
  <Head
    title="Iniciar Sesión | Domicilio Donatello"
    description="Página de inicio de sesión para Domicilio Donatello - Hermez. Accede como domiciliario o cliente."
  />
  <body>
    <main
      class="w-full min-h-dvh flex flex-col md:flex-row items-stretch md:items-start justify-center overflow-hidden relative text-H-blue-100"
    >
      <SignInOption
        type="domiciliary"
        title="Domiciliarios"
        description='"Lleva lo que otros necesitan. Conéctate y comienza."'
        imageSrc="/images/domiciliarioConCajas-min.webp"
        imageAlt="Domiciliario"
        href="/sign-in/domiciliary"
      />
      <SignInOption
        type="client"
        title="Clientes"
        description='"Encarga, pide, recibe. Así de simple."'
        imageSrc="/images/clienteFelizEnPuerta-min.webp"
        imageAlt="Cliente"
        href="/sign-in/client"
      />
      <NavigationHint urlTo="/sign-up" typeForm="signIn" />
    </main>
  </body></html
>

<script>
  document.addEventListener("astro:page-load", () => {
    // Keyboard navigation
    document.addEventListener("keydown", (event) => {
      if (event.key.toLowerCase() === "k") {
        window.location.href = "/sign-in/client";
        return;
      }

      if (event.key.toLowerCase() === "d") {
        window.location.href = "/sign-in/domiciliary";
        return;
      }
    });

    // Touch navigation
    let startY = 0;
    const domiciliaryLink = document.querySelector('a[href="/sign-in/domiciliary"]');
    const clientLink = document.querySelector('a[href="/sign-in/client"]');

    window.addEventListener("touchstart", (event) => {
      startY = event.touches[0].clientY;
    });

    window.addEventListener("touchmove", (event) => {
      let currentY = event.touches[0].clientY;
      let desplazamiento = startY - currentY;

      if (desplazamiento > 30) {
        clientLink?.classList.add("clientTouch");
        domiciliaryLink?.classList.remove("domiciliaryTouch");
      } else if (desplazamiento < -30) {
        domiciliaryLink?.classList.add("domiciliaryTouch");
        clientLink?.classList.remove("clientTouch");
      }
    });

    window.addEventListener("touchend", (event) => {
      let endY = event.changedTouches[0].clientY;
      let desplazamiento = startY - endY;

      domiciliaryLink?.classList.remove("domiciliaryTouch");
      clientLink?.classList.remove("clientTouch");

      if (desplazamiento > 50) {
        window.location.href = "/sign-in/client";
      } else if (desplazamiento < -50) {
        window.location.href = "/sign-in/domiciliary";
      }
    });
  });
</script>

<style>
  @reference "../../styles/global.css";

  .domiciliaryTouch {
    @apply flex-2 z-10 shadow-lg shadow-H-blue-900/50;

    img {
      @apply scale-125 md:scale-150 translate-x-0 translate-y-4;
    }
  }
  .clientTouch {
    @apply flex-2 z-10 shadow-lg shadow-H-blue-500/50;

    img {
      @apply scale-125 md:scale-150 translate-x-0 -translate-y-4;
    }
  }
</style>
