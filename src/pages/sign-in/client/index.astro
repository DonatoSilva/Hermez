---
import Layout from "@layouts/Layout.astro";
import { SignIn } from "@clerk/astro/components";

const title = "Iniciar Sesión Cliente | Domicilio Donatello";
---

<Layout title={title} sizeLogo="sm" class="relative overflow-hidden">
    <div
        class="relative z-10 flex flex-col items-center justify-center w-full mx-auto"
    >
        <div
            class="w-full flex flex-col justify-center items-center gap-4 min-h-[600px] animate-fade-up"
        >
            <h1
                class="text-2xl md:text-3xl font-bold text-H-blue-900 text-center"
            >
                Bienvenido Cliente
            </h1>
            <SignIn
                fallbackRedirectUrl={"/?org=Client"}
                signUpUrl="/sign-up/client"
                signUpFallbackRedirectUrl={"/sign-up/client"}
                signUpForceRedirectUrl={"/?org=Client"}
                transferable={false}
                appearance={{
                    elements: {
                        formButtonPrimary:
                            "bg-H-blue-500 hover:bg-H-blue-700 transition-colors",
                        card: "shadow-none bg-transparent",
                        headerTitle: "text-H-blue-900",
                        headerSubtitle: "text-H-blue-700",
                        socialButtonsBlockButton:
                            "border-H-blue-500/20 hover:bg-H-blue-500/5 transition-colors",
                        formFieldInput:
                            "border-H-blue-500/20 focus:border-H-blue-500 transition-colors",
                        footerActionLink:
                            "text-H-blue-500 hover:text-H-blue-700 transition-colors",
                    },
                }}
            />
        </div>
        <img
            src="/images/clienteFelizEnPuerta-min.webp"
            alt="Cliente feliz en la puerta"
            class="absolute -z-10 -bottom-16 right-0 w-64 md:w-96 object-contain opacity-40 animate-float select-none pointer-events-none transition-all duration-500"
        />
    </div>
</Layout>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
</style>
