---
import Layout from "@layouts/Layout.astro";
import Spinner from "@components/Spinner.astro";

const title = "Procesando inicio de sesión... | Hermez";
export const prerender = false;
---

<Layout title={title} sizeLogo="sm" class="relative">
    <Spinner
        size="md"
        color="blue-900"
        title="Verificando tu cuenta..."
        message="Por favor espera mientras procesamos tu inicio de sesión con Google."
    />
</Layout>

<script>
    import { Clerk } from "@clerk/clerk-js";
    import { PUBLIC_CLERK_PUBLISHABLE_KEY } from "astro:env/client";

    async function handleOAuthCallback() {
        const clerk = new Clerk(PUBLIC_CLERK_PUBLISHABLE_KEY);
        try {
            await clerk.load();
            const user = await clerk.handleRedirectCallback();

            if (user) {
                window.location.href = "/?org=Domiciliary";
            } else {
                window.location.href =
                    "/sign-up/domiciliary?accountNotFound=true";
            }
        } catch (error) {
            window.location.href = "/sign-in/domiciliary";
        }
    }

    // Ejecutar inmediatamente cuando la página carga
    document.addEventListener("astro:page-load", handleOAuthCallback);

    // También ejecutar si la página ya está cargada
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", handleOAuthCallback);
    } else {
        handleOAuthCallback();
    }

    // Timeout de seguridad - si después de 10 segundos no se resuelve, redirigir
    setTimeout(() => {
        if (window.location.pathname.includes("sso-callback")) {
            console.log("⏰ Timeout de seguridad - redirigiendo...");
            window.location.href = "/sign-in/domiciliary";
        }
    }, 10000);
</script>
