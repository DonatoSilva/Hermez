---
import CardHistory from "@components/record/CardHistory.astro";
import CardTotal from "@components/record/CardTotal.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";
import { actions } from "astro:actions";

const params = Astro.url.searchParams;
const searchValue = params.get("search");

if (!searchValue?.trim()) {
    return Astro.redirect("/");
}

const isNumber = /^\d+$/.test(searchValue);

if (!isNumber) {
    return Astro.redirect("/");
}

const { data, error } = await Astro.callAction(actions.client.getClient, {
    searchValue: searchValue,
});

if (!data?.ok) {
    if (data?.message == "client not found")
        return Astro.redirect("/404?error=ClientNotFound");
}

if (error) {
    return Astro.redirect("/?error=ServerError");
}

const client = data?.client;

const { phoneNumber, displayName } = client!;

const { data: records, error: errorRecords } = await Astro.callAction(
    actions.client.record.getRecords,
    {
        phoneNumber: phoneNumber,
    },
);

if (errorRecords?.code == "BAD_REQUEST") {
    return Astro.redirect("/?error=BadRequest");
}

const { records: dataCardHistory } = records!;
const isEmpty = dataCardHistory?.length == 0;

const count = dataCardHistory?.length || 0;
const prices = dataCardHistory?.map(({ deliveryPrice }) => deliveryPrice) || [];
---

<Layout>
    <div>
        <Title size="md" />
        <section class="flex flex-col max-h-fit justify-center items-center">
            <CardTotal count={count} total={prices} telephone={phoneNumber} />
        </section>
        <section>
            <h2 class="text-2xl text-H-blue-900 font-bold">
                Historial de domicilios
            </h2>
            <div class="flex flex-col gap-4 mt-6">
                {
                    isEmpty ? (
                        <div class="flex justify-center items-center">
                            <p class="text-gray-500 font-semibold">
                                No hay domicilios
                            </p>
                        </div>
                    ) : (
                        dataCardHistory?.map(
                            (
                                { deliveryDate, fullName, deliveryPrice },

                                index,
                            ) => (
                                <>
                                    <CardHistory
                                        date={new Intl.DateTimeFormat("es-CO", {
                                            dateStyle: "full",
                                        }).format(deliveryDate.toDate())}
                                        name={fullName}
                                        price={deliveryPrice}
                                    />

                                    {index < dataCardHistory.length - 1 ? (
                                        <hr class="border-t-2 w-20 mx-auto border-H-blue-300" />
                                    ) : (
                                        ""
                                    )}
                                </>
                            ),
                        )
                    )
                }
            </div>
        </section>
    </div>
</Layout>

<style></style>

<script></script>
