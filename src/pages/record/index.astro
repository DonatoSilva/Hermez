---
import Content from "@components/record/Content.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";
import { actions } from "astro:actions";

const params = Astro.url.searchParams;
const searchValue = params.get("search");

if (!searchValue?.trim()) {
    return Astro.redirect("/");
}

const isNumber = /^\d+$/.test(searchValue);

if (!isNumber) {
    return Astro.redirect("/");
}

const { data, error } = await Astro.callAction(actions.client.getClient, {
    searchValue: searchValue,
});

if (!data?.ok) {
    if (data?.message == "client not found")
        return Astro.redirect("/404?error=ClientNotFound");
}

if (error) {
    return Astro.redirect("/?error=ServerError");
}

const client = data?.client;

const { phoneNumber, displayName } = client!;

const { data: records, error: errorRecords } = await Astro.callAction(
    actions.client.record.getRecords,
    {
        phoneNumber: phoneNumber,
    },
);

if (errorRecords?.code == "BAD_REQUEST") {
    return Astro.redirect("/?error=BadRequest");
}

const { records: dataCardHistory } = records!;
const isEmpty = dataCardHistory?.length == 0;

const count = dataCardHistory?.length || 0;
const prices = dataCardHistory?.map(({ deliveryPrice }) => deliveryPrice) || [];
---

<Layout>
    <div>
        <Title size="md" />
        <Content
            count={count}
            prices={prices}
            phoneNumber={phoneNumber}
            displayName={displayName}
            isEmpty={isEmpty}
            deliveries={dataCardHistory}
        />
    </div>
</Layout>

<style></style>

<script></script>
