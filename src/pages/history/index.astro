---
import HistoryItem from "@components/history/historyItem/HistoryItem";
import Layout from "../../layouts/Layout.astro";
import ContentItems from "@components/history/ContentItems.astro";
import UserRegistrationForm from "@components/user/UserRegistrationForm.astro";
import HistoryFilterSection from "@components/history/HistoryFilterSection.astro";
import AccumulatedAmountCard from "@components/history/AccumulatedAmountCard.astro";

const { userId } = Astro.locals.auth();

if (!userId) {
  Astro.redirect("/sign-in");
}

const userExistsAPI = Astro.locals.userExistsAPI;
---

<Layout sizeLogo="md" title="Historia - Hermez" class="flex flex-col gap-4">
  {
    userExistsAPI ? (
      <main class="w-full flex flex-col gap-3">
        <HistoryFilterSection filterText="Historial de pedidos" />
        <AccumulatedAmountCard amount="$12.000" description="Monto acumulado" />
        <section class="flex gap-4 flex-col">
          <h5 class="text-lg font-semibold">Historial de solicitudes</h5>
          <p class="text-sm text-gray-600 dark:text-gray-400">hoy</p>
          <ContentItems>
            <HistoryItem type="moto" price={"10000"} address="Calle Falsa 123" status="cancelado" />
            <HistoryItem type="moto" price={"10000"} address="Calle Falsa 123" status="cancelado" />
            <HistoryItem type="moto" price={"10000"} address="Calle 5 #20-30" status="cancelado" />
          </ContentItems>
        </section>
      </main>
    ) : (
      <UserRegistrationForm userId={userId!} />
    )
  }
</Layout>
