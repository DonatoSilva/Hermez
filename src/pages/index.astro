---
import Form from "@components/Form.astro";
import FormButton from "@components/inputs/FormButton.astro";
import FormInput from "@components/inputs/FormInput.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";

const isDomiciliario = !!Astro.locals.domicile;
---

<Layout title="Busqueda de domicilios" class="flex flex-col">
    <Title />
    <div class="search-container">
        <Form>
            <FormInput
                name="search"
                id="search"
                type="tel"
                label="Busca tu historial de domicilios"
                placeholder="Numero de celular"
            />
            <FormButton type="button" class="" text="Buscar" id="btnSearch" />
        </Form>
    </div>
    {
        !isDomiciliario ? (
            <div class="w-full flex justify-center items-center my-4 link-login-domiciliario">
                <a
                    href="/domicile/"
                    class="text-H-blue-300 hover:text-H-blue-900"
                >
                    ¿Eres Domiciliario?
                </a>
            </div>
        ) : (
            ""
        )
    }
</Layout>

<style>
    .search-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
</style>

<script>
    import { navigate } from "astro:transitions/client";
    import { validateInput } from "src/scritps/validateInput";

    function Search() {
        const btnSearch = document.querySelector(
            "#btnSearch",
        ) as HTMLButtonElement;

        const search = document.querySelector("#search") as HTMLInputElement;

        if (!btnSearch) return;

        btnSearch.addEventListener("click", (e) => {
            e.preventDefault();

            btnSearch.disabled = true;
            if (
                !validateInput(
                    search,
                    "El campo de busqueda no puede estar vació",
                )
            ) {
                btnSearch.disabled = false;
                return;
            }

            const baseUrl = "/record";

            const queryParam = `?search=${search.value}`;
            const url = baseUrl + queryParam;

            navigate(url);
        });
    }

    document.addEventListener("astro:page-load", Search);
</script>
