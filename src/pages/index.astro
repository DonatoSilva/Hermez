---
import Form from "@components/Form.astro";
import FormButton from "@components/inputs/FormButton.astro";
import FormInput from "@components/inputs/FormInput.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";

const li = null;
---

<Layout li={li} title="Busqueda de domicilios">
    <Title />
    <div>
        <Form>
            <FormInput
                name="search"
                id="search"
                type="tel"
                label="Busca tu historial de domicilios"
                placeholder="Numero de celular"
            />
            <FormButton type="button" class="" text="Buscar" id="btnSearch" />
        </Form>
    </div>
</Layout>

<script>
    import { navigate } from "astro:transitions/client";

    function Search() {
        const btnSearch = document.querySelector(
            "#btnSearch",
        ) as HTMLButtonElement;

        const search = document.querySelector("#search") as HTMLInputElement;

        if (!btnSearch) return;

        btnSearch.addEventListener("click", (e) => {
            e.preventDefault();

            btnSearch.disabled = true;

            if (search.value?.trim() === "") {
                alert("El campo de busqueda no puede estar vació");
                btnSearch.disabled = false;
                return;
            }

            const baseUrl = "/record";

            const queryParam = `?search=${search.value}`;
            const url = baseUrl + queryParam;

            navigate(url);
        });
    }

    document.addEventListener("astro:page-load", Search);
</script>
