---
import HomeClientePage from "@components/roles/client/home/HomePage.astro";
import HomeDeleveryPage from "@components/roles/delivery/home/HomePage.astro";
import Layout from "@layouts/Layout.astro";
import UserRegistrationForm from "../components/user/UserRegistrationForm.astro";

const { userId } = Astro.locals.auth();

if (!userId) {
  Astro.redirect("/sign-in");
}

const isClient = Astro.locals.userRole === "User";
const userExistsAPI = Astro.locals.userExistsAPI;
const dataUser = Astro.locals.dataUser;
---

<Layout sizeLogo="md" title="Inicio - Hermez" class="flex flex-col gap-4">
  {
    !dataUser ? (
      <div
        class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative"
        role="alert"
      >
        <strong class="font-bold">Error inesperado:</strong>
        <span class="block sm:inline"
          >Hemos detectado un problema que no debería haber ocurrido. Por favor,
          intenta de nuevo más tarde.</span
        >
      </div>

    ) : (
      <section class="w-full max-w-6xl mx-auto flex flex-col gap-8">
        {
          userExistsAPI ? (
            isClient ? (
              <HomeClientePage />
            ) : (
              <HomeDeleveryPage />
            )
          ) : (
            <UserRegistrationForm />
          )
        }
      </section>
    )
  }
</Layout>
