---
import Layout from "@layouts/Layout.astro";
import { SignUp } from "@clerk/astro/components";

const title = "Registro Domiciliario | Hermez";
---

<Layout title={title} sizeLogo="sm" class="relative">
  <div
    class="relative z-10 flex flex-col items-center justify-center w-full max-w-md mx-auto"
  >
    <div
      class="w-full p-6 bg-white/80 backdrop-blur-lg rounded-2xl shadow-xl border border-H-blue-900/10 animate-fade-up"
    >
      <h1
        class="text-2xl md:text-3xl font-bold text-H-blue-900 mb-6 text-center"
      >
        Únete como Domiciliario
      </h1>
      <SignUp
        appearance={{
          elements: {
            formButtonPrimary:
              "bg-H-blue-900 hover:bg-H-blue-800 transition-colors",
            card: "shadow-none bg-transparent",
            headerTitle: "text-H-blue-900",
            headerSubtitle: "text-H-blue-700",
            socialButtonsBlockButton:
              "border-H-blue-900/20 hover:bg-H-blue-900/5 transition-colors",
            formFieldInput:
              "border-H-blue-900/20 focus:border-H-blue-900 transition-colors",
            footerActionLink:
              "text-H-blue-900 hover:text-H-blue-800 transition-colors",
          },
        }}
      />
    </div>
  </div>

  <!-- Elementos decorativos -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-H-blue-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 animate-pulse"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-H-blue-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 animate-pulse delay-150"
  >
  </div>

  <img
    src="/images/domiciliarioConCajas-min.webp"
    alt="Domiciliario con cajas"
    class="absolute bottom-0 right-0 w-64 md:w-96 object-contain opacity-10 animate-float select-none pointer-events-none"
  />
</Layout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-fade-up {
    animation: fade-up 0.6s ease-out forwards;
  }
</style>
