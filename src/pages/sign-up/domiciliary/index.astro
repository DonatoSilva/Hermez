---
import Layout from "@layouts/Layout.astro";
import { SignUp } from "@clerk/astro/components";

const title = "Registro Domiciliario | Hermez";
---

<Layout title={title} sizeLogo="sm" class="relative">
  <div
    class="relative z-10 flex flex-col items-center justify-center w-full max-w-md min-h-[600px] min-w-[400px] mx-auto"
  >
    <div
      class="w-full p-6 flex flex-col justify-center items-center gap-8 animate-fade-up"
    >
      <h1 class="text-2xl md:text-3xl font-bold text-H-blue-900 text-center">
        Únete como Domiciliario
      </h1>
      <SignUp
        signInUrl="/sign-in/domiciliary"
        unsafeMetadata={{ org: "Domiciliary" }}
        appearance={{
          elements: {
            formButtonPrimary:
              "bg-H-blue-900 hover:bg-H-blue-800 transition-colors",
            card: "shadow-none bg-transparent",
            headerTitle: "text-H-blue-900",
            headerSubtitle: "text-H-blue-700",
            socialButtonsBlockButton:
              "border-H-blue-900/20 hover:bg-H-blue-900/5 transition-colors",
            formFieldInput:
              "border-H-blue-900/20 focus:border-H-blue-900 transition-colors",
            footerActionLink:
              "text-H-blue-900 hover:text-H-blue-800 transition-colors",
          },
        }}
      />
    </div>
  </div>

  <img
    src="/images/domiciliarioConCajas-min.webp"
    alt="Domiciliario con cajas"
    class="absolute bottom-0 right-0 w-64 md:w-96 object-contain opacity-10 animate-float select-none pointer-events-none"
  />
</Layout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-fade-up {
    animation: fade-up 0.6s ease-out forwards;
  }
</style>
