---
import SignUpLayout from "@layouts/SignUpLayout.astro";

const title = "Autenticación Adicional - Domiciliario | Domicilio Donatello";
---

<SignUpLayout
  title={title}
  signUpPath="/sign-up/domiciliary"
  signInUrl="/sign-in/domiciliary"
  fallbackRedirectUrl="/?org=Domiciliary"
  imageSrc="/images/domiciliarioConCajas-min.webp"
  imageAlt="Domiciliario con cajas"
>
  <h1 class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-bold text-H-blue-900">
    Autenticación Adicional
  </h1>
  <p class="text-H-blue-700 text-sm sm:text-base lg:text-lg max-w-md lg:max-w-none">
    Solo un paso más para completar tu registro. Configuremos una autenticación adicional para
    mantener tu cuenta segura.
  </p>
</SignUpLayout>
