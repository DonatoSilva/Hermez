---
import SignUpLayout from "@layouts/SignUpLayout.astro";

const title = "Autenticación Adicional - Cliente | Domicilio Donatello";
---

<SignUpLayout
  title={title}
  signUpPath="/sign-up/client"
  signInUrl="/sign-in/client"
  fallbackRedirectUrl="/?org=User"
  imageSrc="/images/clienteFelizEnPuerta-min.webp"
  imageAlt="Cliente feliz en puerta"
>
  <h1
    class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-bold text-H-blue-900"
  >
    Autenticación Adicional
  </h1>
  <p
    class="text-H-blue-700 text-sm sm:text-base lg:text-lg max-w-md lg:max-w-none"
  >
    Solo un paso más para completar tu registro. Configuremos una autenticación
    adicional para mantener tu cuenta segura.
  </p>
</SignUpLayout>
