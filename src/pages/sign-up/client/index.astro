---
import Layout from "@layouts/Layout.astro";
import { SignUp } from "@clerk/astro/components";
import Page from "@components/sign-up/page.astro";

const title = "Registro Cliente | Hermez";
---

<Layout title={title} sizeLogo="sm" class="relative">
    <Page type="client" />
</Layout>

<style>
    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
</style>
