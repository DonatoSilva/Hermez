---
import Form from "@components/Form.astro";
import FormButton from "@components/inputs/FormButton.astro";
import FormInput from "@components/inputs/FormInput.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout>
    <Title />
    <div class="">
        <h1 class="text-center text-2xl text-H-blue-900 font-semibold">
            Registarse
        </h1>
        <hr class="my-4 bg-H-blue-300" />
        <Form id="formSignUp" class="flex flex-col gap-4 mx-3">
            <FormInput
                name="names"
                id="names"
                type="text"
                label="Nombres"
                placeholder="Ingrese sus nombres"
            />
            <FormInput
                name="surnames"
                id="surnames"
                type="text"
                label="Apellidos"
                placeholder="Ingrese sus apellidos"
            />
            <FormInput
                name="email"
                id="email"
                type="email"
                label="Correo Electrónico"
                placeholder="Ingrese su correo electrónico"
            />
            <FormInput
                name="cell"
                id="cell"
                type="tel"
                label="Celular"
                placeholder="Numero de celular"
            />
            <FormInput
                name="password"
                id="password"
                type="password"
                label="Contraseña"
                placeholder="Contraseña"
            />
            <FormInput
                name="Vpassword"
                id="Vpassword"
                type="password"
                label="Confirmar Contraseña"
                placeholder="Contraseña"
            />
            <div class="grid grid-cols-2 gap-4">
                <FormButton
                    type="button"
                    href="/domicile"
                    class="w-full text-H-blue-900 bg-white"
                    text="Iniciar sesión"
                />
                <FormButton
                    type="submit"
                    id="summitButton"
                    class=""
                    text="Registrar me"
                />
            </div>
        </Form>
    </div>
</Layout>

<style></style>

<script>
    import { actions } from "astro:actions";
    import { validateEmail, isEmpty } from "src/scritps/validateInput";

    function Registrer() {
        const form = document.querySelector("#formSignUp") as HTMLFormElement;
        const submitButton = form?.querySelector(
            "#summitButton",
        ) as HTMLButtonElement;

        const names = form?.querySelector("#names") as HTMLInputElement;
        const surnames = form?.querySelector("#surnames") as HTMLInputElement;
        const email = form?.querySelector("#email") as HTMLInputElement;
        const cell = form?.querySelector("#cell") as HTMLInputElement;
        const password = form?.querySelector("#password") as HTMLInputElement;
        const Vpassword = form?.querySelector("#Vpassword") as HTMLInputElement;

        if (!form) return;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const inputs = [
                { input: names, alertText: "Ingrese sus nombres" },
                { input: surnames, alertText: "Ingrese sus apellidos" },
                { input: email, alertText: "Ingrese su correo electrónico" },
                { input: cell, alertText: "Ingrese su número de celular" },
                { input: password, alertText: "Ingrese su contraseña" },
                { input: Vpassword, alertText: "Confirme su contraseña" },
            ];

            for (const { input, alertText } of inputs) {
                if (!isEmpty(input, alertText)) return;
            }

            if (!validateEmail(email.value.trim())) {
                alert("Por favor, ingrese un correo válido");
                return;
            }

            if (password.value.trim().length <= 8) {
                alert("La contraseña debe tener mínimo 8 caracteres");
                return;
            }

            submitButton.disabled = true;
            const formData = new FormData(form);

            const { data, error } = await actions.register(formData);

            if (error) {
                alert(error.message);
                submitButton.disabled = false;
            } else {
                alert("Registro correcto 🥳✨");
                window.location.replace("/");
            }
        });
    }

    document.addEventListener("astro:after-swap", Registrer);
    document.addEventListener("DOMContentLoaded", Registrer);
</script>
