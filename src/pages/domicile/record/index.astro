---
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";
import Content from "@components/record/Content.astro";
import { actions } from "astro:actions";
import { firebase } from "src/firebase/config";

const currentDomicile = firebase.auth.currentUser;

const { data, error } = await Astro.callAction(
    actions.domicile.deliveries.getDeliveries,
    {
        uid: currentDomicile?.uid!,
    },
);

if (error) {
    console.log(error);
}

if (!data) return Astro.redirect("/404?error=ServerError");

if (data.message === "domicile-not-found")
    return Astro.redirect("/404?error=DomicileNotFound");

const domicile = data.domicile;

if (!domicile) return Astro.redirect("/404?error=DataNotFound");
const { phoneNumber, names, deliveries } = domicile;

const count = deliveries?.length || 0;
const prices = deliveries?.map(({ deliveryPrice }) => deliveryPrice) || [];
const isEmpty = count === 0;
---

<Layout>
    <div>
        <Title size="md" />
        <Content
            count={count}
            prices={prices}
            phoneNumber={phoneNumber}
            displayName={names}
            isEmpty={isEmpty}
            deliveries={deliveries}
        />
    </div>
</Layout>

<style></style>

<script></script>
