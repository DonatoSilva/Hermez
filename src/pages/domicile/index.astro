---
import Form from "@components/Form.astro";
import FormButton from "@components/inputs/FormButton.astro";
import FormInput from "@components/inputs/FormInput.astro";
import Title from "@header/Title.astro";
import Layout from "@layouts/Layout.astro";

const email = Astro.cookies.get("email")?.value ?? "";
const remenber = !!email;
---

<Layout title="Iniciar sesión" class="flex flex-col">
    <Title />
    <div class="flex flex-col justify-center flex-1">
        <h1 class="text-center text-2xl text-H-blue-900 font-semibold">
            Iniciar sesión
        </h1>
        <hr class="my-4 bg-H-blue-300" />
        <Form id="formLogin" class="flex flex-col gap-4 mx-3">
            <FormInput
                name="email"
                id="email"
                type="email"
                label="Correo"
                placeholder="Correo electrónico"
                value={email}
            />
            <FormInput
                name="password"
                id="password"
                type="password"
                label="Contraseña"
                placeholder="Contraseña"
            />
            <FormInput
                type="checkbox"
                label="Recordarme"
                name="remenber"
                id="remenber"
                checked={remenber}
            />
            <div class="grid grid-cols-2 gap-4">
                <FormButton
                    type="button"
                    href="/domicile/signUp"
                    class="w-full text-H-blue-900 bg-white"
                    text="Registrarse"
                />
                <FormButton type="submit" class="" text="Iniciar sesión" />
            </div>
        </Form>
    </div>
</Layout>

<style></style>

<script>
    import { actions } from "astro:actions";
    import { isEmpty, validateEmail } from "src/scritps/validateInput";

    async function Login() {
        const form = document.querySelector("#formLogin") as HTMLFormElement;

        if (!form) return;

        const btnIniciarSesion = form.querySelector(
            "button[type=submit]",
        ) as HTMLButtonElement;

        const email = form.querySelector("#email") as HTMLInputElement;
        const password = form?.querySelector("#password") as HTMLInputElement;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const inputs = [
                { input: email, alertText: "Ingrese su correo electrónico" },
                { input: password, alertText: "Ingrese su contraseña" },
            ];

            for (const { input, alertText } of inputs) {
                if (!isEmpty(input, alertText)) return;
            }

            if (!validateEmail(email.value.trim())) {
                alert("Por favor, ingrese un correo válido");
                email.focus();
                return;
            }

            if (password.value.trim().length <= 8) {
                alert("La contraseña debe tener minimo 8 caracteres");
                password.focus();
                return;
            }

            btnIniciarSesion.disabled = true;
            const formData = new FormData(form);

            const { data, error } = await actions.domicile.auth.logIn(formData);

            if (error) {
                const res = await JSON.parse(error?.message);
                alert(res.code);
                btnIniciarSesion.disabled = false;
                return;
            }

            window.location.reload();
        });
    }

    document.addEventListener("astro:page-load", Login);
</script>
