---
import Button from "@components/button/Button.astro";
import { server as actions } from "@actions/index";

interface Props {
  isActive: boolean;
}

const { isActive } = Astro.props;
const { userId } = Astro.locals.auth();

const { imageUrl, firstName, lastName, emailAddresses } = (await Astro.locals.currentUser()) ?? {};
let userData = { gender: "notFound", phone: "notFound", age: 0 };

const token = await Astro.locals.auth().getToken({
  template: "jwt-back-hermez",
});

if (token === null) {
  throw new Error("Token not found");
}

const { data, error } = await Astro.callAction(actions.User.get, { token });

if (error) {
  console.error("Backend error:", error);
  throw new Error("Backend error: " + error);
} else {
  userData = data ?? {
    gender: "2",
    phone: "notFound",
    age: 0,
  };
}

const { gender, phone, age } = userData ?? {
  gender: "notFound",
  phone: "notFound",
  age: 0,
};
---

<section class:list={["min-w-full", { active: isActive }]} id="section-profile">
  <h5 class="text-lg font-semibold mb-3">Mi perfil</h5>
  <form class="w-full mx-auto flex flex-col gap-4">
    <div class="flex items-center gap-4">
      <img
        src={imageUrl ?? "/images/clienteFelizEnPuerta-min.webp"}
        alt="avatar"
        class="w-full h-full object-cover max-w-24 max-h-24 rounded-md bg-H-blue-100"
      />
      <div class="flex flex-col gap-2 flex-1">
        <Button color="bg-white text-H-blue-900" onClick="handleRemove">Eliminar foto</Button>
        <Button color="bg-H-blue-900 text-white" onClick="handleUpload">Subir foto</Button>
      </div>
    </div>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Nombre completo</span>
      <input
        class="border border-gray-300 rounded-md px-3 py-2"
        value={firstName + " " + lastName}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Correo</span>
      <input
        class="border border-gray-300 rounded-md px-3 py-2"
        value={emailAddresses?.[0]?.emailAddress}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Teléfono</span>
      <input type="tel" class="border border-gray-300 rounded-md px-3 py-2" value={phone} />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Edad</span>
      <input class="border border-gray-300 rounded-md px-3 py-2" value={age} />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Género</span>
      <input class="border border-gray-300 rounded-md px-3 py-2" value={gender} />
    </label>

    <div class="flex gap-3 mt-2">
      <Button id="save-button" color="bg-H-blue-900 text-white w-full">Guardar</Button>
      <Button id="cancel-button" color="bg-white text-H-blue-900 w-full">Cancelar</Button>
    </div>
  </form>
</section>

<script>
  import { navigate } from "astro:transitions/client";

  const sectionProfile: Element | null = document.querySelector("#section-profile");
  const saveButton: HTMLElement | null | undefined = sectionProfile?.querySelector("#save-button");
  const cancelButton: HTMLElement | null | undefined =
    sectionProfile?.querySelector("#cancel-button");

  if (saveButton) {
    saveButton.addEventListener("click", (e) => {
      e.preventDefault();
    });
  }

  if (cancelButton) {
    cancelButton.addEventListener("click", (e) => {
      e.preventDefault();
      navigate("/");
    });
  }
</script>
