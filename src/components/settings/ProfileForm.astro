---
import Button from "@components/button/Button.astro";
import { server as actions } from "@actions/index";

interface Props {
  isActive: boolean;
}

const { isActive } = Astro.props;
const { userId } = Astro.locals.auth();

const { imageUrl, firstName, lastName, emailAddresses } = (await Astro.locals.currentUser()) ?? {};
let userData = { gender: "notFound", phone: "notFound", age: 0 };

const token = await Astro.locals.auth().getToken({
  template: "jwt-back-hermez",
});

if (token === null) {
  throw new Error("Token not found");
}

const { data, error } = await Astro.callAction(actions.User.get, { token });

if (error) {
  console.error("Backend error:", error);
  throw new Error("Backend error: " + error);
} else {
  userData = data ?? {
    gender: "notFound",
    phone: "notFound",
    age: 0,
  };
}

const { gender, phone, age } = userData;
---

<section class:list={["min-w-full", { active: isActive }]} id="section-profile">
  <h5 class="text-lg font-semibold mb-3">Mi perfil</h5>
  <form class="w-full mx-auto flex flex-col gap-4" aria-label="formulario-perfil" id="profile-form">
    <div class="flex items-center gap-4">
      <img
        src={imageUrl ?? "/images/clienteFelizEnPuerta-min.webp"}
        alt="avatar"
        class="w-full h-full object-cover max-w-24 max-h-24 rounded-md bg-H-blue-100"
      />
      <div class="flex flex-col gap-2 flex-1">
        <Button color="bg-white text-H-blue-900" onClick="handleRemove">Eliminar foto</Button>
        <Button color="bg-H-blue-900 text-white" onClick="handleUpload">Subir foto</Button>
      </div>
    </div>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Nombre completo</span>
      <input
        class="border border-gray-300 rounded-md px-3 py-2"
        value={firstName + " " + lastName}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Correo</span>
      <input
        class="border border-gray-300 rounded-md px-3 py-2"
        value={emailAddresses?.[0]?.emailAddress}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Teléfono</span>
      <input
        name="phone"
        type="tel"
        class="border border-gray-300 rounded-md px-3 py-2"
        value={phone}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Edad</span>
      <input
        name="age"
        type="number"
        class="border border-gray-300 rounded-md px-3 py-2"
        value={age}
      />
    </label>

    <label class="flex flex-col gap-2">
      <span class="text-sm">Género</span>
      <select name="gender" class="border border-gray-300 rounded-md px-3 py-2">
        <option value="male" selected={gender === "male"}>Masculino</option>
        <option value="female" selected={gender === "female"}>Femenino</option>
      </select>
    </label>

    <div class="flex gap-3 mt-2">
      <Button
        id="save-button"
        color="bg-H-blue-900 text-white w-full"
        className="disabled:opacity-50 disabled:cursor-not-allowed"
        disabled>Guardar</Button
      >
      <Button id="cancel-button" color="bg-white text-H-blue-900 w-full">Cancelar</Button>
    </div>
  </form>
</section>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { toastStore } from "src/stores/StoreToast";

  function initProfileForm() {
    const sectionProfile: Element | null = document.querySelector("#section-profile");
    const saveButton: HTMLButtonElement | null | undefined =
      sectionProfile?.querySelector("#save-button");
    const cancelButton: HTMLElement | null | undefined =
      sectionProfile?.querySelector("#cancel-button");
    const form: HTMLFormElement | null | undefined = sectionProfile?.querySelector("#profile-form");

    if (!form || !saveButton) return;

    // Obtener valores iniciales del formulario
    const initialValues: Record<string, string> = {};
    const formInputs: NodeListOf<HTMLInputElement | HTMLSelectElement> = form.querySelectorAll(
      "input[name], select[name]"
    );

    formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
      initialValues[input.name] = input.value;
    });

    // Función para verificar si hay cambios
    function checkForChanges() {
      let hasChanges = false;

      formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
        if (input.value !== initialValues[input.name]) {
          hasChanges = true;
        }
      });

      if (!saveButton) {
        throw new Error("Save button not found");
      }

      // Habilitar/deshabilitar el botón guardar
      saveButton.disabled = !hasChanges;

      // Cambiar estilos del botón según el estado
      if (hasChanges) {
        saveButton.classList.remove("opacity-50", "cursor-not-allowed");
        saveButton.classList.add("hover:bg-H-blue-800");
      } else {
        saveButton.classList.add("opacity-50", "cursor-not-allowed");
        saveButton.classList.remove("hover:bg-H-blue-800");
      }
    }

    // Agregar event listeners a todos los campos
    formInputs.forEach((input) => {
      input.addEventListener("input", checkForChanges);
      input.addEventListener("change", checkForChanges);
    });

    // Verificar estado inicial
    checkForChanges();

    if (saveButton) {
      saveButton.addEventListener("click", async (e) => {
        e.preventDefault();

        if (saveButton.disabled) return;

        if (form) {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          if (!data) {
            throw new Error("Data not found");
          }

          Object.keys(data).forEach((key) => {
            if (data[key] === "") {
              delete data[key];
            }
          });

          const { error } = await actions.User.update({ user: data });
          if (error) {
            toastStore.set({
              type: "error",
              title: "Error al guardar los cambios",
              visible: true,
              autoClose: true,
              autoCloseDelay: 5000,
              message: error.message,
              emoji: "🧐",
            });
          } else {
            // Actualizar valores iniciales después de guardar exitosamente
            formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
              initialValues[input.name] = input.value;
            });
            // Mostrar toast de éxito
            toastStore.set({
              type: "success",
              title: "Cambios guardados",
              visible: true,
              autoClose: true,
              autoCloseDelay: 5000,
              message: "Los cambios se han guardado exitosamente",
              emoji: "✅",
            });
            checkForChanges();
          }
        }
      });
    }

    if (cancelButton) {
      cancelButton.addEventListener("click", (e) => {
        e.preventDefault();
        navigate("/");
      });
    }
  }

  // Inicializar cuando la página carga
  document.addEventListener("astro:page-load", initProfileForm);
  document.addEventListener("DOMContentLoaded", initProfileForm);
</script>
