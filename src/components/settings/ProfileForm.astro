---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import SelectField from "@components/forms/elements/selects/SelectField.astro";

interface ProfileFormProps {
  isActive: boolean;
}

const { isActive } = Astro.props as ProfileFormProps;

const data = Astro.locals.dataUser!;
const { image_url, first_name, last_name, email, gender, phone, age, username } = data;
---

<section class:list={["min-w-full", { active: isActive }]} id="section-profile">
  <h5 class="text-lg font-semibold mb-3">Mi perfil</h5>
  <form
    class="w-full mx-auto grid grid-cols-1 gap-4 lg:grid-cols-2"
    aria-label="formulario-perfil"
    id="profile-form"
  >
    <div
      class="flex flex-col md:flex-row lg:flex-col items-center justify-center gap-4 lg:col-span-1"
    >
      <img
        src={image_url ?? "/images/clienteFelizEnPuerta-min.webp"}
        alt="avatar"
        class="w-full h-full object-cover max-w-24 max-h-24 lg:max-w-62 lg:max-h-62 rounded-md bg-H-blue-100"
      />
      <div class="flex flex-col gap-2 w-full max-w-62">
        <Button
          id="remove-button"
          color="bg-white text-H-blue-900 disabled:text-gray-400 disabled:bg-gray-100 disabled:opacity-70"
          className="disabled:cursor-not-allowed text-sm w-full"
        >
          Eliminar foto
        </Button>
        <Button
          id="upload-button"
          color="bg-H-blue-900 text-white"
          className="disabled:cursor-not-allowed disabled:bg-gray-300 disabled:opacity-70 w-full"
        >
          Subir foto
        </Button>
      </div>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-1">
      <InputField textLabel="Nombre de usuario" name="username" type="text" value={username} />

      <InputField textLabel="Nombre" name="firstName" type="text" value={first_name} />

      <InputField textLabel="Apellido" name="lastName" type="text" value={last_name} />

      <label class="flex flex-col gap-2">
        <span class="text-sm">Correo</span>
        <input
          class="border border-gray-300 rounded-md px-3 py-2 bg-gray-100 dark:bg-gray-700 cursor-crosshair"
          value={email}
          readonly
        />
        <span class="text-xs text-gray-500">El correo no se puede modificar desde aquí</span>
      </label>

      <InputField textLabel="Teléfono" name="phone" type="tel" value={phone} />

      <InputField
        textLabel={"Edad"}
        name="age"
        type="number"
        value={age}
        helperText="Disponible solo para Barichara, Santander"
      />

      <SelectField
        id="gender"
        name="gender"
        textLabel="Género"
        value={gender}
        required
        placeholder="Selecciona un género"
        data={{
          options: [
            { value: "male", label: "Masculino" },
            { value: "female", label: "Femenino" },
          ],
        }}
      />

      <div class="flex flex-col md:flex-row gap-3 mt-2">
        <Button
          id="save-button"
          color="bg-H-blue-900 text-white w-full"
          className="disabled:opacity-50 disabled:cursor-not-allowed  "
          disabled>Guardar</Button
        >
        <Button id="cancel-button" color="bg-white text-H-blue-900 w-full">Cancelar</Button>
      </div>
    </div>
  </form>
</section>

<script>
  import { $userStore } from "@clerk/astro/client";
import { actions } from "astro:actions";
import { navigate } from "astro:transitions/client";
import { toastStore } from "src/stores/StoreToast";

  function initProfileForm() {
    // Lógica para la gestión de la imagen de perfil
    const sectionProfile: Element | null = document.querySelector("#section-profile");
    const form: HTMLFormElement | null | undefined = sectionProfile?.querySelector("#profile-form");

    if (!form) return;

    async function handleUploadPhoto(button: HTMLButtonElement) {
      const user = $userStore.get();
      if (!user) {
        toastStore.set({
          type: "error",
          title: "Error",
          visible: true,
          autoClose: true,
          autoCloseDelay: 5000,
          message: "Usuario no autenticado",
          emoji: "🧐",
        });
        return;
      }

      let fileInput = document.getElementById("fileUpload") as HTMLInputElement | null;
      if (!fileInput) {
        fileInput = document.createElement("input");
        fileInput.id = "fileUpload";
        fileInput.type = "file";
        fileInput.accept = "image/*";
        fileInput.onchange = async (e) => {
          const file = (e.target as HTMLInputElement).files?.[0];
          if (file) {
            try {
              button.disabled = true;
              await user.setProfileImage({ file });
              toastStore.set({
                type: "success",
                title: "Foto actualizada",
                visible: true,
                autoClose: true,
                autoCloseDelay: 5000,
                message: "Tu foto de perfil ha sido actualizada.",
                emoji: "📸",
              });

              navigate(window.location.pathname);
            } catch (error: any) {
              toastStore.set({
                type: "error",
                title: "Error al subir foto",
                visible: true,
                autoClose: true,
                autoCloseDelay: 5000,
                message: error.errors?.[0]?.longMessage || "Hubo un error al subir la foto.",
                emoji: "🧐",
              });
            } finally {
              button.disabled = false;
            }
          }
        };
      }

      fileInput.click();
    }

    async function handleRemovePhoto(button: HTMLButtonElement) {
      const user = $userStore.get();
      if (!user) {
        toastStore.set({
          type: "error",
          title: "Error",
          visible: true,
          autoClose: true,
          autoCloseDelay: 5000,
          message: "Usuario no autenticado",
          emoji: "🧐",
        });
        return;
      }

      try {
        button.disabled = true;
        const hasImage = user.hasImage;
        if (!hasImage) {
          toastStore.set({
            type: "warning",
            title: "Oyeee... ¡que hace?",
            visible: true,
            autoClose: true,
            autoCloseDelay: 5000,
            message: "No hay foto de perfil para eliminar.",
            emoji: "🧐",
          });
          return;
        }
        await user.setProfileImage({ file: null });
        toastStore.set({
          type: "success",
          title: "Foto eliminada",
          visible: true,
          autoClose: true,
          autoCloseDelay: 5000,
          message: "Tu foto de perfil ha sido eliminada.",
          emoji: "🗑️",
        });

        navigate(window.location.pathname);
      } catch (error: any) {
        toastStore.set({
          type: "error",
          title: "Error al eliminar foto",
          visible: true,
          autoClose: true,
          autoCloseDelay: 5000,
          message: error.errors?.[0]?.longMessage || "Hubo un error al eliminar la foto.",
          emoji: "🧐",
        });
      } finally {
        setTimeout(() => {
          button.disabled = false;
        }, 1000);
      }
    }

    const saveButton = form?.querySelector<HTMLButtonElement>("#save-button");
    if (!saveButton) return;

    // Obtener valores iniciales del formulario
    const initialValues: Record<string, string> = {};

    // Función para verificar si hay cambios
    function checkForChanges() {
      let hasChanges = false;

      formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
        if (input.value !== initialValues[input.name]) {
          hasChanges = true;
        }
      });

      if (!saveButton) {
        throw new Error("Save button not found");
      }

      // Habilitar/deshabilitar el botón guardar
      saveButton.disabled = !hasChanges;

      // Cambiar estilos del botón según el estado
      if (hasChanges) {
        saveButton.classList.remove("opacity-50", "cursor-not-allowed");
        saveButton.classList.add("hover:bg-H-blue-800");
      } else {
        saveButton.classList.add("opacity-50", "cursor-not-allowed");
        saveButton.classList.remove("hover:bg-H-blue-800");
      }
    }

    const formInputs: NodeListOf<HTMLInputElement | HTMLSelectElement> = form.querySelectorAll(
      "input[name], select[name]"
    );

    formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
      initialValues[input.name] = input.value;
    });

    // Agregar event listeners a todos los campos
    formInputs.forEach((input) => {
      input.addEventListener("input", checkForChanges);
      input.addEventListener("change", checkForChanges);
    });

    // Verificar estado inicial
    checkForChanges();

    if (saveButton) {
      saveButton.addEventListener("click", async (e) => {
        e.preventDefault();

        if (saveButton.disabled) return;

        if (form) {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          if (!data) {
            throw new Error("Data not found");
          }

          Object.keys(data).forEach((key) => {
            if (data[key] === "") {
              delete data[key];
            }
          });

          const { error } = await actions.User.update({ user: data });
          if (error) {
            toastStore.set({
              type: "error",
              title: "Error al guardar los cambios",
              visible: true,
              autoClose: true,
              autoCloseDelay: 5000,
              message: error.message,
              emoji: "🧐",
            });
          } else {
            // Actualizar valores iniciales después de guardar exitosamente
            formInputs.forEach((input: HTMLInputElement | HTMLSelectElement) => {
              initialValues[input.name] = input.value;
            });
            // Mostrar toast de éxito
            toastStore.set({
              type: "success",
              title: "Cambios guardados",
              visible: true,
              autoClose: true,
              autoCloseDelay: 5000,
              message: "Los cambios se han guardado exitosamente",
              emoji: "✅",
            });
            checkForChanges();
          }
        }
      });
    }

    const uploadButton = form?.querySelector<HTMLButtonElement>("#upload-button");
    const removeButton = form?.querySelector<HTMLButtonElement>("#remove-button");

    if (!uploadButton || !removeButton) return;

    uploadButton.addEventListener("click", async (e) => {
      e.preventDefault();
      const button = e.currentTarget as HTMLButtonElement;

      handleUploadPhoto(button);
    });

    removeButton.addEventListener("click", (e) => {
      e.preventDefault();
      const button = e.currentTarget as HTMLButtonElement;
      handleRemovePhoto(button);
    });

    const cancelButton = form?.querySelector<HTMLButtonElement>("#cancel-button");

    if (cancelButton) {
      cancelButton.addEventListener("click", (e) => {
        e.preventDefault();
        navigate("/");
      });
    }
  }

  // Inicializar cuando la página carga
  document.addEventListener("astro:page-load", initProfileForm);
</script>
