---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import SelectField from "@components/forms/elements/selects/SelectField.astro";
import Modal from "@components/modals/Modal";
import ContentVehicles from "@components/settings/vehicle/ContentVehicles";
import { Icon } from "astro-icon/components";
import EmptyAddress from "./address/favorite/EmptyAddress.astro";
import { actions } from "astro:actions";
import type { VehicleType } from "src/types/Vehicle/VehicleProps";

interface VehicleSectionProps {
  isActive: boolean;
}

const { data: vehicleTypes, error } = await Astro.callAction(
  actions.User.Vehicle.getVehicleTypes,
  new FormData()
);

if (error) {
  console.log(error);
}

const { isActive } = Astro.props as VehicleSectionProps;
const { current_vehicle = null } = Astro.locals.dataUser!;
---

<section
  id="section-vehicles"
  class:list={["min-w-full flex flex-col gap-4", { active: isActive }]}
>
  <header class="flex justify-between items-center">
    <h5 class="text-xl md:text-2xl font-semibold">Vehículos</h5>
    <Button
      id="open-modal-vehicle"
      class="px-3 py-2 rounded-md bg-H-blue-900 text-white font-semibold text-sm md:text-base cursor-pointer transition-colors duration-300"
      data-key-modal="form-vehicle"
    >
      <Icon name="solar:add-square-bold-duotone" width={20} height={20} />
      Agregar vehículo
    </Button>
  </header>

  <div class="mt-4">
    <ContentVehicles client:visible currentVehicle={current_vehicle?.vehicleId!}>
      <EmptyAddress
        slot="emptyVehicle"
        title="Sin vehículos registrados aún."
        className="opacity-40"
        emoji="🚗"
        helperText="Agrega tu primer vehículo para comenzar."
      />
    </ContentVehicles>
  </div>
</section>

<Modal title="Registrar Vehículo" keyModal="form-vehicle" client:load>
  <form id="form-vehicle" class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-3xl mx-auto">
    <input type="hidden" name="vehicleId" value="" disabled={true} />
    <div class="md:col-span-1">
      <InputField
        textLabel="Marca"
        name="brand"
        type="text"
        placeholder="Marca del vehículo: AKT"
        required
      /></div
    >
    <div class="md:col-span-1">
      <InputField
        textLabel="Modelo"
        name="model"
        type="text"
        placeholder="Modelo del vehiculo: CR4"
        required
      /></div
    >
    <div class="md:col-span-1">
      <InputField
        textLabel="Año"
        name="year"
        type="number"
        placeholder="Año del vehículo: 2020"
        required
      /></div
    >
    <div class="md:col-span-1">
      <InputField
        textLabel="Placa"
        name="licensePlate"
        type="text"
        placeholder="Placa del vehiculo: ABC123"
        required
      /></div
    >
    <div class="md:col-span-1">
      <InputField
        textLabel="VIN"
        name="vin"
        type="text"
        placeholder="VIN del vehiculo: 12345678901234567"
        required
      /></div
    >
    <div class="md:col-span-1">
      <InputField
        textLabel="Color (hex)"
        name="color"
        value="#000000"
        className="h-10 w-full rounded-full-[!important]"
        type="color"
        placeholder="Color del vehiculo: #000000"
      /></div
    >
    <div class="md:col-span-1">
      <SelectField
        textLabel="Tipo de vehículo"
        name="type_id"
        placeholder="Tipo de vehiculo"
        data={{
          options:
            vehicleTypes?.map((type: VehicleType) => ({
              value: type.id,
              label: type.name,
            })) || [],
        }}
        styling={{
          select: "text-gray-500",
        }}
        idContainer="form-vehicle"
        required
      >
        <div slot="no-options" class="flex items-center gap-2 px-3">
          <Icon name="solar:sad-square-bold" width={20} height={20} class={"text-H-black"} />
          <div class="py-2 text-gray-500"> No hay tipos de vehículos</div>
        </div>
      </SelectField>
    </div>

    <div class="col-span-full flex flex-col sm:flex-row justify-between gap-2">
      <Button id="btn-cancel-vehicle" type="button" variant="text">Cancelar </Button>
      <div class="flex flex-col sm:flex-row justify-end gap-2">
        <Button id="btn-clear-vehicle" type="button" variant={"bordered"}>Limpiar </Button>
        <Button
          id="btn-action-vehicle"
          type="submit"
          variant="default"
          disabled={true}
          className="disabled:opacity-50 disabled:bg-gray-500"
          ><Icon name="solar:diskette-bold-duotone" width={20} height={20} />
          <span id="text-action-address">Guardar vehículo</span>
        </Button>
      </div>
    </div>
  </form>
</Modal>

<script>
  import type { Actions } from "astro:actions";
import { actions } from "astro:actions";
import { listenKeys } from "nanostores";
import { changeStatusModal, getStatusModal, statusModal } from "src/stores/ModalStore";
import { toastStore } from "src/stores/StoreToast";
import { allVehicles, vehicleToEdit } from "src/stores/VehicleStore";

  document.addEventListener("astro:page-load", () => {
    let action: string | null = null;
    let fnAction:
      | Actions["User"]["Vehicle"]["create"]
      | Actions["User"]["Vehicle"]["update"]
      | null = null;
    const formVehicle = document.getElementById("form-vehicle") as HTMLFormElement | null;
    const btnClearVehicle = document.getElementById(
      "btn-clear-vehicle"
    ) as HTMLButtonElement | null;
    const btnActionVehicle = document.getElementById(
      "btn-action-vehicle"
    ) as HTMLButtonElement | null;
    const btnNewVehicle = document.getElementById("open-modal-vehicle") as HTMLButtonElement | null;
    const btnCancelVehicle = document.getElementById(
      "btn-cancel-vehicle"
    ) as HTMLButtonElement | null;

    btnClearVehicle?.addEventListener("click", () => {
      formVehicle?.reset();
    });

    btnNewVehicle?.addEventListener("click", () => {
      vehicleToEdit.set(undefined);
      formVehicle?.reset();
      changeStatusModal(
        "form-vehicle" as never,
        {
          ...getStatusModal("form-vehicle" as never),
          metaData: {
            ...getStatusModal("form-vehicle" as never).metaData,
            title: "Nuevo vehículo",
          },
          action: "create",
          isOpen: true,
        } as never
      );
    });

    btnCancelVehicle?.addEventListener("click", () => {
      vehicleToEdit.set(undefined);
      formVehicle?.reset();
      changeStatusModal(
        "form-vehicle" as never,
        {
          ...getStatusModal("form-vehicle" as never),
          isOpen: false,
        } as never
      );
    });

    listenKeys(statusModal, ["form-vehicle"], (newValues) => {
      action = newValues["form-vehicle"].action || null;
      const span = btnActionVehicle?.getElementsByTagName("span")[0];
      if (span) span.textContent = action == "create" ? "Guardar vehículo" : "Actualizar vehículo";

      const vehicleId = document?.querySelector("[name='vehicleId']") as HTMLInputElement | null;
      if (vehicleId) vehicleId.disabled = action == "edit" ? false : true;

      fnAction = action == "create" ? actions.User.Vehicle.create : actions.User.Vehicle.update;

      const data = vehicleToEdit.get();

      data &&
        Object.keys(data).forEach((key) => {
          const element = formVehicle?.querySelector(`[name="${key}"]`) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | HTMLSelectElement
            | null;

          if (element) element.value = (data as any)[key] || "";
        });

      const selectType = document?.querySelector("[name='type_id']") as HTMLSelectElement | null;
      if (selectType) selectType.value = data?.type?.id || "";
      selectType?.dispatchEvent(new Event("input"));
    });

    formVehicle?.addEventListener("change", () => {
      if (formVehicle?.checkValidity()) {
        btnActionVehicle?.removeAttribute("disabled");
      } else {
        btnActionVehicle?.setAttribute("disabled", "");
      }
    });

    formVehicle?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(formVehicle);

      try {
        if (typeof fnAction !== "function") {
          throw { message: "No se ha seleccionado una acción válida" };
        }

        const { data, error } = await (fnAction as Function)(formData);

        if (error) {
          throw error;
        }

        toastStore.set({
          visible: true,
          message: data?.message || "Vehículo creado con éxito",
          type: "success",
          autoClose: true,
          autoCloseDelay: 3000,
        });

        if (action == "create") {
          allVehicles.set([
            ...allVehicles.get(),
            data || {},
          ]);
        } else {
          allVehicles.set(
            allVehicles.get().map((vehicle) =>
              vehicle.vehicleId === data?.vehicleId ? data : vehicle
            )
          );
        }
      } catch (err) {
        toastStore.set({
          visible: true,
          message:
            (err as { message?: string })?.message || "Error inesperado al crear el vehículo",
          type: "error",
          autoClose: true,
          autoCloseDelay: 3000,
        });
      } finally {
        changeStatusModal(
          "form-vehicle" as never,
          {
            ...getStatusModal("form-vehicle" as never),
            isOpen: false,
          } as never
        );
      }
    });
  });
</script>
