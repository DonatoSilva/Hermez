---
import Button from "@components/button/Button.astro";
import AddressItem from "./address/AddressItem";
import EmptyFavorites from "./address/favorite/EmptyFavorites.astro";

interface Props {
  isActive: boolean;
}

const { isActive } = Astro.props;
---

<section
  class:list={["min-w-full flex flex-col gap-4", { active: isActive }]}
  id="section-locations"
>
  <header class="flex justify-between items-center">
    <h5 class="text-lg font-semibold mb-3">Direcciones</h5>
    <Button color="bg-H-blue-700 text-H-blue-100 hover:bg-H-blue-900">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 mr-1 inline"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
      Nueva
    </Button>
  </header>
  <div class="flex flex-col lg:flex-row gap-12">
    <article class="w-full">
      <h6 class="text-sm text-white">Direcciones favoritas</h6>
      <div class="flex flex-col gap-4">
        <EmptyFavorites />
      </div>
    </article>
    <article class="w-full">
      <h6 class="text-sm text-white">Todas las direcciones</h6>
      <div class="flex flex-col gap-4">
        <AddressItem type="work" name="Mi Trabajo" address="Carrera 8 # 10 - 32" id="address-1" />
      </div>
    </article>
  </div>
</section>
