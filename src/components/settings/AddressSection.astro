---
import Button from "@components/form-elements/Button.astro";
import InputField from "@components/form-elements/InputField.astro";
import Modal from "@components/modals/Modal";
import AddressItem from "./address/AddressItem";
import EmptyFavorites from "./address/favorite/EmptyFavorites.astro";

interface Props {
  isActive: boolean;
}

const { isActive } = Astro.props;
---

<section
  class:list={["min-w-full flex flex-col gap-4", { active: isActive }]}
  id="section-locations"
>
  <header class="flex justify-between items-center">
    <h5 class="text-lg font-semibold mb-3">Direcciones</h5>
    <Button id="new-address" color="bg-H-blue-700 text-H-blue-100 hover:bg-H-blue-900">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 mr-1 inline"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
      Nueva
    </Button>
  </header>
  <div class="flex flex-col lg:flex-row gap-10">
    <article class="w-full">
      <h6 class="text-sm text-white">Direcciones favoritas</h6>
      <div class="flex flex-col gap-4">
        <EmptyFavorites />
      </div>
    </article>
    <article class="w-full">
      <h6 class="text-sm text-white">Todas las direcciones</h6>
      <div class="flex flex-col gap-4">
        <AddressItem type="work" name="Mi Trabajo" address="Carrera 8 # 10 - 32" id="address-1" />
      </div>
    </article>
  </div>
</section>

<Modal title="Nueva dirección" client:load>
  <form class="space-y-4 p-4">
    <div>
      <InputField
        label="Nombre de la dirección"
        name="name"
        type="text"
        required
        placeholder="Ej: Casa, Trabajo, Casa de la abuela"
      />
    </div>

    <div>
      <InputField
        label="Descripción (opcional)"
        name="description"
        as="textarea"
        rows={3}
        placeholder="Ej: Apartamento 3B, al lado del parque"
      />
    </div>

    <div>
      <label for="type" class="block text-sm font-medium text-gray-700">Tipo de dirección</label>
      <select
        id="type"
        name="type"
        required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2"
      >
        <option value="">Selecciona un tipo</option>
        <option value="casa">Casa</option>
        <option value="trabajo">Trabajo</option>
        <option value="edificio">Edificio</option>
      </select>
    </div>

    <div>
      <InputField
        label="Dirección física"
        name="address"
        type="text"
        required
        placeholder="Ej: Calle Falsa 123"
      />
    </div>

    <div>
      <InputField
        textLabel="Ciudad"
        name="city"
        type="text"
        value="Barichara"
        disabled
        required
        helperText="Disponible solo para Barichara, Santander"
      />
    </div>

    <button
      type="submit"
      class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
    >
      Guardar Dirección
    </button>
  </form>
</Modal>

<script>
  import { isOpen } from "src/stores/DeliverySelectStore";

  document.addEventListener("astro:page-load", () => {
    const btnNewAddress = document.getElementById("new-address");
    btnNewAddress?.addEventListener("click", () => {
      isOpen.set(true);
    });
  });
</script>
