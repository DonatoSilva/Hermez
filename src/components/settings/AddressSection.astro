---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import SelectField from "@components/forms/elements/selects/SelectField.astro";
import Modal from "@components/modals/Modal";
import ContentAddresses from "./address/ContentAddresses";
import EmptyAddress from "./address/favorite/EmptyAddress.astro";
import { Icon } from "astro-icon/components";

interface AddressSectionProps {
  isActive: boolean;
}

const { isActive } = Astro.props as AddressSectionProps;
---

<section
  class:list={["min-w-full flex flex-col gap-4", { active: isActive }]}
  id="section-locations"
>
  <header class="flex justify-between items-center">
    <h5 class="text-lg font-semibold mb-3">Direcciones</h5>
    <Button id="new-address" color="bg-H-blue-700 text-H-blue-100 hover:bg-H-blue-900 ">
      <Icon name="solar:add-square-bold-duotone" width={20} height={20} />
      <span class="text-sm font-medium">Nueva dirección</span>
    </Button>
  </header>

  <ContentAddresses client:visible>
    <EmptyAddress
      slot="emptyPoints"
      className="opacity-40"
      emoji="📍"
      title="Sin direcciones guardadas"
      helperText="¡Añade una dirección!"
    />
    <EmptyAddress
      slot="emptyFavorite"
      className="opacity-40"
      title="Sin direcciones favoritas"
      helperText="¡Añade una dirección favorita! eso da suerte 🫢"
    />
  </ContentAddresses>
</section>

<Modal keyModal="form-address" title="Nueva dirección" client:load>
  <form
    id="form-new-address"
    class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-3xl mx-auto"
  >
    <input type="hidden" name="addressId" value="" disabled={true} />
    <div class="md:col-span-1">
      <InputField
        textLabel="Nombre de la dirección"
        name="name"
        type="text"
        required
        placeholder="Ej: Casa, Trabajo, Casa de la abuela"
      />
    </div>

    <div class="md:col-span-1">
      <SelectField
        id="type"
        name="type"
        textLabel="Tipo de dirección"
        required
        placeholder="Selecciona un tipo"
        idContainer="form-address"
        required
        data={{
          options: [
            { value: "casa", label: "Casa" },
            { value: "trabajo", label: "Trabajo" },
            { value: "edificio", label: "Edificio" },
          ],
        }}
      />
    </div>

    <div class="md:col-span-1">
      <InputField
        textLabel="Dirección física"
        name="address"
        type="text"
        required
        placeholder="Ej: Calle Falsa 123"
      />
    </div>

    <div class="md:col-span-1">
      <InputField
        textLabel="Ciudad"
        name="city"
        type="text"
        value="Barichara"
        disabled={true}
        required
        helperText="Disponible solo para Barichara, Santander"
      />
    </div>

    <div class="col-span-full">
      <InputField
        textLabel="Descripción (opcional)"
        name="description"
        as="textarea"
        rows={3}
        placeholder="Ej: Apartamento 3B, al lado del parque"
      />
    </div>

    <div class="col-span-full flex flex-col sm:flex-row justify-between gap-2">
      <Button id="btn-cancel-address" type="button" variant="text">Cancelar </Button>
      <div class="flex flex-col sm:flex-row justify-end gap-2">
        <Button id="btn-clear-address" type="button" variant={"bordered"}>Limpiar </Button>
        <Button
          id="btn-action-address"
          type="submit"
          variant="default"
          disabled={true}
          className="disabled:opacity-50 disabled:bg-gray-500"
          ><Icon name="solar:diskette-bold-duotone" width={20} height={20} />
          <span id="text-action-address">Guardar dirección</span>
        </Button>
      </div>
    </div>
  </form>
</Modal>

<script>
  import type { Actions } from "astro:actions";
import { actions } from "astro:actions";
import { listenKeys } from "nanostores";
import { addressToEdit, allAddresses } from "src/stores/AddressStore";
import { changeStatusModal, getStatusModal, statusModal } from "src/stores/ModalStore";
import { toastStore } from "src/stores/StoreToast";

  document.addEventListener("astro:page-load", () => {
    let action: string | null = null;
    let fnAction:
      | Actions["User"]["Address"]["create"]
      | Actions["User"]["Address"]["update"]
      | null = null;
    const formNewAddress = document.getElementById("form-new-address") as HTMLFormElement | null;
    const btnNewAddress = document.getElementById("new-address");
    btnNewAddress?.addEventListener("click", () => {
      addressToEdit.set(undefined);
      formNewAddress?.reset();
      changeStatusModal(
        "form-address" as never,
        {
          ...getStatusModal("form-address" as never),
          metaData: {
            ...getStatusModal("form-address" as never).metaData,
            title: "Nueva dirección",
          },
          action: "create",
          isOpen: true,
        } as never
      );
    });

    const btnCancelAddress = document.getElementById(
      "btn-cancel-address"
    ) as HTMLButtonElement | null;
    btnCancelAddress?.addEventListener("click", () => {
      addressToEdit.set(undefined);
      formNewAddress?.reset();
      changeStatusModal(
        "form-address" as never,
        {
          ...getStatusModal("form-address" as never),
          isOpen: false,
        } as never
      );
    });

    const btnActionAddress = document.getElementById(
      "btn-action-address"
    ) as HTMLButtonElement | null;

    const btnClearAddress = document.getElementById(
      "btn-clear-address"
    ) as HTMLButtonElement | null;
    btnClearAddress?.addEventListener("click", () => {
      formNewAddress?.reset();
    });

    listenKeys(statusModal, ["form-address"], (newValues) => {
      action = newValues["form-address"].action || null;

      const span = btnActionAddress?.getElementsByTagName("span")[0];
      if (span)
        span.textContent = action == "create" ? "Guardar dirección" : "Actualizar dirección";

      const addressId = document?.querySelector("[name='addressId']") as HTMLInputElement | null;
      if (addressId) addressId.disabled = action == "edit" ? false : true;

      fnAction = action == "create" ? actions.User.Address.create : actions.User.Address.update;

      const data = addressToEdit.get();

      data &&
        Object.keys(data).forEach((key) => {
          const element = formNewAddress?.querySelector(`[name="${key}"]`) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | HTMLSelectElement
            | null;

          if (element) {
            element.value = (data as any)[key] || "";
            element.dispatchEvent(new Event("input"));
          }
        });
    });

    formNewAddress?.addEventListener("change", () => {
      if (formNewAddress?.checkValidity()) {
        btnActionAddress?.removeAttribute("disabled");
      } else {
        btnActionAddress?.setAttribute("disabled", "");
      }
    });

    formNewAddress?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(formNewAddress);

      try {
        if (typeof fnAction !== "function") {
          throw { message: "No se ha seleccionado una acción válida" };
        }

        const { data, error } = await (fnAction as Function)(formData);

        if (error) {
          throw error;
        }

        toastStore.set({
          visible: true,
          message: data?.message || "Dirección creada con éxito",
          type: "success",
          autoClose: true,
          autoCloseDelay: 3000,
        });

        if (action == "create") {
          allAddresses.set([
            ...allAddresses.get(),
            data || {},
          ]);
        } else {
          allAddresses.set(
            allAddresses.get().map((address) =>
              address.addressId === data?.addressId ? data : address
            )
          );
        }
      } catch (err) {
        toastStore.set({
          visible: true,
          message:
            (err as { message?: string })?.message || "Error inesperado al crear la dirección",
          type: "error",
          autoClose: true,
          autoCloseDelay: 3000,
        });
      } finally {
        changeStatusModal(
          "form-address" as never,
          {
            ...getStatusModal("form-address" as never),
            isOpen: false,
          } as never
        );
      }
    });
  });
</script>
