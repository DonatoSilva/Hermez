---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import Modal from "@components/modals/Modal";
import ContentAddresses from "./address/ContentAddresses";
import EmptyAddress from "./address/favorite/EmptyAddress.astro";

interface Props {
  isActive: boolean;
}

const { isActive } = Astro.props;
---

<section
  class:list={["min-w-full flex flex-col gap-4", { active: isActive }]}
  id="section-locations"
>
  <header class="flex justify-between items-center">
    <h5 class="text-lg font-semibold mb-3">Direcciones</h5>
    <Button id="new-address" color="bg-H-blue-700 text-H-blue-100 hover:bg-H-blue-900">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 mr-1 inline"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
      Nueva
    </Button>
  </header>

  <ContentAddresses client:visible>
    <EmptyAddress
      slot="emptyPoints"
      className="opacity-40"
      emoji="📍"
      title="Sin direcciones guardadas"
      helperText="¡Añade una dirección!"
    />
    <EmptyAddress
      slot="emptyFavorite"
      className="opacity-40"
      title="Sin direcciones favoritas"
      helperText="¡Añade una dirección favorita! eso da suerte 🫢"
    />
  </ContentAddresses>
</section>

<Modal keyModal="new-address" title="Nueva dirección" client:load>
  <form id="form-new-address" class="space-y-4 p-4">
    <div>
      <InputField
        textLabel="Nombre de la dirección"
        name="name"
        type="text"
        required
        placeholder="Ej: Casa, Trabajo, Casa de la abuela"
      />
    </div>

    <div>
      <InputField
        textLabel="Descripción (opcional)"
        name="description"
        as="textarea"
        rows={3}
        placeholder="Ej: Apartamento 3B, al lado del parque"
      />
    </div>

    <div>
      <label for="type" class="block text-sm font-medium text-gray-700">Tipo de dirección</label>
      <select
        id="type"
        name="type"
        required
        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2"
      >
        <option value="">Selecciona un tipo</option>
        <option value="casa">Casa</option>
        <option value="trabajo">Trabajo</option>
        <option value="edificio">Edificio</option>
      </select>
    </div>

    <div>
      <InputField
        textLabel="Dirección física"
        name="address"
        type="text"
        required
        placeholder="Ej: Calle Falsa 123"
      />
    </div>

    <div>
      <InputField
        textLabel="Ciudad"
        name="city"
        type="text"
        value="Barichara"
        disabled={true}
        required
        helperText="Disponible solo para Barichara, Santander"
      />
    </div>

    <Button type="submit" variant="default"> Guardar Dirección </Button>
  </form>
</Modal>

<script>
  import { actions } from "astro:actions";
  import { changeStatusModal } from "src/stores/ModalStore";
  import { toastStore } from "src/stores/StoreToast";

  document.addEventListener("astro:page-load", () => {
    const btnNewAddress = document.getElementById("new-address");
    btnNewAddress?.addEventListener("click", () => {
      changeStatusModal("new-address" as never, true as never);
    });

    const formNewAddress = document.getElementById("form-new-address") as HTMLFormElement | null;
    formNewAddress?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(formNewAddress);

      try {
        const { data, error } = await actions.User.Address.create(formData);

        if (error) {
          toastStore.set({
            visible: true,
            message: error.message,
            type: "error",
            autoClose: true,
            autoCloseDelay: 3000,
          });
          return;
        }

        toastStore.set({
          visible: true,
          message: data?.message || "Dirección creada con éxito",
          type: "success",
          autoClose: true,
          autoCloseDelay: 3000,
        });
      } catch (err) {
        console.error(err);
        toastStore.set({
          visible: true,
          message: "Error inesperado al crear la dirección",
          type: "error",
          autoClose: true,
          autoCloseDelay: 3000,
        });
      } finally {
        changeStatusModal("new-address" as never, false as never);
      }
    });
  });
</script>
