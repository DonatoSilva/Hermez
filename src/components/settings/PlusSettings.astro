---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";
import Modal from "@components/modals/Modal";
import { Icon } from "astro-icon/components";

const currentUser = await Astro.locals.currentUser();
const hasPassword = currentUser?.passwordEnabled;

interface PlusSettingsProps {
  isActive: boolean;
}

const { isActive } = Astro.props as PlusSettingsProps;
---

<section class:list={["min-w-full flex flex-col gap-4", { active: isActive }]} id="section-more">
  <header class="flex flex-col justify-between items-start">
    <h5 class="text-lg font-semibold mb-3">Configuraciones avanzadas</h5>
    <div class="flex gap-2 items-center">
      <p>Funciones extra para el usuario, muévelo todo con cuidado.</p>
    </div>
  </header>
  <div class="flex flex-col sm:flex-row gap-2">
    <Button id="change-password" variant="bordered"
      ><Icon name="solar:password-bold-duotone" width="24" height="24" />
      {hasPassword ? "Cambiar contraseña" : "Añadir contraseña"}</Button
    >
    <Button id="delete-user" variant="danger"
      ><Icon name="solar:user-cross-bold" width="24" height="24" /> Eliminar cuenta</Button
    >
  </div>
</section>

<Modal title="Configuraciones avanzadas" keyModal="delete-user" client:load>
  <div
    class="flex flex-col md:flex-row items-center gap-4 md:gap-8 w-full justify-center align-center min-h-fit max-w-3xl mx-auto"
  >
    <img
      src="/images/clienteFelizEnPuerta-min.webp"
      alt="Hasta pronto"
      class="w-52 h-52 rounded-md object-cover"
      loading="lazy"
    />
    <div class="flex flex-col gap-2">
      <h3 class="text-xl font-semibold">¿Confirmas eliminar tu cuenta?</h3>
      <p class="text-sm text-H-blue-900">
        Gracias por acompañarnos. Esta acción es irreversible; si te animas, estaremos aquí para
        darte la bienvenida cuando regreses.
      </p>
      <div class="flex justify-end gap-2">
        <Button id="close-delete-user" variant="text">Cancelar</Button>
        <Button id="confirm-delete-user" variant="danger">Eliminar</Button>
      </div>
    </div>
  </div>
</Modal>

<Modal title="Configuraciones avanzadas" keyModal="change-password" client:load>
  <div
    class="flex flex-col md:flex-row items-center gap-4 md:gap-8 w-full justify-center align-center min-h-fit max-w-3xl mx-auto"
  >
    <img
      src="/images/clienteFelizEnPuerta-min.webp"
      alt="Hasta pronto"
      class="w-52 h-52 rounded-md object-cover"
      loading="lazy"
    />
    <div class="flex flex-col gap-2">
      <h3 class="text-xl font-semibold">
        {hasPassword ? "Cambiar contraseña" : "Añadir contraseña"}
      </h3>
      <p class="text-sm text-H-blue-900">
        Recomendamos que uses una contraseña segura y única para tu cuenta. - Debería contener al
        menos 8 caracteres, incluir letras mayúsculas y minúsculas, números y caracteres especiales.
      </p>
      {
        !hasPassword && (
          <span class="text-red-500">
            (No tienes una contraseña, crea una y añade una forma mas de acceder a tu cuenta.)
          </span>
        )
      }
      <form id="change-password-form" class="flex flex-col gap-4">
        {
          hasPassword && (
            <InputField
              id="old-password"
              textLabel="Contraseña actual"
              helperText=""
              name="old-password"
              type="password"
              required={true}
            />
          )
        }
        <InputField
          id="new-password"
          textLabel="Nueva contraseña"
          name="new-password"
          helperText=""
          type="password"
          required={true}
        />
        <InputField
          id="confirm-password"
          textLabel="Confirmar contraseña"
          helperText=""
          name="confirm-password"
          type="password"
          required={true}
        />
      </form>
      <div class="flex justify-end gap-2">
        <Button id="close-change-password" variant="text">Cancelar</Button>
        <Button id="confirm-change-password" variant="danger">Cambiar</Button>
      </div>
    </div>
  </div>
</Modal>

<script>
  import { $userStore } from "@clerk/astro/client";
  import { isEmpty } from "@scripts/validateInput";
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { changeStatusModal, getStatusModal } from "src/stores/ModalStore";
  import { toastStore } from "src/stores/StoreToast";

  document.addEventListener("astro:page-load", () => {
    const changePasswordForm = document.getElementById("change-password-form") as HTMLFormElement;

    const deleteUserButton = document.getElementById("delete-user");
    const confirmDeleteUserButton = document.getElementById("confirm-delete-user");
    const closeDeleteUserButton = document.getElementById("close-delete-user");

    const changePasswordButton = document.getElementById("change-password");
    const confirmChangePasswordButton = document.getElementById("confirm-change-password");
    const closeChangePasswordButton = document.getElementById("close-change-password");

    changePasswordButton?.addEventListener("click", () => {
      changeStatusModal(
        "change-password" as never,
        {
          ...getStatusModal("change-password" as never),
          isOpen: true,
        } as never
      );
    });

    closeChangePasswordButton?.addEventListener("click", () => {
      changeStatusModal(
        "change-password" as never,
        {
          ...getStatusModal("change-password" as never),
          isOpen: false,
        } as never
      );
    });

    confirmChangePasswordButton?.addEventListener("click", async () => {
      try {
        const oldPassword = document.getElementById("old-password") as HTMLInputElement;
        const password = document.getElementById("new-password") as HTMLInputElement;
        const confirmPassword = document.getElementById("confirm-password") as HTMLInputElement;
        const hasPassword = $userStore.get()?.passwordEnabled;

        if (hasPassword) {
          if (!isEmpty(oldPassword)) {
            const helperText = document.getElementById("old-password-helper") as HTMLSpanElement;
            helperText.textContent = "Por favor, ingresa tu contraseña actual.";
            helperText.classList.remove("text-gray-500");
            helperText.classList.add("text-red-500");
            return;
          } else {
            const helperText = document.getElementById("old-password-helper") as HTMLSpanElement;
            helperText.textContent = "";
            helperText.classList.remove("text-red-500");
            helperText.classList.add("text-gray-500");
          }
        }

        if (!isEmpty(password)) {
          const helperText = document.getElementById("new-password-helper") as HTMLSpanElement;
          helperText.textContent = "Por favor, ingresa tu contraseña nueva.";
          helperText.classList.remove("text-gray-500");
          helperText.classList.add("text-red-500");
          return;
        } else {
          const helperText = document.getElementById("new-password-helper") as HTMLSpanElement;
          helperText.textContent = "";
          helperText.classList.remove("text-red-500");
          helperText.classList.add("text-gray-500");
        }

        if (!isEmpty(confirmPassword)) {
          const helperText = document.getElementById("confirm-password-helper") as HTMLSpanElement;
          helperText.textContent = "Por favor, confirma tu contraseña nueva.";
          helperText.classList.remove("text-gray-500");
          helperText.classList.add("text-red-500");
          return;
        } else {
          const helperText = document.getElementById("confirm-password-helper") as HTMLSpanElement;
          helperText.textContent = "";
          helperText.classList.remove("text-red-500");
          helperText.classList.add("text-gray-500");
        }

        if (password.value !== confirmPassword.value) {
          const helperText = document.getElementById("confirm-password-helper") as HTMLSpanElement;
          helperText.textContent = "Las contraseñas nuevas no coinciden.";
          helperText.classList.remove("text-gray-500");
          helperText.classList.add("text-red-500");
          return;
        } else {
          const helperText = document.getElementById("confirm-password-helper") as HTMLSpanElement;
          helperText.textContent = "";
          helperText.classList.remove("text-red-500");
          helperText.classList.add("text-gray-500");
        }

        const payload: {
          password: string;
          confirmPassword: string;
          oldPassword?: string;
        } = {
          password: password.value || "",
          confirmPassword: confirmPassword.value || "",
        };

        if (hasPassword) {
          payload.oldPassword = oldPassword.value || "";
        }

        const { data, error } = await actions.User.changePassword(payload);

        if (error) {
          toastStore.set({
            visible: true,
            message: error.message,
            type: "error",
            autoClose: true,
            autoCloseDelay: 3000,
          });
          changeStatusModal(
            "change-password" as never,
            {
              ...getStatusModal("change-password" as never),
              isOpen: false,
            } as never
          );
          return;
        }

        if (data?.message) {
          toastStore.set({
            visible: true,
            message: `${data?.message} 😎` || "Contraseña cambiada con éxito",
            type: "success",
            autoClose: true,
            autoCloseDelay: 3000,
          });
        }

        changeStatusModal(
          "change-password" as never,
          {
            ...getStatusModal("change-password" as never),
            isOpen: false,
          } as never
        );

        setTimeout(() => {
          navigate("/");
        }, 3000);
      } catch (error) {
        console.error(error);
        toastStore.set({
          visible: true,
          message: (error as any).message || "Error al cambiar la contraseña",
          type: "error",
          autoClose: true,
          autoCloseDelay: 3000,
        });
        changeStatusModal(
          "change-password" as never,
          {
            ...getStatusModal("change-password" as never),
            isOpen: false,
          } as never
        );
      } finally {
        changePasswordForm?.reset();
      }
    });

    deleteUserButton?.addEventListener("click", () => {
      changeStatusModal(
        "delete-user" as never,
        {
          ...getStatusModal("delete-user" as never),
          isOpen: true,
        } as never
      );
    });

    closeDeleteUserButton?.addEventListener("click", () => {
      changeStatusModal(
        "delete-user" as never,
        {
          ...getStatusModal("delete-user" as never),
          isOpen: false,
        } as never
      );

      toastStore.set({
        visible: true,
        message: "Que buena decisión, esperamos verte pronto.",
        type: "info",
        emoji: "🥳",
        autoClose: true,
        autoCloseDelay: 3000,
      });
    });

    confirmDeleteUserButton?.addEventListener("click", async () => {
      try {
        const { data, error } = await actions.User.delete({});

        if (error) {
          toastStore.set({
            visible: true,
            message: error.message,
            type: "error",
            autoClose: true,
            autoCloseDelay: 3000,
          });
          return;
        }

        if (data?.message) {
          toastStore.set({
            visible: true,
            message: `${data?.message}, Esto es un adiós 😥.` || "Cuenta eliminada con éxito",
            type: "success",
            autoClose: true,
            autoCloseDelay: 3000,
          });

          data.success &&
            setTimeout(() => {
              window.Clerk.signOut();
            }, 3000);
        }
      } catch (error) {
        console.error(error);
      } finally {
        changeStatusModal(
          "delete-user" as never,
          {
            ...getStatusModal("delete-user" as never),
            isOpen: false,
          } as never
        );
      }
    });
  });
</script>
