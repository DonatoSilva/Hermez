---
interface Props {
  size?: "sm" | "md" | "lg";
  color?: string;
  className?: string;
}

const { size = "lg", color = "text-H-blue-900", className = "" } = Astro.props;
---

<a href="/" transition:name="title" class={`max-h-min ${className}`}>
  <div class="max-h-min">
    <p
      class={`${color} font-normal leading-none ${
        size === "sm" || size === "md" ? "text-xs" : "text-sm"
      }`}
    >
      Domicilios
    </p>
    <h1
      class={`${color} font-bold leading-[0.7] max-h-min ${
        size === "sm" ? "text-3xl" : size === "md" ? "text-5xl" : "text-7xl"
      }`}
    >
      Hermez
    </h1>
  </div>
</a>
