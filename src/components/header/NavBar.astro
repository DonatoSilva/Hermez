---
import Logo from "./Logo.astro";
import UserProfile from "@components/user/UserProfile.astro";
import ThemeToggle from "@components/button/ThemeToggle.astro";
import MenuIcon from "@header/icons/MenuIcon.astro";

const pages = {
  Inicio: "/",
  Historia: "/history",
  Configuración: "/settings",
};


interface NavBarProps {
  size?: "sm" | "md" | "lg";
  pageActive?: string;
}

const { size = "lg", pageActive = Astro.url.pathname } = Astro.props as NavBarProps;

const userId = Astro.locals.auth()?.userId;
---

<nav
  class="flex items-center justify-between w-full max-w-6xl mx-auto px-4 py-2"
>
  <Logo size={size} className="-mt-1.5" color="text-H-blue-900 dark:text-H-blue-100 "/>
  {
    userId ? (
      <ul
    class="hidden md:flex gap-4 px-3 py-2 min-h-full items-center rounded-lg text-H-blue-100 bg-H-blue-900"
  >
    {
      Object.entries(pages).map(([key, value]) => (
        <a
          class={`w-full px-4 py-1.5 hover:bg-H-blue-500 h-fit rounded-md transition-colors cursor-pointer
            ${pageActive === value ? "bg-H-blue-700 font-semibold" : ""}`}
          href={value}
          data-astro-prefetch="viewport"
        >
          {key}
        </a>
      ))
    }
  </ul>
  <button
    class="border border-H-blue-900 rounded-md py-1 px-2 cursor-pointer md:hidden"
    id="navMobile"
  >
    <MenuIcon />
  </button>
   
  <UserProfile 
    visibleSize="lg"
  />
   ) : ""
  }
</nav>

{
  userId ? (
    <dialog
      id="navMobile"
      closedby="any"
      class="min-h-dvh w-full max-w-md top-0 left-auto px-6 py-4 right-0 bg-H-blue-900 "
    >
    <nav class="flex flex-col flex-1 gap-8 text-white">
        <header class="flex flex-row justify-between items-center">
          <Logo size={size} color="text-H-blue-100" />
          <form method="dialog">
            <button
              class="border border-H-blue-100 rounded-full py-2 px-2 cursor-pointer md:hidden"
              id="closeNavMobile"
              autofocus
            >
              <svg
                width="30"
                height="30"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M6 18L18 6M6 6L18 18"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </form>
        </header>
        <ul class="flex flex-col gap-4">
          {
            Object.entries(pages).map(([key, value]) => (
              <a
                class={`w-full px-6 py-3 hover:bg-H-blue-500 rounded-md transition-colors cursor-pointer text-center
                  ${pageActive === value ? "bg-H-blue-700 font-semibold" : ""}`}
                href={value}
              >
                {key}
              </a>
            ))
          }
        </ul>
    </nav>
    <div class="flex gap-6 items-center">
      <UserProfile
        position="up"
        className={"text-H-black dark:text-H-blue-100 sm:w-full [&>div]:justify-between flex-1"}
        visibleSize="sm"
      />
      <ThemeToggle />
    </div>
  </dialog>
  ): ""
}

<script>
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector("dialog");
    const openButton = document.querySelector("#navMobile");
    const closeButton = document.querySelector("#closeNavMobile");

    if (!dialog || !openButton || !closeButton) return;
    dialog.close();

    openButton.addEventListener("click", () => {
      dialog.showModal();
    });

    closeButton.addEventListener("click", () => {
      dialog.close();
    });
  });
</script>

<style>
  dialog:open {
    opacity: 1;
    transform: translateX(0);
    display: flex;
    flex-direction: column;
  }

  dialog {
    display: hidden;
    opacity: 0;
    transform: translateX(100%);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out,
      overlay 0.3s ease-out allow-discrete,
      display 0.3s ease-out allow-discrete;
  }

  @starting-style {
    dialog:open {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  dialog::backdrop {
    backdrop-filter: blur(3px);
    background-color: rgb(255 255 255 / 0%);
    transition:
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete,
      background-color 0.3s;
  }

  dialog:open::backdrop {
    background-color: rgb(255 255 255 / 30%);
  }

  @starting-style {
    dialog:open::backdrop {
      background-color: rgb(255 255 255 / 0%);
    }
  }

  @media (min-width: 48rem) {
    dialog:open {
      display: none;
    }
  }
</style>
