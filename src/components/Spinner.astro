---
interface Props {
    size?: "sm" | "md" | "lg";
    color?: "blue-500" | "blue-900";
    title?: string;
    message?: string;
}

const {
    size = "md",
    color = "blue-500",
    title = "Cargando...",
    message = "Por favor espera mientras procesamos tu solicitud.",
} = Astro.props;

// Configuración de tamaños
const sizeClasses = {
    sm: "h-8 w-8",
    md: "h-16 w-16",
    lg: "h-24 w-24",
};

// Configuración de colores
const colorClasses = {
    "blue-500": "border-H-blue-500",
    "blue-900": "border-H-blue-900",
};
---

<div class="flex flex-col items-center justify-center min-h-[400px]">
    <div
        class={`animate-spin rounded-full ${sizeClasses[size]} border-b-2 ${colorClasses[color]} mb-4`}
    >
    </div>
    <h1 class="text-xl font-semibold text-H-blue-900 mb-2">
        {title}
    </h1>
    <p class="text-H-blue-700 text-center">
        {message}
    </p>
</div>

<style>
    @keyframes spin {
        0% {
            transform: rotate(0deg);
        }
        100% {
            transform: rotate(360deg);
        }
    }

    .animate-spin {
        animation: spin 1s linear infinite;
    }
</style>
