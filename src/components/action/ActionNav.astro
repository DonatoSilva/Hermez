---
import FormButton from "../inputs/FormButton.astro";
import FormInput from "../inputs/FormInput.astro";
import Modal from "./Modal.astro";
import AddAndEdit from "../record/Modals/AddAndEdit.astro";

// Obtener Url
const pathName = new URL(Astro.request.url).pathname;
const isRecordClient = pathName == "/record";

const displayName = Astro.locals.domicile?.displayName;
---

<div id="NavAdmin" class="">
  <div id="floatingMenu" class="floating-menu">
    <ul class="text-center">
      {
        isRecordClient ? (
          <>
            <a id="createRecord" data-is-modal="createRecordModal">
              Agregar domicilio
            </a>
            <a id="deleteClient" data-is-modal="deleteClientModal">
              Eliminar cliente
            </a>
          </>
        ) : (
          ""
        )
      }

      <a id="createClient" data-is-modal="createClientModal">Crear cliente</a>
      <a href="/domicile/record">Mi historial</a>
      <a id="LogOut">Cerrar sesión</a>
    </ul>
  </div>

  <button id="menuToggle" class="menu-toggle text-xl font-semibold">
    {displayName}
    <div class="menu-icon">
      <div class="bar1"></div>
      <div class="bar2"></div>
      <div class="bar3"></div>
    </div>
  </button>
</div>

<Modal
  id="createClientModal"
  title="Crear cliente"
  description="Nos alegra que quieras agregar un nuevo cliente a nuestra familia. Por favor, ingrese los datos del cliente para agregarlo a la base de datos."
>
  <form class="flex flex-col gap-4">
    <FormInput
      name="displayName"
      type="text"
      label="Nombre"
      placeholder="Nombre del cliente"
    />
    <FormInput
      name="phoneNumber"
      type="tel"
      label="Teléfono"
      placeholder="Teléfono del cliente"
    />
    <FormButton type="submit" text="Crear" />
  </form>
</Modal>

<Modal
  id="deleteClientModal"
  title="Eliminar cliente"
  description="¿Estás seguro de querer eliminar este cliente?"
>
  <form class="flex flex-col gap-4">
    <FormButton type="submit" text="Eliminar" />
  </form>
</Modal>

<AddAndEdit />

<style>
  @reference '../../styles/global.css';

  .menu-toggle {
    @apply fixed bottom-0 right-2/4 translate-x-1/2 px-4 py-2 text-white bg-H-blue-900 border-none rounded-md;

    display: flex;
    align-items: center;
    margin-bottom: 10px;
    z-index: 1000;
  }

  .floating-menu {
    @apply fixed bottom-0 right-2/4 translate-x-1/2 p-4 text-white bg-H-blue-900 border-none rounded-md;
    width: 100%;
    max-width: min-content;
    display: flex;
    align-items: center;
    margin-bottom: 65px;
    transition: bottom 0.4s;
    bottom: -100%;
    z-index: 1000;

    a,
    button {
      cursor: pointer;
      text-decoration: none;
      display: block;
      min-width: max-content;
      @apply mt-2;

      &:after {
        content: "";
        display: block;
        margin: 8px auto 0px auto;
        border-radius: 5px;
        width: 30%;
        height: 1px;
        background-color: #fff;
        transition: 0.4s;
      }

      &:hover {
        font-weight: bold;
        transition: 0.4s;

        &:after {
          width: 100%;
          height: 2px;
        }
      }
    }

    ul {
      width: 100%;

      li {
        &:hover {
          border-bottom: #fff 1px solid;
        }
      }
    }

    &.open {
      bottom: 0;
    }
  }

  .menu-icon {
    display: inline-block;
    margin-left: 10px;
    margin-top: -2px;
    width: fit-content;
    height: 100%;

    div {
      width: 25px;
      height: 2px;
      background-color: #fff;
      margin-top: 6px;
      transition: 0.4s;
      border-radius: 5px;
    }
  }

  .menu-icon.open {
    .bar1 {
      transform: rotate(-45deg) translate(-4px, 6px);
    }

    .bar2 {
      opacity: 0;
    }

    .bar3 {
      transform: rotate(45deg) translate(-4px, -8px);
    }
  }
</style>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { validateInput } from "src/scritps/validateInput";
  import { createDateCorrect } from "src/scritps/convertDate";

  import { openModal, closeModal } from "src/scritps/modal/modalActions";

  function initModals() {
    const nav = document.querySelector("#NavAdmin") as HTMLDivElement;
    const btnModals = nav?.querySelectorAll("[data-is-modal]");

    btnModals?.forEach((btnModal) => {
      const dataIsModal = btnModal.getAttribute("data-is-modal");
      btnModal.addEventListener("click", () => {
        const modal = document.querySelector(
          `#${dataIsModal}`
        ) as HTMLDialogElement;
        openModal(modal);
      });
    });

    ///logic for create client modal
    const modalCreateClient = document.querySelector(
      "#createClientModal"
    ) as HTMLDialogElement;

    const formCreateClient = modalCreateClient?.querySelector("form");

    formCreateClient?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const btnSubmit = formCreateClient?.querySelector(
        "button[type='submit']"
      ) as HTMLButtonElement;

      btnSubmit.disabled = true;
      await createClient(formCreateClient);
      btnSubmit.disabled = false;
    });

    ///logic for delete client modal
    const modalDeleteClient = document.querySelector(
      "#deleteClientModal"
    ) as HTMLDialogElement;

    const formDeleteClient = modalDeleteClient?.querySelector("form");

    formDeleteClient?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btnSubmit = formDeleteClient?.querySelector(
        "button[type='submit']"
      ) as HTMLButtonElement;

      btnSubmit.disabled = true;
      await deleteClient(formDeleteClient);
      btnSubmit.disabled = false;
    });

    ///logic for add record modal
    const modalCreateRecord = document.querySelector(
      "#createRecordModal"
    ) as HTMLDialogElement;

    const formCreateRecord = modalCreateRecord?.querySelector("form");

    formCreateRecord?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const btnSubmit = formCreateRecord?.querySelector(
        "button[type='submit']"
      ) as HTMLButtonElement;

      btnSubmit.disabled = true;
      await createRecord(formCreateRecord);
      btnSubmit.disabled = false;
    });
  }

  async function createRecord(form: HTMLFormElement) {
    const deliveryDate = form.querySelector(
      'input[name="deliveryDate"]'
    ) as HTMLInputElement;
    const deliveryPrice = form.querySelector(
      'input[name="deliveryPrice"]'
    ) as HTMLInputElement;
    const paidStatus = form.querySelector(
      'input[name="paidStatus"]'
    ) as HTMLInputElement;

    const inputs = [
      {
        input: deliveryDate,
        alertText: "La fecha de entrega es requerida",
      },
      {
        input: deliveryPrice,
        alertText: "El precio de entrega es requerido",
      },
      {
        input: paidStatus,
        alertText: "El estado de pago es requerido",
      },
    ];

    for (const { input, alertText } of inputs) {
      if (!validateInput(input, alertText)) return;
    }

    const phoneNumber = new URL(window.location.href).searchParams.get(
      "search"
    );

    if (!phoneNumber) {
      alert("No se pudo obtener el número de teléfono");
      return;
    }

    const fecha = createDateCorrect(deliveryDate.value).toISOString();

    const { data, error } = await actions.client.record.createRecord({
      phoneNumber: phoneNumber,
      deliveryDate: fecha,
      deliveryPrice: parseInt(deliveryPrice.value),
      paidStatus: paidStatus.checked,
    });

    if (!data?.ok) {
      alert(data?.message);
      return;
    }

    if (error) {
      console.log(error);
      alert(error);
      return;
    }

    if (data?.ok) {
      alert("Domicilio creado correctamente");
      const modalCreateRecord = form.closest("dialog");
      closeModal(modalCreateRecord as HTMLDialogElement);
      navigate(window.location.href, { history: "replace" });
      return;

      /* TODO: Se puede hacer una insert del cardHistory deber de recargar la pagina, para reducir el consumo de recursos. Tambien se podria hacer un re-render optimizta del componente. */
    }

    alert("Algo salio mal");
  }

  async function deleteClient(form: HTMLFormElement) {
    const phoneNumber = new URL(window.location.href).searchParams.get(
      "search"
    );

    if (!phoneNumber) {
      alert("No se pudo obtener el número de teléfono");
      return;
    }

    if (phoneNumber.valueOf().length != 10) {
      alert("El numero debe tener 10 digitos");
      return;
    }

    const { data, error } = await actions.client.removeClient({
      phoneNumber: phoneNumber!.trim(),
    });

    if (data?.code == 403) {
      alert("No se pudo eliminar el cliente: " + data?.message);
      return;
    }

    if (error) {
      alert(error.message);
      return;
    }

    if (data?.ok) {
      alert("Cliente eliminado correctamente");
      const modalDeleteClient = form.closest("dialog");
      closeModal(modalDeleteClient as HTMLDialogElement);
      navigate("/");
    }
  }

  async function createClient(form: HTMLFormElement) {
    const displayName = form.querySelector(
      "input[name='displayName']"
    ) as HTMLInputElement;
    const phoneNumber = form.querySelector(
      "input[name='phoneNumber']"
    ) as HTMLInputElement;

    const inputs = [
      {
        input: displayName,
        alertText: "El nombre del cliente es requerido",
      },
      {
        input: phoneNumber,
        alertText: "El teléfono del cliente es requerido",
      },
    ];

    for (const { input, alertText } of inputs) {
      if (!validateInput(input, alertText)) return;
    }

    const formData = new FormData(form);

    const { data, error } = await actions.client.createClient(formData);

    if (!data?.ok) {
      if (data?.message == "client already exists") {
        alert("El cliente ya existe");
      }

      const modalCreateClient = form.closest("dialog");
      closeModal(modalCreateClient as HTMLDialogElement);
      return;
    }

    const modalCreateClient = form.closest("dialog");
    closeModal(modalCreateClient as HTMLDialogElement);
    alert("Cliente creado correctamente");
  }

  function toggleNav() {
    const nav = document.querySelector("#NavAdmin") as HTMLDivElement;
    const optLogOut = nav?.querySelector("#LogOut");

    initModals();

    optLogOut?.addEventListener("click", () => {
      actions.domicile.auth
        .logout()
        .then(() => {
          navigate("/");
        })
        .catch(async (e) => {
          const res = await JSON.parse(e);
          alert(res.message);
        });
    });

    const menuToggle = document.getElementById(
      "menuToggle"
    ) as HTMLButtonElement;
    const floatingMenu = document.getElementById(
      "floatingMenu"
    ) as HTMLDivElement;
    const menuIcon = document.querySelector(".menu-icon") as HTMLDivElement;

    menuToggle?.addEventListener("click", () => {
      floatingMenu.classList.toggle("open");
      menuIcon.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      if (
        !floatingMenu.contains(e.target as Node) &&
        !menuToggle.contains(e.target as Node)
      ) {
        floatingMenu.classList.remove("open");
        menuIcon.classList.remove("open");
      }
    });
  }

  document.addEventListener("astro:page-load", toggleNav);
</script>
