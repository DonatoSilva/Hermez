---
interface Props {
    id: string;
    title: string;
    description?: string;
}

const { id, title, description } = Astro.props;
---

<dialog id={id}>
    <div
        class="modal-header flex justify-between items-center text-H-blue-900 text-2xl font-semibold mb-4"
    >
        <h3>{title}</h3>
        <button
            class="btnCloseModal font-normal flex items-center justify-center px-3 border-2 border-H-blue-900 rounded transition-all duration-300 hover:bg-H-blue-900 hover:text-white"
            >X</button
        >
    </div>
    {
        description ? (
            <p class="text-H-blue-900 text-sm mb-8">{description}</p>
        ) : (
            ""
        )
    }
    <slot />
</dialog>

<style>
    dialog {
        height: min-content;
        @apply rounded-md max-w-md w-full py-8 px-8;

        &::backdrop {
            background-color: @apply bg-H-blue-900;
            @apply backdrop-blur-sm mx-3;
        }
    }

    dialog[open] {
        animation: slideIn 0.3s ease-out;
    }

    dialog.closing {
        animation: slideOut 0.3s ease-out;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translate(0%, 100%);
        }
        to {
            opacity: 1;
            transform: translate(0%, 0);
        }
    }

    @keyframes slideOut {
        from {
            opacity: 1;
            transform: translate(0, 0);
        }

        to {
            opacity: 0;
            transform: translate(0%, -100%);
        }
    }
</style>
