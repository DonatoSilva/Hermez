<div class="w-full max-w-3xl m-auto">
  <div class="min-w-full flex flex-row justify-between">
    <h2 class="text-lg whitespace-pre text-H-blue-900 dark:text-white">Filtros</h2>

    <svg
      id="filter-icon"
      xmlns="http://www.w3.org/2000/svg"
      class="w-8 h-8 text-gray-700 dark:text-gray-200 cursor-pointer"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 10h12M9 15h6"></path>
    </svg>
  </div>
  <dialog
    id="filter-modal"
    class="m-auto w-full max-w-md rounded-lg bg-H-blue-100 dark:bg-H-black dark:text-H-blue-100 p-6 z-10 overflow-y-auto transition-all duration-200"
  >
    <div class="mx-auto w-full h-full flex flex-col gap-4">
      <div class="flex items-center justify-between">
        <h3 class="text-2xl font-semibold text-H-blue-900 dark:text-white">Filtros</h3>
        <button
          id="close-modal"
          class="cursor-pointer text-H-blue-900 dark:text-white hover:text-H-blue-700 dark:hover:text-H-blue-300 transition-colors"
          aria-label="Cerrar filtros"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <hr class="border-H-blue-500 dark:border-H-blue-700" />
      <article id="filter-status" class="p-4 rounded-md flex flex-col gap-2">
        <h3 class="font-semibold text-H-blue-900 dark:text-white">Estado</h3>
        <div class="flex flex-row gap-4 flex-wrap">
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="assigned" class="hidden" />
            <span class="dark:text-gray-300">Asignado</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="picked_up" class="hidden" />
            <span class="dark:text-white">Recogido</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="in_transit" class="hidden" />
            <span class="dark:text-white">En tránsito</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="delivered" class="hidden" />
            <span class="dark:text-white">Entregado</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="paid" class="hidden" />
            <span class="dark:text-white">Pagado</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="cancelled" class="hidden" />
            <span class="dark:text-white">Cancelado</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="status" value="all" class="hidden" checked />
            <span class="dark:text-white">Todos</span>
          </label>
        </div>
      </article>

      <hr class="border-H-blue-500 dark:border-H-blue-700" />
      <article id="filter-payment" class="p-4 rounded-md flex flex-col gap-2">
        <h3 class="font-semibold text-H-blue-900 dark:text-white">Tipo de pago</h3>
        <div class="flex flex-row gap-4 flex-wrap">
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="payment" value="nequi" class="hidden" />
            <span class="dark:text-white">Nequi</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="payment" value="efectivo" class="hidden" />
            <span class="dark:text-white">Efectivo</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="payment" value="" class="hidden" checked />
            <span class="dark:text-white">Todos</span>
          </label>
        </div>
      </article>
      <hr class="border-H-blue-500 dark:border-H-blue-700" />
      <article id="filter-month" class="p-4 rounded-md flex flex-col gap-2">
        <h3 class="font-semibold text-H-blue-900 dark:text-white">Mes</h3>
        <div class="flex flex-row gap-4 flex-wrap">
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="1" class="hidden" />
            <span class="dark:text-white">Enero</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="2" class="hidden" />
            <span class="dark:text-white">Febrero</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="3" class="hidden" />
            <span class="dark:text-white">Marzo</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="4" class="hidden" />
            <span class="dark:text-white">Abril</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="5" class="hidden" />
            <span class="dark:text-white">Mayo</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="6" class="hidden" />
            <span class="dark:text-white">Junio</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="7" class="hidden" />
            <span class="dark:text-white">Julio</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="8" class="hidden" />
            <span class="dark:text-white">Agosto</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="9" class="hidden" />
            <span class="dark:text-white">Septiembre</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="10" class="hidden" />
            <span class="dark:text-white">Octubre</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="11" class="hidden" />
            <span class="dark:text-white">Noviembre</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="12" class="hidden" />
            <span class="dark:text-white">Diciembre</span>
          </label>
          <label
            class="flex items-center gap-2 px-2 py-1 bg-gray-200 text-H-blue-900 font-semibold text-sm rounded-md cursor-pointer has-checked:bg-H-blue-700 has-checked:text-white dark:bg-gray-700 dark:text-gray-200 dark:has-checked:bg-H-blue-600"
          >
            <input type="radio" name="month" value="" class="hidden" checked />
            <span class="dark:text-white">Todos</span>
          </label>
        </div>
      </article>
      <div
        class="flex justify-end gap-4 mt-4 [&>button]:px-4 [&>button]:py-2 [&>button]:rounded-md [&>button]:cursor-pointer"
      >
        <button
          id="clear-filters"
          class="bg-gray-300 text-gray-800 dark:text-black hover:bg-gray-400 dark:hover:bg-H-gray-700 transition-colors duration-200"
          >Limpiar filtro</button
        >
        <button
          id="apply-filters"
          class="bg-H-blue-700 text-white dark:bg-H-blue-600 hover:bg-H-blue-600 dark:hover:bg-H-blue-500 transition-colors duration-200"
          >Aplicar filtro</button
        >
      </div>
    </div>
  </dialog>
</div>

<style>
  dialog::backdrop {
    backdrop-filter: blur(8px);
    background-color: rgba(0, 0, 0, 0.5);
    transition:
      backdrop-filter 0.3s ease-in-out,
      background-color 0.3s ease-in-out;
  }

  dialog[open]::backdrop {
    background-color: rgba(0, 0, 0, 0.8);
  }

  dialog {
    opacity: 0;
    transform: scale(0.95);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      display 0.3s ease allow-discrete;
  }

  dialog[open] {
    opacity: 1;
    transform: scale(1);

    @starting-style {
      opacity: 0;
      transform: scale(0.95);
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  const main = () => {
    const filterIcon = document.getElementById("filter-icon");
    const filterModal = document.getElementById("filter-modal") as HTMLDialogElement;
    const closeModalButton = document.getElementById("close-modal");
    const clearFiltersButton = document.getElementById("clear-filters");
    const applyFiltersButton = document.getElementById("apply-filters");

    // Función para leer los parámetros de la URL y marcar los inputs correspondientes
    const syncFiltersWithUrl = () => {
      const urlParams = new URLSearchParams(window.location.search);
      
      const status = urlParams.get('status');
      const payment = urlParams.get('payment_method');
      const month = urlParams.get('month');

      // Resetear todos los radios primero
      document.querySelectorAll('input[type="radio"]').forEach((input: any) => {
        if (input.value === 'all' || input.value === '') {
            input.checked = true;
        } else {
            input.checked = false;
        }
      });

      if (status) {
        const statusInput = document.querySelector(`input[name="status"][value="${status}"]`) as HTMLInputElement;
        if (statusInput) statusInput.checked = true;
      }

      if (payment) {
        const paymentInput = document.querySelector(`input[name="payment"][value="${payment}"]`) as HTMLInputElement;
        if (paymentInput) paymentInput.checked = true;
      }

      if (month) {
        const monthInput = document.querySelector(`input[name="month"][value="${month}"]`) as HTMLInputElement;
        if (monthInput) monthInput.checked = true;
      }
    };

    // Sincronizar al cargar
    syncFiltersWithUrl();

    filterIcon?.addEventListener("click", () => {
      if (filterModal) {
        syncFiltersWithUrl(); // Asegurarse de que esté sincronizado al abrir
        filterModal.showModal();
      }
    });

    clearFiltersButton?.addEventListener("click", () => {
      if (filterModal) {
        navigate(window.location.pathname);
        filterModal.close();
      }
    });

    closeModalButton?.addEventListener("click", () => {
      if (filterModal) {
        filterModal.close();
      }
    });

    applyFiltersButton?.addEventListener("click", () => {
      if (filterModal) {
        const selectedStatus = document.querySelector('input[name="status"]:checked') as HTMLInputElement;
        const selectedPayment = document.querySelector('input[name="payment"]:checked') as HTMLInputElement;
        const selectedMonth = document.querySelector('input[name="month"]:checked') as HTMLInputElement;

        const urlSearchParams = new URLSearchParams(window.location.search);

        // Status
        if (selectedStatus && selectedStatus.value !== 'all') {
          urlSearchParams.set('status', selectedStatus.value);
        } else {
          urlSearchParams.delete('status');
        }

        // Payment Method
        if (selectedPayment && selectedPayment.value !== '') {
          urlSearchParams.set('payment_method', selectedPayment.value);
        } else {
          urlSearchParams.delete('payment_method');
        }

        // Month
        if (selectedMonth && selectedMonth.value !== '') {
          urlSearchParams.set('month', selectedMonth.value);
        } else {
          urlSearchParams.delete('month');
        }

        const newUrl = `${window.location.pathname}?${urlSearchParams.toString()}`;
        navigate(newUrl);
        filterModal.close();
      }
    });
  };

  document.addEventListener("astro:page-load", main);
</script>
