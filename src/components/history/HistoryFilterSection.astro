---
interface Props {
  filterText: string;
}

const { filterText } = Astro.props;
---

<div class="w-full max-w-3xl mx-auto flex flex-row justify-between">
  <p class="text-lg whitespace-pre">{filterText}</p>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-8 h-8 text-gray-700 dark:text-gray-200 cursor-pointer"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M3 5h18M6 10h12M9 15h6"></path>
  </svg>
</div>