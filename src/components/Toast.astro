---
/**
 * Este componente representa una sección reutilizable de la interfaz de usuario.
 * Recibe propiedades para personalizar su contenido y estilo.
 * Utiliza el sistema de slots para permitir la inserción de contenido personalizado.
 * Es ideal para estructurar páginas y reutilizar bloques de presentación en la aplicación.
 */
---

<div
  id="notification-container"
  class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-2xl mx-auto px-4 sm:px-6 hidden opacity-0"
>
  <div
    class="notification-content bg-gradient-to-r from-blue-500 to-blue-600 text-white p-4 sm:p-6 rounded-xl shadow-lg border-l-4 border-blue-600"
  >
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4"
    >
      <div class="flex-shrink-0">
        <div
          class="w-12 h-12 sm:w-16 sm:h-16 bg-white/20 rounded-full flex items-center justify-center"
        >
          <span class="emoji text-2xl sm:text-3xl">ℹ️</span>
        </div>
      </div>
      <div class="flex-1">
        <h3 class="title font-bold text-lg sm:text-xl mb-1"></h3>
        <p class="message text-sm sm:text-base text-white/90"></p>
      </div>
      <button
        id="close-notification"
        class="flex-shrink-0 ml-auto sm:ml-0 text-white/80 hover:text-white transition-colors duration-200 p-1"
        aria-label="Cerrar notificación"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { toastStore, type ToastState } from "../stores/StoreToast";

  const colorSchemes = {
    error: {
      background: "bg-gradient-to-r from-red-500 to-red-600",
      border: "border-red-600",
      text: "text-white",
    },
    warning: {
      background: "bg-gradient-to-r from-orange-500 to-red-500",
      border: "border-orange-600",
      text: "text-white",
    },
    success: {
      background: "bg-gradient-to-r from-green-500 to-green-600",
      border: "border-green-600",
      text: "text-white",
    },
    info: {
      background: "bg-gradient-to-r from-blue-500 to-blue-600",
      border: "border-blue-600",
      text: "text-white",
    },
  };

  function initNotification() {
    const notificationContainer = document.getElementById(
      "notification-container"
    );
    const closeButton = document.getElementById("close-notification");
    const notificationContent = notificationContainer?.querySelector(
      ".notification-content"
    );
    const titleElement = notificationContainer?.querySelector(".title");
    const messageElement = notificationContainer?.querySelector(".message");
    const emojiElement = notificationContainer?.querySelector(".emoji");

    if (
      !notificationContainer ||
      !notificationContent ||
      !titleElement ||
      !messageElement ||
      !emojiElement
    )
      return;

    // Función para mostrar la notificación con animación
    function showNotification() {
      notificationContainer?.classList.remove("hidden");
      // Forzamos un reflow para que la animación funcione
      void notificationContainer?.offsetWidth;
      notificationContainer?.classList.remove("opacity-0");
      notificationContainer?.classList.add("opacity-100", "animate-slide-down");
    }

    // Función para ocultar la notificación con animación
    function hideNotification() {
      notificationContainer?.classList.remove("animate-slide-down");
      notificationContainer?.classList.add("animate-slide-up");

      setTimeout(() => {
        notificationContainer?.classList.add("opacity-0");
        notificationContainer?.classList.remove("opacity-100");

        setTimeout(() => {
          notificationContainer?.classList.add("hidden");
          notificationContainer?.classList.remove("animate-slide-up");
        }, 300);
      }, 0);
    }

    // Escuchar cambios en el store
    toastStore.subscribe((state: ToastState) => {
      if (state.visible) {
        // Actualizar contenido
        titleElement.textContent = state.title || "";
        messageElement.textContent = state.message;
        emojiElement.textContent = state.emoji || "ℹ️";

        // Actualizar estilo según el tipo
        const colors = colorSchemes[state.type];
        notificationContent.className = `notification-content ${colors.background} ${colors.text} p-4 sm:p-6 rounded-xl shadow-lg border-l-4 ${colors.border}`;

        showNotification();

        // Auto-cierre si está habilitado
        if (state.autoClose) {
          setTimeout(() => {
            toastStore.setKey("visible", false);
          }, state.autoCloseDelay);
        }
      } else {
        hideNotification();
      }
    });

    // Manejar el cierre manual
    closeButton?.addEventListener("click", () => {
      toastStore.setKey("visible", false);
    });
  }

  // Inicializar cuando la página carga
  document.addEventListener("astro:page-load", initNotification);
  document.addEventListener("DOMContentLoaded", initNotification);
</script>

<style>
  @keyframes slide-down {
    from {
      transform: translateX(0%) translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateX(0%) translateY(0);
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      transform: translateX(0%) translateY(0);
      opacity: 1;
    }
    to {
      transform: translateX(0%) translateY(-100%);
      opacity: 0;
    }
  }

  .animate-slide-down {
    animation: slide-down 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .animate-slide-up {
    animation: slide-up 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  }

  .opacity-0 {
    opacity: 0;
  }

  .opacity-100 {
    opacity: 1;
  }

  .hidden {
    display: none;
  }

  /* Transición suave para la opacidad */
  #notification-container {
    transition: opacity 0.3s ease-in-out;
  }
</style>
