---
import { UserButton } from "@clerk/astro/components";

interface Props {
    variant?: "client" | "domiciliary";
}

const { variant = "client" } = Astro.props;

// Configuración de colores y elementos por variante
const config = {
    client: {
        primary: "text-H-blue-900 hover:text-H-blue-700",
        secondary: "text-H-blue-700 hover:text-H-blue-500",
        accent: "bg-H-blue-500 hover:bg-H-blue-600 text-white",
        menuItems: [
            { label: "Inicio", href: "/?org=Client", icon: "🏠" },
            { label: "Mis Pedidos", href: "/orders?org=Client", icon: "📦" },
            { label: "Favoritos", href: "/favorites?org=Client", icon: "❤️" },
            { label: "Direcciones", href: "/addresses?org=Client", icon: "📍" },
        ],
    },
    domiciliary: {
        primary: "text-H-blue-900 hover:text-H-blue-700",
        secondary: "text-H-blue-700 hover:text-H-blue-500",
        accent: "bg-H-blue-900 hover:bg-H-blue-800 text-white",
        menuItems: [
            { label: "Inicio", href: "/?org=Domiciliary", icon: "🏠" },
            {
                label: "Mis Entregas",
                href: "/deliveries?org=Domiciliary",
                icon: "🚚",
            },
            {
                label: "Historial",
                href: "/history?org=Domiciliary",
                icon: "📋",
            },
            {
                label: "Configuración",
                href: "/settings?org=Domiciliary",
                icon: "⚙️",
            },
        ],
    },
};

const currentConfig = config[variant];
---

<div class="flex items-center justify-between w-full px-4 py-3">
    <!-- Navigation Links -->
    <div class="flex items-center space-x-8">
        {
            currentConfig.menuItems.map((item) => (
                <a
                    href={item.href}
                    class={`flex items-center space-x-2 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 ${currentConfig.primary}`}
                >
                    <span aria-hidden="true">{item.icon}</span>
                    <span>{item.label}</span>
                </a>
            ))
        }
    </div>

    <!-- User Actions -->
    <div class="flex items-center space-x-4">
        <!-- Notifications -->
        <button
            type="button"
            class={`p-2 rounded-full transition-colors duration-200 ${currentConfig.secondary}`}
            aria-label="Ver notificaciones"
        >
            <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"
                ></path>
            </svg>
        </button>

        <!-- User Button from Clerk -->
        <div class="flex items-center">
            <UserButton
                afterSignOutUrl={variant === "client"
                    ? "/sign-in/client"
                    : "/sign-in/domiciliary"}
                appearance={{
                    elements: {
                        avatarBox: "w-8 h-8",
                        userButtonPopoverCard:
                            "shadow-lg border border-gray-200",
                        userButtonPopoverActions: "flex flex-col",
                    },
                }}
            />
        </div>
    </div>
</div>
