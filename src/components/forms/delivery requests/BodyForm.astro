---
import Button from "@components/forms/elements/buttons/Button.astro";

/// pasos del formulario para probar
import InitDelivery from "./steps/InitDelivery.astro";
import SelectType from "./steps/DeliveryDetails.astro";
import Summary from "./steps/SummaryDelivery.astro";
---

<div id="container-title" class="min-w-full flex flex-row gap-4">
  <span class="px-4 py-2 flex-1 bg-H-blue-700 text-H-blue-100 rounded-md">
    Introduce la ruta:
  </span>
  <span
    id="progress"
    class="rounded-md px-4 py-2 bg-H-blue-100 text-H-blue-700 border border-H-blue-300 dark:border-0"
    >1/3</span
  >
</div>
<div id="container-steps" class="relative min-h-full flex flex-col gap-3">
  <section data-step="1"><InitDelivery /></section>
  <section data-step="2" hidden><SelectType /></section>
  <section data-step="3" hidden><Summary /></section>
</div>
<div
  id="container-button"
  class="sticky bottom-0 right-0 px-2 py-6 w-full backdrop-blur-xs flex gap-2"
>
  <Button id="btn-prev" variant="bordered" className="flex-1">Anterior</Button>
  <Button id="btn-next" className="flex-1">Siguiente</Button>
</div>

<script>
  import { currentStep, nextStep, prevStep, progressLabel } from "../../../stores/deliveryStepper";

  document.addEventListener("astro:page-load", () => {
    const steps = Array.from(document.querySelectorAll("[data-step]"));
    const progress = document.getElementById("progress");
    const show = (i: number) => {
      steps.forEach(
        (s: Element) => ((s as HTMLElement).hidden = (s as HTMLElement).dataset.step !== String(i))
      );
    };
    const validateStep = () => {
      const i = currentStep.get();
      const scope = steps[i - 1];
      const formEls = scope.querySelectorAll("input, select, textarea");

      for (const el of formEls) {
        const element = el as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (element.required && !element.checkValidity()) return false;
      }
      return true;
    };

    const unsubStep = currentStep.subscribe((i: number) => {
      show(i);
    });
    const unsubLabel = progressLabel.subscribe((t) => {
      if (progress) progress.textContent = t;
    });

    document.getElementById("btn-next")?.addEventListener("click", () => {
      if (!validateStep()) return;
      nextStep();
    });
    document.getElementById("btn-prev")?.addEventListener("click", () => {
      prevStep();
    });
    show(currentStep.get());

    if (progress) progress.textContent = progressLabel.get();
  });
</script>
