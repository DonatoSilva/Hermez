---
import Button from "@components/button/Button.astro";

/// pasos del formulario para probar
import InitDelivery from "./steps/InitDelivery.astro";
---

<div id="container-title" class="min-w-full flex flex-row gap-4">
  <span class="px-4 py-2 flex-1 bg-H-blue-700 text-H-blue-100 rounded-md">
    Introduce la ruta:
  </span>
  <span
    class="rounded-md px-4 py-2 bg-H-blue-100 text-H-blue-700 border border-H-blue-300 dark:border-0"
  >
    1/3
  </span>
</div>
<div id="container-steps" class="relative min-h-full flex flex-col gap-3">
  <InitDelivery />
</div>
<div id="container-button" class="sticky bottom-0 right-0 px-2 py-6 w-full backdrop-blur-xs">
  <Button className="w-full">Siguiente</Button>
</div>
