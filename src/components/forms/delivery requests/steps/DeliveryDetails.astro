---
import { typeVehicle } from "src/types/Vehicle/VehicleProps";
import VehicleItem from "../ui/VehicleItem.astro";
import ObservationsList from "../ui/ObservationsList";
import { actions } from "astro:actions";
import type { VehicleType } from "src/types/Vehicle/VehicleProps";
import type { DeliveryCategory } from "src/types/Delivery/DeliveryProps";
import SelectField from "@components/forms/elements/selects/SelectField.astro";

const { data: vehicleTypes, error: vehicleTypesError } = await Astro.callAction(
  actions.User.Vehicle.getVehicleTypes,
  new FormData()
);

const { data: deliveryTypes, error: deliveryTypesError } = await Astro.callAction(
  actions.Delivery.getDeliveryTypes,
  {}
);
---

<div class="space-y-6">
  <h4 class="text-lg font-semibold text-H-blue-900 dark:text-white">Tipo de domicilio</h4>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="col-span-auto md:col-span-1 flex flex-col gap-3">
      <p class="text-base">Seleccione el tipo de vehículo</p>
      <div class="flex items-center gap-3">
        {
          vehicleTypes?.map((type: VehicleType) => (
            <VehicleItem
              id={type.id}
              value={type.name}
              name="vehicle_type"
              imagen={
                type.image ??
                typeVehicle[type.name.toLowerCase() as keyof typeof typeVehicle]?.image
              }
              alt={`Imagen ilustrativa del ${type.name}`}
              label={type.name}
              onEvent={{ name: "vehicle_type", bubble: true }}
            />
          ))
        }
      </div>
    </div>

    <div class="col-span-auto md:col-span-1 flex flex-col gap-4">
      <p class="text-base">Seleccione el tipo de domicilio</p>
      <div class="flex flex-wrap items-center gap-3">
        {
          deliveryTypes?.map((type: DeliveryCategory) => (
            <span class="mb-3">
              <input
                type="radio"
                id={`category-${type.name.toLowerCase()}`}
                name="category"
                value={type.id}
                data-category={type.name}
                class="peer hidden"
              />
              <label
                for={`category-${type.name.toLowerCase()}`}
                class="font-medium text-gray-900 dark:text-gray-300 px-4 py-2 rounded-md peer-checked:bg-H-blue-700 peer-checked:text-white cursor-pointer bg-gray-200 hover:bg-H-blue-300 transition-colors hover:text-H-blue-900"
              >
                {type.name}
              </label>
            </span>
          ))
        }
      </div>

      <!-- Campos adicionales para peso y tamaño estimado -->
      <div class="mt-4 space-y-4">
        <div>
          <label
            for="estimatedWeight"
            class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
          >
            Peso estimado (kg) - Opcional
          </label>
          <input
            type="number"
            id="estimatedWeight"
            name="estimatedWeight"
            placeholder="Ej: 2.5"
            step="0.1"
            min="0"
            class="w-full border border-gray-300 rounded-md px-3 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
          />
        </div>
        <div>
          <label
            for="estimatedSize"
            class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
          >
            Tamaño estimado - Opcional
          </label>
          <SelectField
            id="estimatedSize"
            name="estimatedSize"
            placeholder="Selecciona un tamaño"
            data={{
              options: [
                { value: "Pequeño", label: "Pequeño" },
                { value: "Mediano", label: "Mediano" },
                { value: "Grande", label: "Grande" },
                { value: "Extra Grande", label: "Extra Grande" },
              ],
            }}
          />
        </div>
      </div>
    </div>
  </div>

  <ObservationsList client:visible />
</div>

<script>
  import { deliveryData } from "../../../../stores/deliveryStepper";

  document.addEventListener("astro:page-load", () => {
    // Selecciona el input radio de vehicleType con el valor por defecto
    const defaultVehicleInput = document.querySelector<HTMLInputElement>(
      `input[name="vehicle_type"]`
    );
    if (defaultVehicleInput) {
      defaultVehicleInput.checked = true;
      deliveryData.setKey("vehicle_type", {
        id: defaultVehicleInput.value,
        value: defaultVehicleInput.dataset.name || "",
      });
    }
    // Selecciona el input radio de deliveryType con el valor por defecto
    const defaultCategoryInputs =
      document.querySelectorAll<HTMLInputElement>(`input[name="category"]`);
    if (defaultCategoryInputs) {
      defaultCategoryInputs[0].checked = true;
      deliveryData.setKey("category", {
        id: defaultCategoryInputs[0].value,
        value: defaultCategoryInputs[0].dataset.category || "",
      });
    }

    // Cargar valores actuales del store
    const currentData = deliveryData.get();

    // Establecer estimatedWeight si existe
    const estimatedWeightInput = document.getElementById("estimatedWeight") as HTMLInputElement;
    if (estimatedWeightInput && currentData.estimated_weight !== null) {
      estimatedWeightInput.value = currentData.estimated_weight.toString();
    }

    // Establecer estimatedSize si existe
    const estimatedSizeSelect = document.getElementById("estimatedSize") as HTMLSelectElement;
    if (estimatedSizeSelect && currentData.estimated_size !== null) {
      estimatedSizeSelect.value = currentData.estimated_size;
    }

    const setVeh = (id: string, value: string) =>
      deliveryData.setKey("vehicle_type", {
        id,
        value,
      });

    document.addEventListener("vehicle_type", (e) => {
      const customEvent = e as CustomEvent;
      const { id, value } = customEvent.detail;

      if (id) {
        setVeh(id, value);
      }
    });

    const setCategory = (e: Event) => {
      const target = e.target as HTMLInputElement;
      const id = target.value;
      const value = target.dataset.category || "";

      deliveryData.setKey("category", { id, value });
    };

    defaultCategoryInputs.forEach((input) => {
      input.addEventListener("change", setCategory);
    });

    estimatedWeightInput?.addEventListener("input", (e) => {
      const value = (e.target as HTMLInputElement).value;
      deliveryData.setKey("estimated_weight", value ? parseFloat(value) : null);
    });

    estimatedSizeSelect?.addEventListener("change", (e) => {
      const customEvent = e as CustomEvent;
      const { value } = customEvent.detail;
      deliveryData.setKey("estimated_size", value || null);
    });
  });
</script>
