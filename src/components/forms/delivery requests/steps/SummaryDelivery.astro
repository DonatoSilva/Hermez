---
import SelectField from "@components/forms/elements/selects/SelectField.astro";
import InputField from "../../elements/inputs/InputField.astro";
import Button from "../../elements/buttons/Button.astro";
import FromToPoint from "../ui/FromToPoint.astro";
---

<div class="space-y-6">
  <h4 class="text-lg font-semibold text-H-blue-900 dark:text-white">Resumen</h4>

  <div class="flex gap-4 items-start justify-between">
    <FromToPoint />
    <div class="text-right flex flex-col gap-2">
      <div class="flex flex-col items-end gap-2">
        <p class="text-sm">Tipo de domicilio</p>
        <span
          id="sum-category"
          class="text-base max-w-fit font-bold rounded-full bg-H-blue-300 px-2 py-1"
          >Documentos</span
        >
      </div>
      <div class="flex flex-col items-end gap-2">
        <p class="text-sm">Vehículo</p>
        <span
          id="sum-veh"
          class="text-base max-w-fit font-bold rounded-full bg-H-blue-300 px-2 py-1"
          >Moto</span
        >
      </div>
      <div class="flex flex-col items-end gap-2">
        <p class="text-sm">Peso estimado</p>
        <span
          id="sum-estimated-weight"
          class="text-base max-w-fit font-bold rounded-full bg-H-blue-300 px-2 py-1"
          >-</span
        >
      </div>
      <div class="flex flex-col items-end gap-2">
        <p class="text-sm">Tamaño estimado</p>
        <span
          id="sum-estimated-size"
          class="text-base max-w-fit font-bold rounded-full bg-H-blue-300 px-2 py-1"
          >-</span
        >
      </div>
    </div>
  </div>

  <div class="">
    <p class="text-sm">Notas</p>
    <ul id="sum-notes" class="list-disc list-inside text-base"></ul>
  </div>

  <div class="">
    <SelectField
      id="sum-payment-field"
      name="paymentMethod"
      textLabel="Forma de pago"
      placeholder="Selecciona un método"
      helperText="Método de pago (efectivo/nequi)"
      data={{
        options: [
          { value: "efectivo", label: "Efectivo" },
          { value: "nequi", label: "Nequi" },
        ],
      }}
    />
  </div>

  <div class="bg-H-blue-700 text-white rounded-md px-4 py-3">
    <div id="price-container" class="flex items-center justify-between">
      <div>
        <p class="text-sm">Valor sugerido</p>
        <p id="sum-price" class="text-2xl font-bold">$ 4.000</p>
      </div>
      <Button id="btn-change-price" className="bg-H-blue-900">Cambiar</Button>
    </div>
    <div
      id="edit-price-container"
      class="hidden visible:flex items-center justify-between"
    >
      <div class="flex-1 pr-4">
        <InputField
          id="edit-price-input"
          name="editPrice"
          type="number"
          textLabel="Nuevo valor"
          placeholder="Ingresa un valor positivo"
          className="w-full bg-H-blue-100 text-H-blue-900"
          helperText=""
        />
      </div>
      <div class="flex gap-2">
        <Button id="btn-save-price" className="bg-H-blue-900">Guardar</Button>
        <Button id="btn-cancel-price" className="bg-gray-400 text-white"
          >Cancelar</Button
        >
      </div>
    </div>
  </div>
  <div
    id="sum-errors"
    class="mt-2 hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-3 py-2"
  >
  </div>
  <div class="pt-2">
    <Button id="btn-submit" className="w-full">Solicitar Servicio</Button>
  </div>
</div>

<script>
  import { statusModal } from "@stores/ModalStore";
import { toastStore } from "@stores/StoreToast";
import { navigate } from "astro/virtual-modules/transitions-router.js";
import { actions } from "astro:actions";
import {
deliveryData,
resetStepper,
} from "../../../../stores/deliveryStepper";

  document.addEventListener("astro:page-load", () => {
    /// elementos del resumen
    const originEl = document.getElementById("sum-origin");
    const destEl = document.getElementById("sum-destination");
    const categoryEl = document.getElementById("sum-category");
    const vehEl = document.getElementById("sum-veh");
    const payField = document.getElementById(
      "sum-payment-field"
    ) as HTMLElement | null;
    const priceEl = document.getElementById("sum-price");
    const editContainer = document.getElementById("edit-price-container");
    const editInput = document.getElementById(
      "edit-price-input"
    ) as HTMLInputElement | null;
    const editHelper = document.getElementById(
      "edit-price-input-helper"
    ) as HTMLSpanElement | null;
    const errorsBox = document.getElementById("sum-errors");
    const notesEl = document.getElementById("sum-notes");
    const estimatedWeightEl = document.getElementById("sum-estimated-weight");
    const estimatedSizeEl = document.getElementById("sum-estimated-size");

    /// botones de acción
    const btnSubmit = document.getElementById("btn-submit");
    const btnChangePrice = document.getElementById("btn-change-price");
    const btnSavePrice = document.getElementById("btn-save-price");
    const btnCancelPrice = document.getElementById("btn-cancel-price");

    const render = () => {
      const d = deliveryData.get();

      if (originEl) originEl.textContent = d.pickup_address || "-";
      if (destEl) destEl.textContent = d.delivery_address || "-";
      if (categoryEl) categoryEl.textContent = d.category.value || "-";
      if (vehEl) vehEl.textContent = d.vehicle_type.value || "-";
      if (estimatedWeightEl)
        estimatedWeightEl.textContent = `${d.estimated_weight} kg` || "-";
      if (estimatedSizeEl)
        estimatedSizeEl.textContent = d.estimated_size || "-";

      if (!d.estimated_weight) {
        estimatedWeightEl?.closest("div")?.classList.add("hidden");
      } else {
        estimatedWeightEl?.closest("div")?.classList.remove("visible");
      }

      if (!d.estimated_size) {
        estimatedSizeEl?.closest("div")?.classList.add("hidden");
      } else {
        estimatedSizeEl?.closest("div")?.classList.remove("visible");
      }

      if (priceEl) {
        (priceEl as HTMLParagraphElement).textContent =
          `$ ${d.client_price.toLocaleString("es-CO")}`;
      }

      if (notesEl) {
        notesEl.innerHTML = "";
        if ((d.observations || []).length === 0) {
          notesEl.innerHTML = `<li class="text-sm text-gray-500 italic">📝 Sin observaciones adicionales</li>`;
        } else {
          notesEl.innerHTML = (d.observations || [])
            .map(
              (obs) =>
                `<li class="text-gray-700 bg-gray-200 rounded-md px-3 py-2 mb-1">${obs}</li>`
            )
            .join("");
        }
      }
    };

    const unsub = deliveryData.subscribe(render);

    payField?.addEventListener("change", (e) => {
      const customEvent = e as CustomEvent;
      const paymentMethod = customEvent.detail as "efectivo" | "nequi";
      deliveryData.setKey("payment_method", paymentMethod);
    });

    btnChangePrice?.addEventListener("click", () => {
      const priceContainer = document.getElementById("price-container");
      const d = deliveryData.get();
      if (editContainer && priceContainer) {
        editContainer.classList.remove("hidden");
        priceContainer.classList.add("hidden");
        if (editInput) editInput.value = String(d.client_price);
        if (editHelper) {
          editHelper.textContent = "";
          editHelper.classList.remove("text-red-600");
          editHelper.classList.add("text-gray-500");
        }
      }
    });

    btnSavePrice?.addEventListener("click", () => {
      const v = editInput?.value || "";
      const priceContainer = document.getElementById("price-container");
      const n = Number(v);
      if (Number.isNaN(n) || n <= 0) {
        if (editHelper) {
          editHelper.textContent = "El valor debe ser un número positivo";
          editHelper.classList.remove("text-gray-500");
          editHelper.classList.add("text-red-600");
        }
        return;
      }
      deliveryData.setKey("client_price", n);

      if (editContainer && priceContainer) {
        editContainer.classList.add("hidden");
        priceContainer.classList.remove("hidden");
      }
    });

    btnCancelPrice?.addEventListener("click", () => {
      const priceContainer = document.getElementById("price-container");
      if (editContainer && priceContainer) {
        editContainer.classList.add("hidden");
        priceContainer.classList.remove("hidden");
      }
    });

    btnSubmit?.addEventListener("click", async () => {
      const d = deliveryData.get();
      const errors: string[] = [];

      if (!d.pickup_address) errors.push("Falta la dirección de origen");
      if (!d.delivery_address) errors.push("Falta la dirección de destino");
      if (!d.client_price || d.client_price <= 0)
        errors.push("El precio debe ser un número positivo");
      if (
        !d.payment_method ||
        !["efectivo", "nequi"].includes(d.payment_method)
      ) {
        errors.push("Selecciona un método de pago válido");
      }

      if (!d.vehicle_type.id) {
        errors.push("Selecciona un tipo de vehículo");
      }

      if (errors.length > 0) {
        if (errorsBox) {
          errorsBox.innerHTML = `<ul>${errors.map((m) => `<li>• ${m}</li>`).join("")}</ul>`;
          errorsBox.classList.remove("hidden");
        }
        return;
      }

      const dataQuote = {
        ...d,
        payment_method: d.payment_method as "efectivo" | "nequi",
        vehicle_type: d.vehicle_type.id,
        category: d.category.id as string,
      };

      if (errorsBox) errorsBox.classList.add("hidden");

      const { data, error } = await actions.Delivery.addQuote(dataQuote);

      if (error) {
        resetStepper();
        statusModal.setKey("new-delivery", {
          isOpen: false,
        });
        toastStore.set({
          visible: true,
          message: "Error al solicitar el servicio, por favor intenta de nuevo",
          type: "error",
          autoClose: true,
          autoCloseDelay: 3000,
        });

        return;
      }

      if (data) {
        resetStepper();
        statusModal.setKey("new-delivery", {
          isOpen: false,
        });
        toastStore.set({
          visible: true,
          message: "Solicitud de servicio enviada con éxito",
          type: "success",
          autoClose: true,
          autoCloseDelay: 3000,
        });

        navigate(`/solicitude/${data.id}`);

        return;
      }

      toastStore.set({
        visible: true,
        message: "No deberias ver este mensaje, por favor contacta con soporte",
        type: "error",
        autoClose: true,
        autoCloseDelay: 3000,
      });
    });
    render();
  });
</script>
