---
import Button from "../../elements/buttons/Button.astro";
import InputField from "../../elements/inputs/InputField.astro";
---

<div class="flex">
  <InputField
    type="text"
    placeholder="Desde..."
    name="origin"
    id="origin"
    required
    className="rounded-e-none"
    classLabel="flex-1"
  />
  <Button
    type="button"
    aria-label="Seleccionar origen en el mapa"
    className="min-h-full rounded-s-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-5 h-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
      ></path>
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
    </svg>
  </Button>
</div>
<div class="flex">
  <InputField
    type="text"
    placeholder="Hacia..."
    name="destination"
    id="destination"
    required
    classLabel="flex-1"
    className="rounded-e-none"
  />
  <Button
    type="button"
    aria-label="Seleccionar destino en el mapa"
    className="min-h-full rounded-s-none"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-5 h-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
      ></path>
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
    </svg>
  </Button>
</div>

<script>
  import { deliveryData } from "../../../../stores/deliveryStepper"
  const origin = document.getElementById('origin')
  const destination = document.getElementById('destination')
  origin?.addEventListener('input', (e) => { deliveryData.setKey('origin', e.target.value) })
  destination?.addEventListener('input', (e) => { deliveryData.setKey('destination', e.target.value) })
</script>

<div class="space-y-4">
  <!-- Selector de ubicaciones recientes -->
  <div class="space-y-3">
    <h4 class="text-lg font-semibold text-H-blue-900 dark:text-white"> Ubicaciones recientes </h4>

    <!-- Lista de ubicaciones -->
    <div class="space-y-2">
      <!-- Ubicación 1 -->
      <span
        class="w-full flex items-center gap-3 p-3 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 hover:border-H-blue-300 dark:hover:border-H-blue-500 transition-colors group cursor-pointer"
      >
        <div
          class="shrink-0 w-10 h-10 bg-H-blue-100 dark:bg-H-blue-900 rounded-full flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 text-H-blue-600 dark:text-H-blue-400"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
            ></path>
          </svg>
        </div>
        <div class="flex-1 text-left">
          <p
            class="font-medium text-gray-900 dark:text-white group-hover:text-H-blue-600 dark:group-hover:text-H-blue-400"
          >
            Casa
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400"> Calle 123 #45-67, Barrio Centro </p>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>2.1 km</span>
        </div>
      </span>

      <!-- Ubicación 2 -->
      <span
        class="w-full flex items-center gap-3 p-3 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 hover:border-H-blue-300 dark:hover:border-H-blue-500 transition-colors group cursor-pointer"
      >
        <div
          class="shrink-0 w-10 h-10 bg-orange-100 dark:bg-orange-900 rounded-full flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 text-orange-600 dark:text-orange-400"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
        </div>
        <div class="flex-1 text-left">
          <p
            class="font-medium text-gray-900 dark:text-white group-hover:text-H-blue-600 dark:group-hover:text-H-blue-400"
          >
            Oficina
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400"> Carrera 89 #12-34, Zona Rosa </p>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>5.7 km</span>
        </div>
      </span>

      <!-- Ubicación 3 -->
      <span
        class="w-full flex items-center gap-3 p-3 bg-white dark:bg-gray-700 rounded-lg border border-gray-200 dark:border-gray-600 hover:border-H-blue-300 dark:hover:border-H-blue-500 transition-colors group cursor-pointer"
      >
        <div
          class="shrink-0 w-10 h-10 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 text-green-600 dark:text-green-400"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
            <path
              d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
            ></path>
          </svg>
        </div>
        <div class="flex-1 text-left">
          <p
            class="font-medium text-gray-900 dark:text-white group-hover:text-H-blue-600 dark:group-hover:text-H-blue-400"
          >
            Universidad
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400"> Avenida 45 #78-90, Campus Norte </p>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <span>3.2 km</span>
        </div>
      </span>
    </div>

    <!-- Opción para agregar nueva ubicación -->
    <Button
      id="btnAddLocation"
      variant="bordered"
      className="w-full flex items-center justify-center gap-2 p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg hover:border-H-blue-400 dark:hover:border-H-blue-500 transition-colors group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 text-gray-400 group-hover:text-H-blue-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <span
        class="text-gray-600 dark:text-gray-400 group-hover:text-H-blue-600 dark:group-hover:text-H-blue-400 font-medium"
      >
        Agregar nueva ubicación
      </span>
    </Button>
  </div>
</div>
