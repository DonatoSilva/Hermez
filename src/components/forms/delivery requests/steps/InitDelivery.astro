---
import Button from "../../elements/buttons/Button.astro";
import InputField from "../../elements/inputs/InputField.astro";
import LocationItem from "../ui/LocationItem.astro";
---

<div class="flex flex-col gap-8">
  <div class="min-w-full flex flex-col md:flex-row gap-4">
    <div class="flex flex-col w-full gap-4">
      <div class="flex w-full">
        <InputField
          type="text"
          placeholder="Desde..."
          name="origin"
          id="origin"
          required
          className="rounded-e-none"
          classLabel="[&>span]:hidden"
          helperText="La dirección de origen es obligatoria"
        />
        <Button
          type="button"
          aria-label="Seleccionar origen en el mapa"
          className="min-h-full rounded-s-none border border-inherit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </Button>
      </div>
      <div class="flex w-full">
        <InputField
          as="textarea"
          rows={2}
          placeholder="Descripción del origen (opcional)"
          name="originDescription"
          id="originDescription"
          classLabel="[&>span]:hidden"
        />
      </div>
    </div>
    <div class="flex flex-col w-full gap-4">
      <div class="flex w-full">
        <InputField
          type="text"
          placeholder="Hacia..."
          name="destination"
          id="destination"
          required
          className="rounded-e-none"
          classLabel="[&>span]:hidden"
          helperText=""
        />
        <Button
          type="button"
          aria-label="Seleccionar destino en el mapa"
          className="min-h-full rounded-s-none border border-inherit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </Button>
      </div>
      <div class="flex w-full">
        <InputField
          as="textarea"
          rows={2}
          placeholder="Descripción del destino (opcional)"
          name="destinationDescription"
          id="destinationDescription"
          classLabel="[&>span]:hidden"
        />
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    <div class="space-y-3">
      <h4 class="text-lg font-semibold text-H-blue-900 dark:text-white">Tus ubicaciones </h4>
      <div class="space-y-2 grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Ubicación 1 -->
        <LocationItem
          id="location1"
          name="Casa"
          address="Calle 123 #45-67, Barrio Centro"
          distance="2.1 km"
          type="casa"
          onEvent={{ name: "selectLocation", bubble: true }}
        />

        <!-- Ubicación 2 -->
        <LocationItem
          id="location2"
          name="Oficina"
          address="Carrera 89 #12-34, Zona Rosa"
          distance="5.7 km"
          type="trabajo"
          onEvent={{ name: "selectLocation", bubble: true }}
        />

        <!-- Ubicación 3 -->
        <LocationItem
          id="location3"
          name="Universidad"
          address="Avenida 45 #78-90, Campus Norte"
          distance="3.2 km"
          type="edificio"
          onEvent={{ name: "selectLocation", bubble: true }}
        />
      </div>

      <!-- Opción para agregar nueva ubicación -->
      <Button
        id="btnAddLocation"
        variant="bordered"
        className="w-full flex items-center justify-center gap-2 p-3 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg hover:border-H-blue-400 dark:hover:border-H-blue-500 transition-colors group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 text-gray-400 group-hover:text-H-blue-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <span
          class="text-gray-600 dark:text-gray-400 group-hover:text-H-blue-600 dark:group-hover:text-H-blue-400 font-medium"
        >
          Agregar nueva ubicación
        </span>
      </Button>
    </div>
  </div>
</div>

<script>
  import { deliveryData } from "../../../../stores/deliveryStepper";

  document.addEventListener("astro:page-load", () => {
    const origin = document.getElementById("origin");
    const destination = document.getElementById("destination");
    const originHelper = document.getElementById("origin-helper") as HTMLSpanElement | null;
    const destinationHelper = document.getElementById(
      "destination-helper"
    ) as HTMLSpanElement | null;

    let originItem: HTMLElement | undefined;
    let destinationItem: HTMLElement | undefined;
    const selectedItems = new Set<HTMLElement>();

    document.addEventListener("selectLocation", (e) => {
      const target = e.target as HTMLElement | null;
      const ce = e as CustomEvent;

      const addressId = ce.detail?.addressId;
      if (!target || !addressId) return;

      const isSelected =
        target.classList.contains("bg-gray-800") || target.classList.contains("dark:bg-gray-900");

      if (isSelected) {
        target.classList.remove("bg-gray-800", "dark:bg-gray-900", "text-white");
        selectedItems.delete(target);

        if (originItem === target) {
          originItem = undefined;
          if (origin) {
            (origin as HTMLInputElement).value = "";
            deliveryData.setKey("origin", "");
          }

          return;
        }

        if (destinationItem === target) {
          destinationItem = undefined;
          if (destination) {
            (destination as HTMLInputElement).value = "";
            deliveryData.setKey("destination", "");
          }

          return;
        }

        return;
      }

      if (selectedItems.size >= 2) return;

      selectedItems.add(target);
      target.classList.add("bg-gray-800", "dark:bg-gray-900", "text-white");

      if (origin && (origin as HTMLInputElement).value === "") {
        const address = target.querySelector(".address")?.textContent.trim() || "";
        (origin as HTMLInputElement).value = address;
        originItem = target;
        deliveryData.setKey("origin", address);
        if (address) clearError(origin as HTMLInputElement, originHelper);

        return;
      }

      if (destination && (destination as HTMLInputElement).value === "") {
        const address = target.querySelector(".address")?.textContent.trim() || "";
        (destination as HTMLInputElement).value = address;
        destinationItem = target;
        deliveryData.setKey("destination", address);
        if (address) clearError(destination as HTMLInputElement, destinationHelper);

        return;
      }
    });

    const removeSelectedItem = (item: HTMLElement) => {
      item.classList.remove("bg-gray-800", "dark:bg-gray-900", "text-white");
      selectedItems.delete(item);
    };

    origin?.addEventListener("input", (e) => {
      const value = (e.target as HTMLInputElement).value.trim();
      deliveryData.setKey("origin", value);

      const originAddress = originItem?.textContent?.trim() || "";
      if ((value === "" || value !== originAddress) && originItem) {
        removeSelectedItem(originItem);
        originItem = undefined;
      }

      if (!value)
        setError(origin as HTMLInputElement, originHelper, "Por favor completa este campo");
      else clearError(origin as HTMLInputElement, originHelper);
    });

    destination?.addEventListener("input", (e) => {
      const value = (e.target as HTMLInputElement).value.trim();
      deliveryData.setKey("destination", value);

      const destinationAddress = destinationItem?.textContent.trim() || "";
      if ((value === "" || value !== destinationAddress) && destinationItem) {
        removeSelectedItem(destinationItem);
        destinationItem = undefined;
      }

      if (!value)
        setError(
          destination as HTMLInputElement,
          destinationHelper,
          "Por favor completa este campo"
        );
      else clearError(destination as HTMLInputElement, destinationHelper);
    });

    const setError = (input: HTMLInputElement, helper: HTMLSpanElement | null, message: string) => {
      input.classList.add("border-red-500");
      if (helper) {
        helper.textContent = message;
        helper.classList.remove("text-gray-500");
        helper.classList.add("text-red-500");
      }
    };

    const clearError = (input: HTMLInputElement, helper: HTMLSpanElement | null) => {
      input.classList.remove("border-red-500");
      if (helper) {
        helper.textContent = "";
        helper.classList.remove("text-red-500");
        helper.classList.add("text-gray-500");
      }
    };
  });
</script>
