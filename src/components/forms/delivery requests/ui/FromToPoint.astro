---
import { Icon } from "astro-icon/components";

interface FromToPointProps {
  pickupAddress: string;
  deliveryAddress: string;
}

const { pickupAddress, deliveryAddress } = Astro.props as FromToPointProps;

console.log(pickupAddress, deliveryAddress);
---

<div class="flex flex-col gap-4">
  <div class="flex items-center justify-start gap-2">
    <Icon name="solar:map-point-bold-duotone" size={35} />
    <div>
      <p class="text-sm text-gray-600">De</p>
      <p id="sum-origin" class="text-base font-bold">
        {pickupAddress}
      </p>
    </div>
  </div>
  <div class="flex items-center justify-start gap-2">
    <Icon name="solar:map-point-bold" size={35} />
    <div>
      <p class="text-sm text-gray-600">A</p>
      <p id="sum-destination" class="text-base font-bold">
        {deliveryAddress}
      </p>
    </div>
  </div>
</div>
