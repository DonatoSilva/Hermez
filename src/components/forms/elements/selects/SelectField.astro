---
/**
 * @component SelectField
 * @description Un componente de campo de selección personalizable y avanzado para Astro.
 *
 * @prop {string} [id] - El ID del campo de selección.
 * @prop {string} [textLabel] - El texto de la etiqueta para el campo de selección.
 * @prop {string} [name] - El nombre del campo de selección, usado para formularios.
 * @prop {string} [value] - El valor inicial del campo de selección.
 * @prop {string} [placeholder] - El texto del placeholder para el campo de selección.
 * @prop {boolean} [required=false] - Si el campo es obligatorio.
 * @prop {boolean} [disabled=false] - Si el campo está deshabilitado.
 * @prop {boolean} [readonly=false] - Si el campo es de solo lectura.
 * @prop {string} [helperText] - Texto de ayuda que se muestra debajo del campo.
 * @prop {string} [idContainer] - El ID del contenedor para el cálculo del desbordamiento.
 * @prop {StylingProps} [styling] - Un objeto para personalizar las clases de los elementos del componente.
 * @prop {DataProps} [data] - Un objeto para proporcionar las opciones y grupos de opciones.
 *
 * @prop {object} [styling] - Objeto para personalizar las clases CSS de cada parte del componente.
 * @prop {string} [styling.container] - Clases para el contenedor principal.
 * @prop {string} [styling.label] - Clases para la etiqueta de texto.
 * @prop {string} [styling.select] - Clases para el campo de selección visible.
 * @prop {string} [styling.arrow] - Clases para el icono de la flecha.
 * @prop {string} [styling.optionsContainer] - Clases para el contenedor de opciones.
 * @prop {string} [styling.option] - Clases para cada opción individual.
 * @prop {string} [styling.groupLabel] - Clases para la etiqueta de un grupo de opciones.
 * @prop {string} [styling.helperText] - Clases para el texto de ayuda.
 *
 * @prop {object} [data] - Objeto para los datos del campo de selección.
 * @prop {OptionItem[]} [data.options] - Un array de opciones.
 * @prop {OptionGroup[]} [data.groups] - Un array de grupos de opciones.
 *
 * @slot no-options - Contenido que se muestra cuando no hay opciones disponibles.
 *
 * @example
 * <!-- Uso Básico -->
 * <SelectField
 *   name="fruta"
 *   textLabel="Selecciona una fruta"
 *   placeholder="Elige una opción"
 *   data={{
 *     options: [
 *       { value: 'manzana', label: 'Manzana' },
 *       { value: 'banana', label: 'Banana' }
 *     ]
 *   }}
 * />
 *
 * @example
 * <!-- Con Grupos y Personalización de Estilos -->
 * <SelectField
 *   name="vehiculo"
 *   textLabel="Selecciona un vehículo"
 *   placeholder="Elige un vehículo"
 *   styling={{
 *     container: 'w-full',
 *     select: 'bg-gray-100',
 *     option: 'hover:bg-blue-100'
 *   }}
 *   data={{
 *     groups: [
 *       {
 *         label: 'Coches',
 *         options: [
 *           { value: 'sedan', label: 'Sedán' },
 *           { value: 'suv', label: 'SUV' }
 *         ]
 *       },
 *       {
 *         label: 'Motos',
 *         options: [
 *           { value: 'deportiva', label: 'Deportiva' },
 *           { value: 'crucero', label: 'Crucero' }
 *         ]
 *       }
 *     ]
 *   }}
 * />
 *
 * @example
 * <!-- Con Slot para Mensaje sin Opciones -->
 * <SelectField name="vacio" textLabel="Campo sin opciones">
 *   <div slot="no-options" class="text-center p-4">
 *     No hay nada que seleccionar aquí.
 *   </div>
 * </SelectField>
 */
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type Icon = AstroComponentFactory;

type OptionItem = {
  value: string | number;
  label: string;
  disabled?: boolean;
  icon?: Icon;
};

type OptionGroup = {
  label: string;
  options: OptionItem[];
};

interface StylingProps {
  container?: string;
  label?: string;
  select?: string;
  placeholder?: string;
  arrow?: string;
  optionsContainer?: string;
  option?: string;
  groupLabel?: string;
  helperText?: string;
}

interface DataProps {
  options?: OptionItem[];
  groups?: OptionGroup[];
}

interface SelectFieldProps {
  id?: string;
  textLabel?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  helperText?: string;
  multiple?: boolean;
  idContainer?: string;
  styling?: StylingProps;
  data?: DataProps;
}

const {
  id = "",
  textLabel = "",
  name = "",
  value = "",
  placeholder = "",
  required = false,
  disabled = false,
  readonly = false,
  helperText = "",
  idContainer,
  styling = {},
  data = {},
} = Astro.props as SelectFieldProps;

const {
  container: className = "",
  label: classLabel = "",
  select: classSelect = "",
  arrow: classArrow = "",
  optionsContainer: classOptionsContainer = "",
  option: classOption = "",
  groupLabel: classGroupLabel = "",
  helperText: classHelperText = "",
} = styling;

const { options = [], groups = [] } = data;

if (options.length !== 0) {
  options.unshift({
    value: "",
    label: placeholder,
  });
}
---

<select-field
  id={id}
  class={`relative flex flex-col gap-2 ${className}`}
  data-id-container={idContainer}
  data-value={value}
>
  {
    textLabel && (
      <span class={`text-sm ${classLabel}`}>
        {textLabel}
        {required && <span class="text-red-500 ml-1">*</span>}
      </span>
    )
  }
  <input type="hidden" name={name} value={value} required={required} />

  <div
    id="select"
    class={`relative border border-gray-300 rounded-md px-3 py-2 ${classSelect} disabled:bg-gray-100 disabled:cursor-not-allowed disabled:text-gray-400`}
    aria-disabled={disabled}
    aria-readonly={readonly}
    tabindex={disabled || readonly ? "-1" : "0"}
  >
    <span data-placeholder>{placeholder}</span>
    <span class={`absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 ${classArrow}`}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6 9l6 6 6-6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
  <div
    id="options"
    class={`absolute open-down left-0 bg-white border border-gray-300 rounded-md shadow-lg z-10 w-full overflow-hidden ${classOptionsContainer}`}
    role="listbox"
  >
    {
      groups.length > 0 ? (
        groups.map((group) => (
          <div>
            <div class={`px-3 py-2 text-sm font-bold ${classGroupLabel}`}>{group.label}</div>
            {group.options.map((option, index) => (
              <div
                id={`${id || name}-option-${index}`}
                class={`px-3 py-2 cursor-pointer hover:bg-gray-100 flex items-center gap-2 ${
                  option.disabled ? "text-gray-400" : "text-black"
                } ${!option.value ? "selected" : ""} ${classOption}`}
                data-disabled={option.disabled}
              >
                {option.icon && <option.icon />}
                <span data-value={option.value}>{option.label}</span>
              </div>
            ))}
          </div>
        ))
      ) : options.length > 0 ? (
        options.map((option, index) => (
          <div
            id={`${id || name}-option-${index}`}
            class={`px-3 py-2 cursor-pointer hover:bg-gray-100 flex items-center gap-2  ${
              option.disabled ? "text-gray-400" : "text-black"
            } ${!option.value ? "selected" : ""} ${classOption}`}
            data-disabled={option.disabled}
          >
            {option.icon && <option.icon />}
            <span data-value={option.value}>{option.label}</span>
          </div>
        ))
      ) : (
        <slot name="no-options">
          <div class="px-3 py-2 text-gray-500">no hay opciones</div>
        </slot>
      )
    }
  </div>
  {
    helperText != null && (
      <span class={`text-sm text-gray-500 ${classHelperText}`}>{helperText}</span>
    )
  }
</select-field>

<style>
  [data-disabled] {
    cursor: not-allowed;
  }
  #options {
    max-width: inherit;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    pointer-events: none;
    transition:
      opacity 0.3s,
      transform 0.3s;

    &.open-down {
      top: 100%;
      bottom: auto;
      transform: translateY(-10);
      pointer-events: auto;
    }
    &.open-up {
      top: auto;
      bottom: 100%;
      margin-bottom: -1rem;
      transform: translateY(-10px);
      pointer-events: none;
    }
    &.show {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
  .selected {
    background: #e0e7ff;
    font-weight: bold;
  }
  svg {
    transition: transform 0.3s;
  }
  .rotate {
    transform: rotate(180deg);
  }
</style>

<script>
  class SelectField extends HTMLElement {
    idContainer = this.dataset.idContainer || "";
    menuVisible = false;

    select = this.querySelector("#select");
    optionsMenu = this.querySelector("#options") as HTMLElement;
    inputHidden = this.querySelector('input[type="hidden"]') as HTMLInputElement;
    placeholderSpan = this.querySelector("[data-placeholder]");
    arrow = this.querySelector("svg");
    value = this.dataset.value;

    constructor() {
      super();
      this.selectOption(this.value);
    }

    selectOption = (value: string = "") => {
      const optSelected = this.optionsMenu.querySelector(".selected");
      optSelected?.classList.remove("selected");

      const spanValue = this.querySelector(`[data-value="${value}"]`);

      if (this.placeholderSpan) this.placeholderSpan.textContent = spanValue?.textContent || "";

      const divValue = spanValue?.closest("div");
      divValue?.classList.add("selected");

      this.dispatchEvent(new CustomEvent("change", { detail: value }));
    };

    connectedCallback() {
      this.inputHidden.addEventListener("input", (e) => {
        this.selectOption((e.target as HTMLInputElement).value);
      });

      // Manejar reset del formulario para actualizar la parte visual
      const form = document
        .getElementById(`view-${this.idContainer}`)
        ?.getElementsByTagName("form")[0];
      form?.addEventListener("reset", () => {
        if (this.placeholderSpan)
          this.placeholderSpan.textContent =
            this.querySelector(`[data-value=""]`)?.textContent || "";

        this.selectOption("");
      });

      // Mostrar/ocultar menú y animar flecha
      this.select?.addEventListener("click", (e) => {
        const targetID = ((e.target as HTMLElement)?.id as string) ?? "";

        if (targetID === "options") return;

        // 1. Calcular dimensiones
        const selectRect = this.select?.getBoundingClientRect(); // Posición y tamaño del campo de selección
        const viewportHeight =
          document.getElementById(`view-${this.idContainer}`)?.clientHeight || window.innerHeight; // Altura de la ventana

        if (!this.optionsMenu) return;
        const optionsMenuHeight = this.optionsMenu.scrollHeight; // Altura real del menú si se mostrara completo

        const spaceBelow = viewportHeight - (selectRect?.bottom || 0);
        const spaceAbove = selectRect?.top || 0;

        // 2. Determinar si hay desbordamiento y cómo ajustarlo
        if (spaceBelow < optionsMenuHeight && spaceAbove > optionsMenuHeight) {
          // Abrir hacia arriba
          this.optionsMenu.classList.add("open-up"); // Añadir una clase para posicionar hacia arriba
          this.optionsMenu.classList.remove("open-down"); // Asegurarse de que no tenga la clase de abrir hacia abajo
        } else if (spaceBelow < optionsMenuHeight && spaceAbove < optionsMenuHeight) {
          // No hay espacio suficiente ni arriba ni abajo, hacerlo scrollable
          this.optionsMenu.style.maxHeight = Math.max(spaceBelow, spaceAbove) + "px"; // Usar el mayor espacio disponible
          this.optionsMenu.style.overflowY = "auto";
          this.optionsMenu.classList.remove("open-up");
          this.optionsMenu.classList.add("open-down"); // Por defecto, abrir hacia abajo si no hay espacio arriba
        } else {
          // Suficiente espacio abajo, abrir normalmente
          this.optionsMenu.classList.remove("open-up");
          this.optionsMenu.classList.add("open-down");
          this.optionsMenu.style.maxHeight = ""; // Limpiar max-height si se había establecido
          this.optionsMenu.style.overflowY = ""; // Limpiar overflow-y
        }

        this.menuVisible = !this.menuVisible;
        this.optionsMenu?.classList.toggle("show", this.menuVisible);
        this.arrow?.classList.toggle("rotate", this.menuVisible);
      });

      // Selección de opción
      this.optionsMenu?.addEventListener("click", (e) => {
        let target = e.target as HTMLElement;

        if (!this.menuVisible) return;

        if (target.tagName === "SPAN") {
          target = target.closest("div") as HTMLElement;
        }

        this.menuVisible = false;
        this.optionsMenu?.classList.toggle("show");
        this.arrow?.classList.toggle("rotate");

        if (target && !target.hasAttribute("data-disabled")) {
          const value = target.getElementsByTagName("span")[0]?.getAttribute("data-value") ?? "";
          this.inputHidden.value = value;
          this.selectOption(value);
        }
      });
    }
  }
  customElements.define("select-field", SelectField);
</script>
