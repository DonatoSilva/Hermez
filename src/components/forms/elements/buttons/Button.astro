---
type ButtonType = "submit" | "reset" | "button";
interface ButtonProps {
  id?: string;
  type?: ButtonType;
  href?: string;
  className?: string;
  color?: string; // backward compatibility
  disabled?: boolean;
  variant?: "text" | "bordered" | "default" | "danger";
}

const {
  id = "",
  type = "button",
  className = "",
  href,
  color,
  disabled = false,
  variant = "default",
} = Astro.props as ButtonProps;

const variants: Record<string, string> = {
  text: "bg-transparent text-H-blue-900 hover:text-H-blue-700",
  bordered:
    "bg-transparent text-H-blue-700 border border-H-blue-300 hover:border-H-blue-500 hover:text-H-blue-900",
  default: "bg-H-blue-700 text-H-blue-100 hover:bg-H-blue-900",
  danger: "bg-red-600 text-white hover:bg-red-700",
};

const base =
  "flex flex-row items-center justify-center gap-2.5 px-4 py-2 rounded-md transition-colors cursor-pointer";

const colorClasses = color ?? variants[variant];
---

{
  href ? (
    <a
      {...(id && { id })}
      class={`${base} ${colorClasses} ${className}`}
      aria-disabled={disabled}
      class={`${base} ${colorClasses} ${className} ${disabled ? "pointer-events-none opacity-50" : ""}`}
      href={href}
    >
      <slot />
    </a>
  ) : (
    <button
      {...(id && { id })}
      type={type}
      class={`${base} ${colorClasses} ${className}`}
      disabled={disabled}
    >
      <slot />
    </button>
  )
}
