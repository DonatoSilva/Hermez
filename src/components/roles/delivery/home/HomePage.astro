
---
import Button from "@components/forms/elements/buttons/Button.astro";
import InputField from "@components/forms/elements/inputs/InputField.astro";

import Banner from "@components/banner/Banner.astro";
import Modal from "@components/modals/Modal";
import { Icon } from "astro-icon/components";
import Image from "astro/components/Image.astro";
import personaAburrida from "public/images/persona-aburrida.png";
import sillaCasco from "public/images/silla-y-casco.png";
import { QuoteContent } from "../deliveryQuote/QuoteContent";
import { PersonStats } from "../PersonStats";
import { ActiveDeliveriesWrapper } from "../activeDeliveries/ActiveDeliveriesWrapper";



const frasesVacios = [
  "Rayos, ¡tenemos una mala racha! De seguro en unos minutos explota el chat.",
  "Nada como un café mientras el celular se cobija… ¡y el primer pedido llega!",
  "¿Escuchaste eso? Es el sonido de la calma antes de la vorágine de pedidos.",
  "Relax, hasta los superhéroes necesitan pausa; tu mochila ya huele a gloria.",
  "Consejo ninja: aprovecha para estirar piernas; luego correrás como Flash.",
  "¿Sabías que respirar hondo 3 veces aumenta el 73 % la probabilidad de propina? (dato no científico).",
  "Tu moto te mira y dice: ‘¿Nos tomamos una selfie de descanso?’",
  "Recuerda: cada minuto sin pedido es un minuto sin tráfico. ¡Silver linings!",
  "Chiste rápido: — ¿Cuál es el colmo de un domiciliario? — Quedarse ‘sin entrega’ de batería.",
  "Consejo de oro: revisa llantas, cierra casco y pide tu propio café; el siguiente aviso será para ti.",
  "Si los pedidos fueran Pokémon, ya habrías atrapado… ¡el silencio! Pero viene un Legendario.",
  "¿Escuchas campanas? No, no es Navidad; es tu celular sonando en 3, 2, 1…",
  "Frase motivacional: ‘No hay día malo, solo día sin propina… aún.’",
  "Mini-trivia: El domicilio más rápido del mundo tardó 3 minutos. Tu récord está por romperse.",
  "Consejo foodie: mientras esperas, piensa en la hamburguesa que te comprarás con la próxima propina.",
  "¿El cielo está nublado? Perfecto: menos sol, más pedidos cuando la gente no quiere salir.",
  "Tu mochila ahora pesa -5 kg de esperanza; en 5 minutos llevará 5 kg de comida.",
  "Chiste de moto: —¿Cuál es tu película favorita? —‘En busca del pedido perdido’.",
  "Dato curioso: cada segundo que pasa alguien más cerca pide comida. Spoiler: eres tú quien la lleva.",
  "Recordatorio: sonríele al GPS; así cuando suene lo encuentras más rápido.",
];

const imgs = [personaAburrida, sillaCasco];

const fraseVacio =
  frasesVacios[Math.floor(Math.random() * frasesVacios.length)];
const img = imgs[Math.floor(Math.random() * imgs.length)];

const token =
  (await Astro.locals.auth().getToken({ template: "jwt-back-hermez" })) || "";

const protocol = Astro.request.headers.get("protocol") || "http";
const host = Astro.request.headers.get("host") || "localhost:4321";

const { current_vehicle, userid, is_available } = Astro.locals.dataUser!
---

<section>
  <div
    class="container relative h-full min-h-full flex flex-col justify-center mx-auto gap-4"
  >
    <div
      class="flex flex-col md:flex-row md:justify-between gap-4 md:gap-8 p-2 bg-H-blue-300 rounded-md"
    >
      <div class="flex flex-row justify-between p-4 w-full md:max-w-md">
        <div class="flex flex-col justify-start items-start w-full">
          <span class="text-H-blue-900 font-bold">Estado:</span>
          <span id="availabilityStatus" data-is-available={is_available} class="text-H-blue-700">{is_available ? "Disponible" : "Ocupado"}</span>
        </div>
        <Button id="changeAvailability" variant={"default"}
          >Cambiar<Icon
            name="solar:alt-arrow-right-bold-duotone"
            width={24}  
            height={24}
          /></Button
        >
      </div>
      <PersonStats personId={userid} token={token} client:visible />
    </div>
    {
      current_vehicle ? (
      <ActiveDeliveriesWrapper token={token} userId={userid} protocol={protocol} host={host} client:load>
        <QuoteContent token={!token ? undefined : token} client:load protocol={protocol} host={host}>
          <Banner title="No hay pedidos disponibles" className="min-w-full gap-4">
            <p
              slot="optional-content"
              class="text-H-blue-100 text-balance text-base font-normal max-w-prose z-10"
            >
              {fraseVacio}
            </p>
            <Image
              src={img}
              slot="image"
              class="min-w-26 w-full max-w-48 h-full object-cover z-0 transition-all md:max-w-62 blur-xs md:blur-none"
              alt="Imagen decorativa para cuando no hay pedidos"
              sizes="250px"
              format="webp"
            />
          </Banner>
        </QuoteContent>
      </ActiveDeliveriesWrapper>
    ) : (
      <Banner title="No tienes un vehículo activo" className="min-w-full gap-4">
        <p
          slot="optional-content"
          class="text-H-blue-100 text-balance text-base font-normal max-w-prose z-10"
        >
          Para empezar a recibir pedidos, registra o activa un vehículo desde tu perfil.
        </p>
        <Button href="/settings?section=vehicles" slot="button" variant={"default"} className="max-w-fit" color="text-H-blue-100 border border-H-blue-100 border-dashed">Registra un vehículo</Button>
        <Image
          src={sillaCasco}
          slot="image"
          class="min-w-26 w-full max-w-48 h-full object-cover z-0 transition-all md:max-w-62 blur-xs md:blur-none"
          alt="Imagen decorativa para cuando no hay vehículo activo"
          sizes="250px"
          format="webp"
        />
      </Banner>
    )
    }
  </div>
</section>

<Modal keyModal="quoteOffer" title="Lanzar oferta" client:load>
  <div class="flex flex-col gap-4 p-4">
    <InputField
      id="proposed_price"
      name="proposed_price"
      type="number"
      textLabel="Valor de la oferta"
      placeholder="Ingrese el valor de su oferta"
      required={true}
    />
    
    <div class="flex flex-row gap-3 justify-end mt-2">
      <Button id="cancel-offer" variant="bordered" type="button">
        Cancelar
      </Button>
      <Button id="send-offer" variant="default" type="button">
        Solicitar
      </Button>
    </div>
  </div>
</Modal>


<script>
import { statusModal } from "@stores/ModalStore"
import { toastStore } from "@stores/StoreToast"
import { isAvailable as isAvailableStore } from "@stores/UserStore"
import { actions } from "astro:actions"

  document.addEventListener('astro:page-load', () => {
    const cancelOffer = document.getElementById('cancel-offer')
    const sendOffer = document.getElementById('send-offer')

    const availabilityStatus = document.getElementById('availabilityStatus')
    const isAvailable = availabilityStatus?.getAttribute('data-is-available') === 'true'
    isAvailableStore.set(isAvailable)
    const proposedPrice: HTMLInputElement = document.getElementById('proposed_price') as HTMLInputElement

      const cleanValues = () => {
        proposedPrice.value = ''
      }
    
    cancelOffer?.addEventListener('click', () => {
      statusModal.setKey('quoteOffer', {
        isOpen: false,
      })
      cleanValues()
    })
    
    sendOffer?.addEventListener('click', async () => {
      const form = new FormData()
      const {metaData} = statusModal.get()?.['quoteOffer'] || {metaData: {quote_id: ''}}

      form.set('quote_id', metaData?.quote_id as string )
      form.set('proposed_price', proposedPrice?.value)
       
      const { data, error } = await actions.Delivery.addOfferByQuote(form)


      statusModal.setKey('quoteOffer', {
        isOpen: false,
      })
      cleanValues()

      if (error) {
        toastStore.set({
          visible: true,
          message: "Error al enviar la oferta",
          type: 'error',
          autoClose: true,
          autoCloseDelay: 2500,
        })
        return
      }

      if (data) {
        toastStore.set({
          visible: true,
          message: "Oferta enviada correctamente",
          type: 'success',
          autoClose: true,
          autoCloseDelay: 2500,
        })
      }
    })

    const changeAvailability = document.getElementById('changeAvailability');

    changeAvailability?.addEventListener('click', async () => {
      const { data, error } = await actions.User.toggleAvailability({});
      
      if (error) {
        toastStore.set({
          title: 'Error, al cambiar estado',
          autoClose: true,
          emoji: '❌',
          visible: true,
          message: error.message,
          type: 'error',
          autoCloseDelay: 2500,
        })
        return;
      }

      if (data && availabilityStatus) {
        availabilityStatus.textContent = data.is_available ? 'Disponible' : 'Ocupado';
        isAvailableStore.set(data.is_available);
      }
    });
  })
</script>
