---
interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<button
  data-btnThemeToggle="theme-toggle"
  class={`cursor-pointer size-12 p-2 rounded-lg bg-H-blue-100 text-H-black hover:bg-H-blue-200 transition-colors flex items-center justify-center ${className}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-6 h-6 flex dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    style="transition: opacity 0.3s ease-in-out"
  >
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="w-6 h-6 dark:flex hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    style="transition: opacity 0.3s ease-in-out"
  >
    <path
      class="dark:hidden"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
    <path
      class="hidden dark:block"
      d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
  </svg>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const btnThemeToggle = document.querySelectorAll(
      "[data-btnThemeToggle='theme-toggle']"
    );
    const root = document.documentElement;

    btnThemeToggle?.forEach((btn) => {
      btn.addEventListener("click", () => {
        root.classList.toggle("dark");

        // Optionally save the preference to localStorage
        const isDark = root.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      // Check for saved theme preference
      const savedTheme = localStorage.getItem("theme");
      console.log(`Saved theme: ${savedTheme}`);

      if (savedTheme === "dark") {
        root.classList.add("dark");
      }
    });
  });
</script>
