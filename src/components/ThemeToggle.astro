---
interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<button
  data-btnThemeToggle="theme-toggle"
  class={`cursor-pointer size-12 p-2 rounded-lg bg-H-blue-100 text-H-black hover:bg-H-blue-200 transition-colors flex items-center justify-center ${className}`}
>
  <span
    class="transition-all duration-300 ease-in-out opacity-100 scale-100 dark:opacity-0 dark:scale-0 dark:-translate-x-full translate-x-3/6"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6 block"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
    </svg>
  </span>
  <span
    class="transition-all duration-300 ease-in-out opacity-0 scale-0 dark:opacity-100 dark:scale-100 -translate-x-3/6"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6 block"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
</button>

<script>
  document.addEventListener("astro:page-load", () => {
    const btnThemeToggle = document.querySelectorAll(
      "[data-btnThemeToggle='theme-toggle']"
    );
    const root = document.documentElement;

    btnThemeToggle?.forEach((btn) => {
      btn.addEventListener("click", () => {
        root.classList.toggle("dark");

        // Optionally save the preference to localStorage
        const isDark = root.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      // Check for saved theme preference
      const savedTheme = localStorage.getItem("theme");

      if (savedTheme === "dark") {
        root.classList.add("dark");
      }
    });
  });
</script>
