---
interface Props {
  userId: string;
}

const { userId } = Astro.props;
import Button from "../forms/elements/buttons/Button.astro";
import SelectField from "../forms/elements/selects/SelectField.astro";
import InputField from "../forms/elements/inputs/InputField.astro";
---

<aside class="flex flex-col lg:flex-row items-center gap-8 p-6 rounded-lg transition-all lg:ms-3">
  <!-- Encabezado atractivo e imagen -->
  <div class="flex flex-col items-center lg:items-start gap-4 flex-1">
    <div class="text-center lg:text-left">
      <h2 class="text-2xl font-bold text-H-blue-900 dark:text-white mb-2">
        ¡Completa tu registro!
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-300">
        Ayúdanos a conocerte mejor para ofrecerte una experiencia personalizada.
      </p>
    </div>
    <div class="flex relative justify-center w-full max-w-92 mt-12">
      <img
        src="/images/Candado-min.png"
        alt="Registro de usuario"
        class="size-48 object-contain m-auto mask-b-from-1.5"
      />
      <span
        class="absolute top-2 left-0 bg-H-blue-900 text-white text-xs rounded-full px-4 py-2 shadow-lg animate-bounce duration-300 -z-20"
      >
        Desbloquea pedidos rápidos 🚀
      </span>
      <span
        class="absolute bottom-2 right-0 bg-H-blue-700 text-white text-xs rounded-full px-4 py-2 shadow-lg animate-bounce duration-300 z-20"
      >
        Accede a historial y soporte exclusivo 💬
      </span>
    </div>
  </div>
  <!-- Formulario -->
  <form
    id="userDataForm"
    aria-label="Formulario de registro de usuario"
    class="flex flex-col gap-4 max-w-md w-full p-6 rounded-lg transition-colors bg-white dark:bg-H-blue-900 shadow lg:shadow-none"
  >
    <input type="hidden" name="userid" value={userId} />
    <h2 class="text-xl font-bold text-H-blue-900 dark:text-white mb-2"> Registra tus datos </h2>
    <div class="flex flex-col gap-2">
      <SelectField
        id="gender"
        name="gender"
        textLabel="Género"
        placeholder="Selecciona tu género"
        required={true}
        styling={{
          label: "font-medium text-H-blue-900 dark:text-white",
          select:
            "dark:border-H-blue-800 bg-white dark:bg-H-blue-900 text-H-blue-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-H-blue-400 dark:focus:ring-H-blue-700",
        }}
        data={{
          options: [
            { value: "male", label: "Masculino" },
            { value: "female", label: "Femenino" },
          ],
        }}
      />
    </div>
    <div class="flex flex-col gap-2">
      <InputField
        id="phone"
        name="phone"
        type="tel"
        pattern="[0-9]{10}"
        required={true}
        textLabel="Teléfono"
        placeholder="Ej: 3001234567"
        classLabel="font-medium text-H-blue-900 dark:text-white"
        className="dark:border-H-blue-800 bg-white dark:bg-H-blue-900 text-H-blue-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-H-blue-400 dark:focus:ring-H-blue-700"
      />
    </div>
    <div class="flex flex-col gap-2">
      <InputField
        id="age"
        name="age"
        placeholder="Ej: 25"
        type="number"
        min="1"
        max="120"
        required={true}
        textLabel="Edad"
        classLabel="font-medium text-H-blue-900 dark:text-white"
        className="dark:border-H-blue-800 bg-white dark:bg-H-blue-900 text-H-blue-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-H-blue-400 dark:focus:ring-H-blue-700"
      />
    </div>
    <Button
      type="submit"
      className="w-full bg-H-blue-900 dark:bg-H-blue-700 hover:bg-H-blue-800 dark:hover:bg-H-blue-600 group"
    >
      <span>Guardar mis datos</span>
      <span
        class="ml-2 inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin transition-opacity duration-200 opacity-0 group-disabled:opacity-100"
        aria-hidden="true"></span>
    </Button>
  </form>
</aside>

<script>
  import { actions } from "astro:actions";
import { navigate } from "astro:transitions/client";
import { toastStore } from "src/stores/StoreToast";

  const onFormsubmit = () => {
    const form = document.getElementById("userDataForm") as HTMLFormElement | null;
    if (!form) return;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const btnSubmit = form.querySelector("button[type='submit']");
      btnSubmit?.setAttribute("disabled", "true");

      const formData = new FormData(form);
      const AUTO_CLOSE_DELAY = 500;

      const { error } = await actions.User.register(formData);

      if (error) {
        toastStore.set({
          visible: true,
          title: "Error al guardar los datos",
          message: "Por favor, intenta nuevamente más tarde.",
          emoji: "⚠️",
          type: "error",
          autoClose: true,
          autoCloseDelay: AUTO_CLOSE_DELAY,
        });
        btnSubmit?.removeAttribute("disabled");
        return;
      }

      toastStore.set({
        visible: true,
        title: "Datos guardados",
        message: "Tus datos se han guardado correctamente.",
        emoji: "✅",
        type: "success",
        autoClose: true,
        autoCloseDelay: AUTO_CLOSE_DELAY,
      });

      setTimeout(async () => {
        await navigate("/");
      }, AUTO_CLOSE_DELAY);
      
      btnSubmit?.removeAttribute("disabled");
    });
  };

  document.addEventListener("astro:page-load", onFormsubmit);
</script>
