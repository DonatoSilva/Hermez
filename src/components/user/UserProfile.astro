---
import { SignOutButton } from "@clerk/astro/components";
import Avatar from "./Avatar.astro";

interface Props {
  className?: string;
  visibleSize?: "sm" | "md" | "lg";
  position?: "up" | "down";
}

const { className = "", visibleSize = "md", position = "down" } = Astro.props;

const role: "User" | "Domiciliary" | null = Astro.locals.userRole;
const { username, image_url: avatarUrl } = Astro.locals.dataUser!;

const visibility =
  {
    sm: "",
    md: "hidden md:flex",
    lg: "hidden lg:flex",
  }[visibleSize] || "flex";

const orgSwitchUrl = (() => {
  const baseUrl = Astro.url.pathname + Astro.url.search.replace(/(\?|&)org=[^&]*/g, "");
  const orgParam = role === "User" ? "?org=Domiciliary" : "?org=User";
  return baseUrl + (baseUrl.includes("?") ? "&" : "?") + orgParam.slice(1);
})();

// Generar un ID único para este componente
const uniqueId = `user-profile-${Math.random().toString(36).substr(2, 9)}`;
---
<div class=`relative ${visibility} ${className}`} id={uniqueId}>
  <button
    type="button"
    class="user-profile-button flex flex-row items-center gap-2 w-full py-2 px-4 bg-gray-100 dark:bg-gray-800 rounded-lg cursor-pointer"
  >
    <div class="flex items-center gap-2 w-full">
      <Avatar
        src={avatarUrl ?? "/images/default-avatar.png"}
        alt={username ?? "Usuario desconocido"}
      />
      <div class="flex flex-col">
        <b class="text-sm">{username}</b>
        <span class="text-xs">{role == "User" ? "Usuario" : "Domiciliario"}</span>
      </div>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="user-profile-arrow h-4 w-4 transform transition-transform duration-300"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <div
    class={`user-profile-menu absolute right-0 z-50 ${
      position === "up" ? "bottom-full mb-2" : "top-full mt-2"
    } w-full invisible opacity-0 transition-all duration-300 bg-white dark:bg-gray-700 rounded-lg shadow-lg`}
  >
    <ul class="py-2">
      <li class="px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600">
        <a href="/settings" class="block">Configuración</a>
      </li>
      <li class="px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600">
        <a href={orgSwitchUrl} class="block"
          >Cambiar a {role === "User" ? "Domiciliario" : "Usuario"}</a
        >
      </li>
      <li class="px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600">
        <SignOutButton redirectUrl="/sign-in" class={"cursor-pointer w-full h-full text-left"}>
          Cerrar Sesión
        </SignOutButton>
      </li>
    </ul>
  </div>
</div>

<script define:vars={{ uniqueId }}>
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById(uniqueId);
    if (!container) return;

    const button = container.querySelector('.user-profile-button');
    const menu = container.querySelector('.user-profile-menu');
    const arrow = container.querySelector('.user-profile-arrow');
    
    if (!button || !menu || !arrow) return;

    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      
      if (isOpen) {
        menu.classList.remove('invisible', 'opacity-0');
        menu.classList.add('visible', 'opacity-100');
        arrow.classList.add('rotate-180');
      } else {
        menu.classList.add('invisible', 'opacity-0');
        menu.classList.remove('visible', 'opacity-100');
        arrow.classList.remove('rotate-180');
      }
    };

    const closeMenu = () => {
      if (isOpen) {
        isOpen = false;
        menu.classList.add('invisible', 'opacity-0');
        menu.classList.remove('visible', 'opacity-100');
        arrow.classList.remove('rotate-180');
      }
    };

    // Toggle al hacer click en el botón
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Cerrar al hacer click fuera del menú
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        closeMenu();
      }
    });

    // Hover para desktop (solo si no está en móvil)
    if (window.matchMedia('(hover: hover)').matches) {
      container.addEventListener('mouseenter', () => {
        if (!isOpen) toggleMenu();
      });
      
      container.addEventListener('mouseleave', () => {
        closeMenu();
      });
    }
  });
</script>
