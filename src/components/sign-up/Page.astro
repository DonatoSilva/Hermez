---
import { SignUp } from "@clerk/astro/components";
import Toast from "../Toast.astro";

interface Props {
    type?: "domiciliary" | "client";
}

const { type } = Astro.props;

// Check for accountNotFound query parameter and provider info
let showAccountNotFoundMessage = false;
let providerInfo = "";
if (Astro.request.url) {
    const url = new URL(Astro.request.url);
    showAccountNotFoundMessage =
        url.searchParams.get("accountNotFound") === "true";

    const provider = url.searchParams.get("provider");
    const from = url.searchParams.get("from");

    if (provider && provider !== "oauth") {
        if (provider === "google") {
            providerInfo = " con Google";
        } else if (provider === "facebook") {
            providerInfo = " con Facebook";
        } else {
            providerInfo = ` con ${provider}`;
        }
    }
}
---

<Toast
    visible={showAccountNotFoundMessage}
    title={`¡Oops! Esa cuenta${providerInfo} no existe todavía`}
    message={`No encontramos una cuenta registrada${providerInfo}. ¡No te preocupes! Puedes crear tu cuenta ahora mismo. Es súper fácil y rápido 🚀`}
    emoji="😕"
    type="warning"
    autoClose={true}
    autoCloseDelay={8000}
/>

<div
    class="relative z-10 flex flex-col items-center justify-center w-full max-w-5xl min-h-[600px] min-w-[320px] mx-auto gap-6 px-4 sm:px-6 md:px-8 lg:flex-row"
>
    <div
        class="w-full lg:w-1/2 flex flex-col justify-center items-center gap-4 text-center lg:text-left"
    >
        <h1
            class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-bold text-H-blue-900"
        >
            Únete como {type === "domiciliary" ? "Domiciliario" : "Cliente"}
        </h1>
        <p
            class="text-H-blue-700 text-sm sm:text-base lg:text-lg max-w-md lg:max-w-none"
        >
            ¿Ya tienes una cuenta en Hermez, ya sea como cliente o domiciliario?
            ¡No necesitas registrarte de nuevo! Usa tu misma cuenta para acceder
            y disfrutar de todos nuestros servicios.
        </p>
    </div>
    <div class="w-full lg:w-1/2 flex justify-center items-center">
        <div class="w-full max-w-md lg:max-w-lg">
            <SignUp
                path={"/sign-up/" + type}
                routing="path"
                signInUrl={type === "domiciliary"
                    ? "/sign-in/domiciliary"
                    : "/sign-in/client"}
                signInForceRedirectUrl={type === "domiciliary"
                    ? "/sign-in/domiciliary"
                    : "/sign-in/client"}
                fallbackRedirectUrl={type === "domiciliary"
                    ? "/?org=Domiciliary"
                    : "/?org=Client"}
                appearance={{
                    elements: {
                        formButtonPrimary:
                            "bg-H-blue-900 hover:bg-H-blue-800 transition-colors",
                        card: "shadow-none bg-transparent",
                        headerTitle: "text-H-blue-900",
                        headerSubtitle: "text-H-blue-700",
                        socialButtonsBlockButton:
                            "border-H-blue-900/20 hover:bg-H-blue-900/5 transition-colors",
                        formFieldInput:
                            "border-H-blue-900/20 focus:border-H-blue-900 transition-colors",
                        footerActionLink:
                            "text-H-blue-900 hover:text-H-blue-800 transition-colors",
                    },
                }}
            />
        </div>
    </div>
</div>

<img
    src={type === "domiciliary"
        ? "/images/domiciliarioConCajas-min.webp"
        : "/images/clienteFelizEnPuerta-min.webp"}
    alt={type === "domiciliary"
        ? "Domiciliario con cajas"
        : "Cliente feliz en puerta"}
    class="absolute bottom-0 right-0 w-32 sm:w-48 md:w-64 lg:w-80 xl:w-96 object-contain opacity-10 animate-float select-none pointer-events-none"
/>
