---
import CardHistory from "./CardHistory.astro";
import CardTotal from "./CardTotal.astro";

interface ContentRecordsProps {
    phoneNumber: string;
    displayName: string;
    deliveries: {
        deliveryDate: string | Date;
        deliveryPrice: number;
        paidStatus: string;
    }[];
}

const { phoneNumber, displayName, isEmpty, deliveries } = Astro.props;
---

<section class="flex flex-col max-h-fit justify-center items-center">
    <CardTotal
        deliveries={deliveries}
        telephone={phoneNumber}
        text={"Bienvenido " + displayName + ", Acumulado"}
    />
</section>
<section>
    <h2 class="text-2xl text-H-blue-900 font-bold">Historial de domicilios</h2>
    <div class="flex flex-col gap-4 mt-6">
        {
            isEmpty ? (
                <div class="flex justify-center items-center">
                    <p class="text-gray-500 font-semibold">No hay domicilios</p>
                </div>
            ) : (
                deliveries?.map(
                    (
                        {
                            deliveryDate,
                            deliveryPrice,
                            fullName = "Juan Silva",
                            paidStatus,
                        }: {
                            deliveryDate: any;
                            deliveryPrice: number;
                            fullName?: string;
                            paidStatus: string;
                        },
                        index: number,
                    ) => {
                        //// TODO: esta linea se elimina despues de que se haya probado el codigo
                        const getDate =
                            typeof deliveryDate === "string"
                                ? new Date(deliveryDate)
                                : deliveryDate.toDate();

                        const date = new Intl.DateTimeFormat("es-CO", {
                            dateStyle: "full",
                        }).format(getDate);

                        return (
                            <>
                                <CardHistory
                                    date={date}
                                    name={fullName}
                                    price={deliveryPrice}
                                    status={paidStatus}
                                />

                                {index < deliveries?.length - 1 ? (
                                    <hr class="border-t-2 w-20 mx-auto border-H-blue-300" />
                                ) : (
                                    ""
                                )}
                            </>
                        );
                    },
                )
            )
        }
    </div>
</section>
