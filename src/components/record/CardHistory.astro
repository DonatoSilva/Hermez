---
import { Icon } from "astro-icon/components";

interface Props {
    date: string;
    name: string;
    price: number;
    status: string;
    recordID: string;
}

const { date, name, price, status, recordID } = Astro.props;

const colorStatus = status === "paid" ? "bg-green-500/80" : "bg-red-500/80";
const textStatus = status === "paid" ? "Pagado" : "Pendiente";

function formatPrice(price: number): string {
    return price.toLocaleString("es-CO");
}

const isCurrentDomicile = !!Astro.locals.domicile;
---

<div class="card-history rounded-lg flex flex-col" data-record-id={recordID}>
    <div class="flex flex-row justify-between items-center min-h-8 card-header">
        <div
            class={colorStatus +
                " rounded-ss-lg rounded-ee-lg flex flex-row items-center gap-1 overflow-hidden text-status"}
        >
            <Icon
                name="solar:forward-2-broken"
                color="white"
                width="24"
                height="24"
            />
            <span class="text-white overflow-hidden">{textStatus}</span>
        </div>
        {
            isCurrentDomicile ? (
                <div class="flex flex-row items-center gap-1 card-actions">
                    <div class="rounded-md flex flex-row items-center gap-1 overflow-hidden edit">
                        <Icon
                            name="solar:clapperboard-edit-outline"
                            width="24"
                            height="24"
                        />
                        <span class="overflow-hidden text-H-blue-black">
                            Editar
                        </span>
                    </div>
                    <div class="rounded-md flex flex-row items-center gap-1 overflow-hidden bash">
                        <Icon
                            name="solar:paper-bin-bold"
                            width="24"
                            height="24"
                        />
                        <span class="overflow-hidden text-H-blue-black">
                            Eliminar
                        </span>
                    </div>
                </div>
            ) : (
                ""
            )
        }
    </div>
    <div class="card-body">
        <div class="card-container">
            <div>
                <div class="flex gap-1 items-center nameDomicile">
                    <Icon name="solar:user-bold" />
                    <p>{name}</p>
                </div>
                <h3 class="date">{date}</h3>
            </div>
            <div class="flex flex-col justify-end items-center h-full">
                <p class="price text-xl text-H-blue-900">
                    {formatPrice(price)}
                </p>
            </div>
        </div>
    </div>
    <script define:vars={{ recordID }} is:inline>
        /**
         * open modal
         * @param {HTMLDialogElement} modal
         */
        function openModal(modal) {
            modal.showModal();

            const btnCloseModal = modal.querySelector(".btnCloseModal");
            btnCloseModal?.addEventListener("click", () => {
                closeModal(modal);
            });
        }

        /**
         * close modal
         * @param {HTMLDialogElement} modal
         */
        function closeModal(modal) {
            modal.classList.add("closing");
            modal.addEventListener("animationend", () => {
                const isClosing = modal.classList.contains("closing");

                if (isClosing) {
                    modal.classList.remove("closing");
                    modal.close();
                }
            });
        }

        const cardHistory = document.querySelector(
            `[data-record-id="${recordID}"]`,
        );

        const edit = cardHistory?.querySelector(".edit");
        const bash = cardHistory?.querySelector(".bash");

        bash?.addEventListener("click", () => {
            const deleteModal = document.querySelector("#deleteRecordModal");

            deleteModal?.setAttribute("data-record-id", recordID);
            openModal(deleteModal);
        });

        edit?.addEventListener("click", () => {
            alert(
                "editar todavia no esta disponible - 2025-02-14 / Esteban busca mas errores este es por que no me quedo mas ideas",
            );
        });

        /* Es la estructura basica que consegui para la animacion de eliminacion de la tarjeta, 
        no soy consiente si es la mejor manera de hacerlo, pero funciona.
        
        cardHistory?.addEventListener("click", () => {
            cardHistory.style.height = cardHistory.clientHeight + "px";

            const existUserElement = cardHistory.querySelector("symbol");

            cardHistory.classList.add("deleting");
            cardHistory.addEventListener("animationend", () => {
                if (existUserElement) {
                    cardHistory.style.display = "none";
                    console.log("existUserElement");
                    return;
                }
                console.log("remove");
                cardHistory.remove();
            });
        }); */
    </script>
</div>

<style>
    .card-history {
        @apply border;

        transition:
            opacity 0.3s ease-in,
            height 0.3s ease;

        .card-header {
            .text-status,
            .bash,
            .edit {
                padding: 0.25rem 0.5rem;

                span {
                    width: 0;
                    height: 100%;
                    display: inline-block;
                    overflow: hidden;
                    white-space: nowrap;
                    transition: width 0.3s;
                }

                transition: color 0.3s;
            }

            .bash,
            .edit {
                & > svg {
                    @apply text-H-blue-500;
                }
            }
        }

        .card-body {
            @apply px-3 py-4;
            .card-container {
                @apply grid grid-cols-[1fr_auto] gap-1 w-full text-H-blue-900;

                .date {
                    @apply text-xl text-H-blue-900;
                }

                .price {
                    @apply text-2xl font-bold;
                }
            }

            .nameDomicile {
                @apply text-H-blue-500 font-normal;
            }
        }

        &:hover {
            cursor: pointer;
            @apply shadow-md;

            .card-header {
                .text-status {
                    span {
                        width: 80px;
                    }
                }

                .edit:hover,
                .bash:hover {
                    span {
                        width: 80px;
                    }

                    color: white;
                    @apply bg-H-blue-900;

                    svg {
                        @apply text-white;
                    }
                }
            }
        }

        &.deleting {
            animation: animatedDeleted 0.3s ease-in-out;
            animation-delay: 0.2s;
        }
    }

    @keyframes animatedDeleted {
        to {
            opacity: 0;
            height: 0;
        }
    }
</style>
