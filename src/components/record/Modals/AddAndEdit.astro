---
import Modal from "@components/action/Modal.astro";
import FormInput from "@components/inputs/FormInput.astro";
import FormButton from "@components/inputs/FormButton.astro";

interface AddAndEditProps {
    deliveryDate: string;
    deliveryPrice: number;
    paidStatus: boolean;
    isEdit?: boolean;
}

const { deliveryDate, deliveryPrice, paidStatus, isEdit = false } = Astro.props;
---

<Modal
    id={isEdit ? "editRecordModal" : "createRecordModal"}
    title={isEdit ? "Editar domicilio" : "Crear domicilio"}
    description={isEdit
        ? "¿Estás seguro de querer editar este domicilio?"
        : "¿Estás seguro de querer crear un nuevo domicilio?"}
>
    <form class="flex flex-col gap-4">
        <FormInput name="deliveryDate" type="date" label="Fecha de entrega" />
        <FormInput
            name="deliveryPrice"
            type="number"
            label="Precio de entrega"
            placeholder="Ingresa el precio del domicilio"
        />
        <FormInput name="paidStatus" type="checkbox" label="Pagado" />
        <FormButton type="submit" text={isEdit ? "Editar" : "Crear"} />
    </form>
</Modal>
