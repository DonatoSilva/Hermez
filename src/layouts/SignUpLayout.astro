---
import { SignUp } from "@clerk/astro/components";
import { toastStore } from "src/stores/StoreToast";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  signUpPath: string;
  signInUrl: string;
  fallbackRedirectUrl: string;
  imageSrc: string;
  imageAlt: string;
}

const { title, signUpPath, signInUrl, fallbackRedirectUrl, imageSrc, imageAlt } = Astro.props;

if (Astro.request.url) {
  const url = new URL(Astro.request.url);
  if (url.searchParams.has("accountNotFound")) {
    toastStore.set({
      visible: true,
      title: "¡Oops! Esa cuenta no existe todavía",
      message:
        "No encontramos una cuenta registrada. ¡No te preocupes! Puedes crear tu cuenta ahora mismo. Es súper fácil y rápido 🚀",
      emoji: "😕",
      type: "warning",
      autoClose: true,
      autoCloseDelay: 5000,
    });
  }
}
---

<Layout title={title} sizeLogo="sm" class="relative">
  <div
    class="relative z-10 flex flex-col items-center justify-center w-full max-w-5xl min-h-[600px] min-w-[320px] mx-auto gap-6 px-4 sm:px-6 md:px-8 lg:flex-row"
  >
    <div
      class="w-full lg:w-1/2 flex flex-col justify-center items-center gap-4 text-center lg:text-left"
    >
      <slot />
    </div>
    <div class="w-full lg:w-1/2 flex justify-center items-center">
      <div class="w-full max-w-md lg:max-w-lg">
        <SignUp
          path={signUpPath}
          routing="path"
          signInUrl={signInUrl}
          signInForceRedirectUrl={signInUrl}
          fallbackRedirectUrl={fallbackRedirectUrl}
          appearance={{
            elements: {
              formButtonPrimary: "bg-H-blue-900 hover:bg-H-blue-800 transition-colors",
              card: "shadow-none bg-transparent",
              headerTitle: "text-H-blue-900",
              headerSubtitle: "text-H-blue-700",
              socialButtonsBlockButton:
                "border-H-blue-900/20 hover:bg-H-blue-900/5 transition-colors",
              formFieldInput: "border-H-blue-900/20 focus:border-H-blue-900 transition-colors",
              footerActionLink: "text-H-blue-900 hover:text-H-blue-800 transition-colors",
            },
          }}
        />
      </div>
    </div>
  </div>

  <img
    src={imageSrc}
    alt={imageAlt}
    class="absolute bottom-0 right-0 w-32 sm:w-48 md:w-64 lg:w-80 xl:w-96 object-contain opacity-10 animate-float select-none pointer-events-none"
  />
</Layout>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>
