---
import { ClientRouter } from "astro:transitions";
import ActionNav from "@components/action/ActionNav.astro";

import "./src/styles/global.css";
import Title from "@header/Title.astro";

interface LayoutProps {
  title?: string;
  sizeLogo?: "sm" | "md" | "lg";
  class?: string;
}

const {
  title = "Hermez Domicilio",
  class: className = "",
  sizeLogo,
} = Astro.props as LayoutProps;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class={`grid grid-rows-[auto_1fr_auto] min-h-dvh w-full bg-H-blue-100 py-9 px-8 box-border ${className}`}
  >
    <Title size={sizeLogo} />
    <slot />
    <!-- {isLoggedIn ? <ActionNav /> : ""} -->
    <footer class="mt-8 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} Hermez Domicilio. Todos los derechos reservados.
    </footer>
  </body>
</html>
