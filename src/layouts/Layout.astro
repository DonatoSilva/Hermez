---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { ID_ORG_CLIENT } from "astro:env/server";
import NavBar from "@header/NavBar.astro";
import ThemeToggle from "@components/ThemeToggle.astro";

interface LayoutProps {
  title?: string;
  sizeLogo?: "sm" | "md" | "lg";
  class?: string;
}

const {
  title = "Hermez Domicilio",
  class: className = "",
  sizeLogo,
} = Astro.props as LayoutProps;

let orgId: string | undefined = ID_ORG_CLIENT;
let isClient = null;
if (Astro.request.url) {
  const url = new URL(Astro.request.url);
  const orgParam = url.searchParams.get("org");
  isClient = orgParam === "Client";

  if (orgParam) {
    orgId = isClient
      ? import.meta.env.ID_ORG_CLIENT
      : import.meta.env.ID_ORG_DOMICILIARY;
  }
}
---

<!doctype html>
<html lang="es" data-org-id={orgId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <ClientRouter />
  </head>
  <body
    class={`relative flex flex-colgrid gap-8 grid-rows-[auto_auto_1fr_auto] min-h-dvh w-full bg-H-blue-100 py-9 px-8 box-border ${className}`}
  >
    <NavBar size={sizeLogo} />
    <slot />
    <footer class="mt-8 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} Hermez Domicilio. Todos los derechos reservados.
    </footer>
    <ThemeToggle
      className="hidden md:flex absolute bottom-4 right-4 border border-H-blue-300/30 hover:shadow-md hover:border-H-blue-300 transition-all"
    />
    <script src="../scripts/Clerk/organizationHandler.js"></script>
  </body>
</html>
