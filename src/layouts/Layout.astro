---
import { ClientRouter } from "astro:transitions";
import Title from "@header/Title.astro";
import "../styles/global.css";

interface LayoutProps {
  title?: string;
  sizeLogo?: "sm" | "md" | "lg";
  class?: string;
}

const {
  title = "Hermez Domicilio",
  class: className = "",
  sizeLogo,
} = Astro.props as LayoutProps;

let orgId: string | undefined = undefined;
let isClient = null;
if (Astro.request.url) {
  const url = new URL(Astro.request.url);
  const orgParam = url.searchParams.get("org");
  isClient = orgParam === "Client";

  if (orgParam) {
    orgId = isClient
      ? import.meta.env.ID_ORG_CLIENT
      : import.meta.env.ID_ORG_DOMICILIARY;
  }
}
---

<!doctype html>
<html lang="es" data-org-id={orgId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <ClientRouter />
  </head>
  <body
    class={`grid gap-8 grid-rows-[auto_1fr_auto] min-h-dvh w-full bg-H-blue-100 py-9 px-8 box-border ${className}`}
  >
    <Title size={sizeLogo} />
    <slot />
    <footer class="mt-8 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} Hermez Domicilio. Todos los derechos reservados.
    </footer>
  </body>
</html>

<script type="module">
  import { handleOrganizationSelect } from "../src/scripts/prueba";

  document.addEventListener("astro:page-load", () => {
    // Solo ejecuta si la URL tiene el queryParam "org"
    const url = new URL(window.location.href);
    if (url.searchParams.has("org")) {
      const orgId = document.documentElement.getAttribute("data-org-id");
      if (orgId) {
        handleOrganizationSelect(orgId);
      }

      console.log("Organization ID from URL:", orgId);
    }
  });
</script>
