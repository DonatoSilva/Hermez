---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import NavBar from "@header/NavBar.astro";
import ThemeToggle from "@components/button/ThemeToggle.astro";
import UserProfile from "@components/user/UserProfile.astro";
import Toast from "@components/Toast.astro";

interface LayoutProps {
  title?: string;
  sizeLogo?: "sm" | "md" | "lg";
  class?: string;
}

const {
  title = "Hermez Domicilio",
  class: className = "",
  sizeLogo,
} = Astro.props as LayoutProps;

const orgId: string | null = Astro.locals.orgId;
---

<!doctype html>
<html lang="es" {...orgId ? { "data-org-id": orgId } : {}}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <ClientRouter />
  </head>
  <body
    class={`container mx-auto relative flex flex-col gap-8 min-h-dvh w-full bg-H-blue-100 text-H-blue-900 dark:bg-H-black dark:text-white  py-9 px-8 box-border ${className}`}
  >
    <Toast />
    <NavBar size={sizeLogo} />
    <slot />
    <footer class="mt-8 text-center text-xs text-gray-500">
      &copy; {new Date().getFullYear()} Hermez Domicilio. Todos los derechos reservados.
    </footer>
    <ThemeToggle
      className="hidden md:flex fixed bottom-4 right-4 border border-H-blue-300/30 hover:shadow-md hover:border-H-blue-300 transition-all"
    />
    <div class="fixed bottom-4 left-4">
      <UserProfile className="lg:hidden" position="up" />
    </div>
    <script src="../scripts/Clerk/organizationHandler.js"></script>
  </body>
</html>
